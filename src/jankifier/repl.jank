;; SPDX-License-Identifier: MIT
(ns jankifier.repl
  "The REPL's evaluation, made safe for a process that does more than one thing
  at a time, as jankifier.nrepl's eval and load-file run it. It's jank's
  nREPL evaluation changed in two ways (the C++ below says how):

  - The code runs on a thread with a large stack. jank's nREPL evaluates on
    threads with a 512 KB stack (macOS), which a function calling itself thirty
    deep overflows: (fib 30) from an editor ends the process.
  - Output is captured so that evaluations at the same time are safe. jank
    points the process's stdout and stderr at a file for an evaluation's time
    and back afterwards; two evaluations that overlap without one being inside
    the other (a person's and an agent's, two editors') restore in the wrong
    order and leave the process writing to a file that is gone. And it's
    handed as it's written, a line when it's printed (`next-output`).

  Everything else is jank's: the namespace, *1, *e, the messages answered.
  (*1 and *e are set again on the thread that asked: what the large stack's
  thread sets is its own.) Nothing is replaced by loading it."
  (:require [clojure.string :as str]
            [jank.nrepl.server.eval :as nrepl-eval]
            [jank.nrepl.server.inspect :as inspect]))

;; (The C++: guarded, so that loading the namespace again keeps the first.)
(cpp/raw "
#ifndef JANKIFIER_REPL
#define JANKIFIER_REPL
// The REPL's evaluation made safe for a process that does more than one thing at a time,
// included by jank (jankifier.repl): output captured so that evaluations at the same time
// don't lose the process's stdout, and handed as it's written (jankifier.nrepl sends it
// then), and code run on a thread with a large stack.

#include <array>
#include <cerrno>
#include <condition_variable>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <fcntl.h>
#include <chrono>
#include <iostream>
#include <map>
#include <memory>
#include <poll.h>
#include <thread>
#include <mutex>
#include <pthread.h>
#include <string>
#include <string_view>
#include <unistd.h>
#include <vector>

#include <gc/gc.h>

#include <jank/runtime/context.hpp>
#include <jank/runtime/core.hpp>
#include <jank/runtime/core/make_box.hpp>
#include <jank/runtime/obj/keyword.hpp>
#include <jank/runtime/obj/persistent_array_map.hpp>
#include <jank/runtime/obj/persistent_string.hpp>

namespace jankifier::repl
{
  namespace rt = ::jank::runtime;
  using rt::object_ref;

  inline jtl::immutable_string istr(std::string_view const s)
  {
    return { s.data(), s.size() };
  }

  inline object_ref str(std::string_view const s)
  {
    return rt::make_box<rt::obj::persistent_string>(istr(s));
  }

  inline object_ref kw(std::string_view const s)
  {
    return rt::__rt_ctx->intern_keyword(istr(s)).expect_ok();
  }

  [[noreturn]] inline void fail(std::string const &what)
  {
    throw static_cast<object_ref>(rt::ex_info(istr(what), rt::obj::persistent_array_map::empty()));
  }

  /* Output captured: what an evaluation wrote to stdout and stderr, kept apart, and handed
   * as it's written to who waits for it (capture_wait).
   *
   * jank's nREPL captures by pointing the process's stdout and stderr at a file for the
   * evaluation's time and back afterwards, each evaluation saving and restoring by itself.
   * Two evaluations at once that are not one inside the other (a person's, from an editor,
   * and the agent's eval tool) then restore in the wrong order, and the process is left
   * writing to a file that is gone. Here the captures in progress are kept together: when
   * one ends, the streams go to the newest capture still going, or back to where they were
   * before any of them.
   *
   * A capture's streams are pipes, which a thread of its own reads as they're written. While
   * any capture goes, stdout is line buffered, so a line is written when it's printed: who
   * waits gets it then. */
  struct capture
  {
    int id{};
    int write_fd[2]{ -1, -1 };
    int read_fd[2]{ -1, -1 };
    /* Written to when the capture ends: its reader reads what's left in the pipes. */
    int wake[2]{ -1, -1 };
    std::mutex lock;
    std::condition_variable changed;
    std::string text[2];
    size_t taken[2]{};
    /* In the captures' lock. */
    bool ended{};
    /* Everything written before the end has been read. */
    bool drained{};
  };

  struct captures
  {
    std::mutex lock;
    /* In the order they started; one that ended stays until those after it have. */
    std::vector<std::shared_ptr<capture>> going;
    std::map<int, std::shared_ptr<capture>> by_id;
    int before[2]{ -1, -1 };
    int next{ 1 };
  };

  inline captures &all_captures()
  {
    static captures c;
    return c;
  }

  /* What's been written to stdout and stderr, written out to wherever they go now. */
  inline void flush()
  {
    std::cout.flush();
    std::cerr.flush();
    std::fflush(stdout);
    std::fflush(stderr);
  }

  inline void sleep_ms(int64_t ms)
  {
    std::this_thread::sleep_for(std::chrono::milliseconds{ ms });
  }

  inline void close_fd(int &fd)
  {
    if(fd != -1)
    {
      ::close(fd);
      fd = -1;
    }
  }

  /* How many of `s`'s bytes from `from` on end with a whole UTF-8 character: one cut at the
   * end is handed whole later. */
  inline size_t whole_utf8(std::string const &s, size_t const from)
  {
    size_t n{ s.size() - from };
    for(size_t back{ 1 }; back <= 3 && back <= n; ++back)
    {
      auto const c{ static_cast<unsigned char>(s[s.size() - back]) };
      if((c & 0xC0) == 0x80)
      {
        continue;
      }
      size_t const needs{ c >= 0xF0 ? 4u : c >= 0xE0 ? 3u : c >= 0xC0 ? 2u : 1u };
      if(needs > back)
      {
        n -= back;
      }
      break;
    }
    return n;
  }

  /* A capture's reader: what's written to its pipes, kept as it comes. When the capture ends
   * (`wake`), what's left in them is read and the capture is drained. A process started
   * during the capture can still hold a pipe: it's read until that one closes too, and what
   * it writes is dropped (it isn't killed by a pipe with no reader). */
  inline void *capture_read(void *const raw)
  {
    std::unique_ptr<std::shared_ptr<capture>> const held{ static_cast<std::shared_ptr<capture> *>(raw) };
    capture &c{ **held };
    bool open[2]{ true, true };
    bool ending{};
    std::array<char, 65536> buffer{};
    auto const drained{ [&] {
      std::lock_guard<std::mutex> const l{ c.lock };
      c.drained = true;
      c.changed.notify_all();
    } };
    while(open[0] || open[1])
    {
      pollfd fds[3]{ { open[0] ? c.read_fd[0] : -1, POLLIN, 0 },
                     { open[1] ? c.read_fd[1] : -1, POLLIN, 0 },
                     { ending ? -1 : c.wake[0], POLLIN, 0 } };
      if(::poll(fds, 3, -1) < 0)
      {
        if(errno == EINTR)
        {
          continue;
        }
        break;
      }
      bool const now_ending{ !ending && fds[2].revents != 0 };
      for(int i{}; i < 2; ++i)
      {
        if(!open[i] || (fds[i].revents == 0 && !now_ending))
        {
          continue;
        }
        /* All there is now (the pipes don't block). */
        while(true)
        {
          auto const got{ ::read(c.read_fd[i], buffer.data(), buffer.size()) };
          if(got > 0)
          {
            if(!ending)
            {
              std::lock_guard<std::mutex> const l{ c.lock };
              c.text[i].append(buffer.data(), static_cast<size_t>(got));
              c.changed.notify_all();
            }
            continue;
          }
          if(got < 0 && errno == EINTR)
          {
            continue;
          }
          if(got == 0 || errno != EAGAIN)
          {
            open[i] = false;
          }
          break;
        }
      }
      if(now_ending)
      {
        ending = true;
        drained();
      }
    }
    drained();
    close_fd(c.read_fd[0]);
    close_fd(c.read_fd[1]);
    close_fd(c.wake[0]);
    close_fd(c.wake[1]);
    return nullptr;
  }

  /* The streams pointed at the newest capture still going, or back where they were (and
   * buffered as the C library buffers them by default: a line at a time to a terminal). */
  inline void capture_point(captures &c)
  {
    FILE *const streams[2]{ stdout, stderr };
    while(!c.going.empty() && c.going.back()->ended)
    {
      c.going.pop_back();
    }
    flush();
    for(int i{}; i < 2; ++i)
    {
      if(c.going.empty())
      {
        if(c.before[i] != -1)
        {
          dup2(c.before[i], fileno(streams[i]));
          ::close(c.before[i]);
          c.before[i] = -1;
        }
      }
      else
      {
        dup2(c.going.back()->write_fd[i], fileno(streams[i]));
      }
    }
    if(c.going.empty())
    {
      std::setvbuf(stdout, nullptr, isatty(fileno(stdout)) ? _IOLBF : _IOFBF, BUFSIZ);
    }
  }

  inline void pipe_of(int (&fds)[2])
  {
    if(::pipe(fds) != 0)
    {
      fail(\"a pipe to capture output in could not be made\");
    }
    fcntl(fds[0], F_SETFD, FD_CLOEXEC);
    fcntl(fds[1], F_SETFD, FD_CLOEXEC);
  }

  inline object_ref capture_start()
  {
    auto &c{ all_captures() };
    std::lock_guard<std::mutex> const held{ c.lock };
    FILE *const streams[2]{ stdout, stderr };
    auto const made{ std::make_shared<capture>() };
    made->id = c.next++;
    for(int i{}; i < 2; ++i)
    {
      int fds[2];
      pipe_of(fds);
      fcntl(fds[0], F_SETFL, O_NONBLOCK);
      made->read_fd[i] = fds[0];
      made->write_fd[i] = fds[1];
    }
    pipe_of(made->wake);
    bool const first{ c.going.empty() };
    flush();
    for(int i{}; i < 2; ++i)
    {
      if(first)
      {
        c.before[i] = dup(fileno(streams[i]));
      }
      dup2(made->write_fd[i], fileno(streams[i]));
    }
    if(first)
    {
      std::setvbuf(stdout, nullptr, _IOLBF, BUFSIZ);
    }
    c.going.push_back(made);
    c.by_id[made->id] = made;
    /* (The collector's own pthread_create: the thread is known to it.) */
    pthread_t thread{};
    if(GC_pthread_create(&thread, nullptr, capture_read, new std::shared_ptr<capture>{ made }) == 0)
    {
      GC_pthread_detach(thread);
    }
    return rt::make_box(static_cast<int64_t>(made->id));
  }

  /* {:out :err} as strings, from the two texts. */
  inline object_ref out_err(std::string const &out, std::string const &err)
  {
    object_ref m{ rt::obj::persistent_array_map::empty() };
    m = rt::assoc(m, kw(\"out\"), str(out));
    return rt::assoc(m, kw(\"err\"), str(err));
  }

  /* A capture ended: {:out :err}, what was written while it was the newest one. */
  inline object_ref capture_end(object_ref const id)
  {
    int const wanted{ static_cast<int>(rt::to_int(id)) };
    std::shared_ptr<capture> one;
    {
      auto &c{ all_captures() };
      std::lock_guard<std::mutex> const held{ c.lock };
      auto const found{ c.by_id.find(wanted) };
      if(found != c.by_id.end())
      {
        one = found->second;
        one->ended = true;
        c.by_id.erase(found);
      }
      capture_point(c);
      if(one)
      {
        close_fd(one->write_fd[0]);
        close_fd(one->write_fd[1]);
      }
    }
    if(!one)
    {
      return out_err(\"\", \"\");
    }
    std::string text[2];
    {
      /* The streams point elsewhere now: what's in the pipes is all there is of ours. */
      (void)::write(one->wake[1], \"x\", 1);
      std::unique_lock<std::mutex> l{ one->lock };
      one->changed.wait(l, [&] { return one->drained; });
      text[0] = one->text[0];
      text[1] = one->text[1];
    }
    return out_err(text[0], text[1]);
  }

  /* What the capture `id` wrote since the last call, waited for: {:out :err} with those that
   * have some, or nil once it's over and all of it was handed (or it's not there). A UTF-8
   * character cut at the end comes whole in the next call. For one waiter a capture. */
  inline object_ref capture_wait(object_ref const id)
  {
    int const wanted{ static_cast<int>(rt::to_int(id)) };
    std::shared_ptr<capture> one;
    {
      auto &c{ all_captures() };
      std::lock_guard<std::mutex> const held{ c.lock };
      auto const found{ c.by_id.find(wanted) };
      if(found == c.by_id.end())
      {
        return object_ref{ rt::jank_nil };
      }
      one = found->second;
    }
    std::string chunk[2];
    {
      std::unique_lock<std::mutex> l{ one->lock };
      size_t ready[2]{};
      one->changed.wait(l, [&] {
        for(int i{}; i < 2; ++i)
        {
          ready[i] = one->drained ? one->text[i].size() - one->taken[i]
                                  : whole_utf8(one->text[i], one->taken[i]);
        }
        return ready[0] > 0 || ready[1] > 0 || one->drained;
      });
      if(ready[0] == 0 && ready[1] == 0)
      {
        return object_ref{ rt::jank_nil };
      }
      for(int i{}; i < 2; ++i)
      {
        chunk[i] = one->text[i].substr(one->taken[i], ready[i]);
        one->taken[i] += ready[i];
      }
    }
    object_ref m{ rt::obj::persistent_array_map::empty() };
    if(!chunk[0].empty())
    {
      m = rt::assoc(m, kw(\"out\"), str(chunk[0]));
    }
    if(!chunk[1].empty())
    {
      m = rt::assoc(m, kw(\"err\"), str(chunk[1]));
    }
    return m;
  }

  /* A function called on a thread of its own with a stack of `megabytes`, and waited for.
   *
   * jank's nREPL evaluates on threads with the system's default stack for a thread that is
   * not the first (512 KB on macOS), and jank's compiled frames are large: a function that
   * calls itself thirty deep overflows it, and the process ends (SIGBUS). The memory of the
   * stack is only taken as it is used. The calling thread's bindings are the new thread's,
   * as with jank's own future; what the function throws is thrown here. */
  struct big_job
  {
    object_ref fn{};
    object_ref bindings{};
    object_ref result{};
    object_ref thrown{};
    std::string what;
    int failed{}; /* 0 no, 1 a jank value thrown, 2 a C++ exception, 3 something else */
  };

  inline void *big_run(void *const raw)
  {
    auto const job{ static_cast<big_job *>(raw) };
    bool pushed{};
    try
    {
      rt::__rt_ctx->push_thread_bindings(job->bindings).expect_ok();
      pushed = true;
      job->result = job->fn.call();
    }
    catch(object_ref const &e)
    {
      job->failed = 1;
      job->thrown = e;
    }
    catch(std::exception const &e)
    {
      job->failed = 2;
      job->what = e.what();
    }
    catch(...)
    {
      job->failed = 3;
    }
    /* The bindings taken off again: jank keeps a thread's bindings by its system id, which
     * a later thread can be given, and that thread would start with these. */
    if(pushed)
    {
      try
      {
        rt::__rt_ctx->pop_thread_bindings();
      }
      catch(...)
      {
      }
    }
    return nullptr;
  }

  /* An evaluation's result kept on the thread that asked for it, as jank's safe_eval keeps
   * it on the one that ran it: *1, *2 and *3, or *e. A thread that didn't bind them can't set
   * them: there they are left. */
  inline object_ref remember(object_ref const ok, object_ref const what)
  {
    static auto const one{ rt::__rt_ctx->find_var(\"clojure.core\", \"*1\") };
    static auto const two{ rt::__rt_ctx->find_var(\"clojure.core\", \"*2\") };
    static auto const three{ rt::__rt_ctx->find_var(\"clojure.core\", \"*3\") };
    static auto const error{ rt::__rt_ctx->find_var(\"clojure.core\", \"*e\") };
    if(rt::truthy(ok))
    {
      (void)three->set(two->deref());
      (void)two->set(one->deref());
      (void)one->set(what);
    }
    else
    {
      (void)error->set(what);
    }
    return object_ref{ rt::jank_nil };
  }

  inline object_ref on_big_stack(object_ref const fn, object_ref const megabytes)
  {
    /* The job is on this thread's stack, which the collector reads while this thread waits:
     * what the job holds is kept. */
    big_job job;
    job.fn = fn;
    job.bindings = rt::__rt_ctx->get_thread_bindings();
    pthread_attr_t attributes;
    pthread_attr_init(&attributes);
    pthread_attr_setstacksize(&attributes, static_cast<size_t>(rt::to_int(megabytes)) << 20);
    pthread_t thread{};
    /* (The collector's own pthread_create: the thread is known to it.) */
    int const made{ GC_pthread_create(&thread, &attributes, big_run, &job) };
    pthread_attr_destroy(&attributes);
    if(made != 0)
    {
      fail(\"a thread with a large stack could not be made\");
    }
    GC_pthread_join(thread, nullptr);
    switch(job.failed)
    {
      case 1:
        throw job.thrown;
      case 2:
        fail(job.what);
      case 3:
        fail(\"something that is not an exception was thrown\");
      default:
        return job.result;
    }
  }
}
#endif
")

;; The stack an evaluation gets, in megabytes. Its memory is only taken as it is used.
(defonce stack-megabytes (atom 256))

(defn on-big-stack
  "What `f` (no arguments) returns, called on a thread of its own with a large
  stack and waited for. The calling thread's bindings are the new thread's; what
  `f` throws is thrown here."
  [f]
  (cpp/jankifier.repl.on_big_stack f @stack-megabytes))

(defn next-output
  "What the capture `id` (see `evaluate`'s `started`) wrote since the last call,
  as {:out :err} with those that have some, waited for: a line comes when it's
  printed. nil once the capture's over. One caller a capture; what it isn't
  handed is in what `evaluate` returns all the same."
  [id]
  (cpp/jankifier.repl.capture_wait id))

(defn evaluate
  "Code evaluated in namespace `ns` (\"user\" when there is none by that name),
  as the nREPL does, on a large stack. Returns {:ok :value :result :inspected
  :ns :out :err :error :raised}: :value is the value printed and :result
  itself, :error what was thrown as text and :raised itself. *1 and *e are the
  calling thread's too. `started`, when given, is called with the capture's id
  before the code runs (see `next-output`)."
  ([code ns file line column inspect?]
   (evaluate code ns file line column inspect? nil))
  ([code ns file line column inspect? started]
   (let [target (or (some-> ns symbol find-ns) (find-ns 'user))
         id (cpp/jankifier.repl.capture_start)
         ran (try
               (when started
                 (started id))
               (on-big-stack
                (fn []
                  (binding [*ns* target
                            *file* file]
                    ;; The evaluation may change the namespace. *1 and *e are read on the
                    ;; thread that set them, and then set on the one that asked.
                    (let [ok (nrepl-eval/safe-eval code line column)]
                      {:ok ok
                       :ns (str *ns*)
                       :value (when ok (pr-str *1))
                       :result (when ok *1)
                       :raised (when-not ok *e)
                       :inspected (when (and ok inspect?) (inspect/inspect-str *1))
                       :error (when-not ok (str *e))}))))
               (catch jank.runtime.object_ref e {:ok false :error (str e)})
               (catch cpp/std.exception e {:ok false :error (str (cpp/.what e))}))
         wrote (cpp/jankifier.repl.capture_end id)]
     (cpp/jankifier.repl.remember (boolean (:ok ran)) (if (:ok ran) (:result ran) (or (:raised ran) (:error ran))))
     (assoc ran :out (:out wrote) :err (:err wrote)))))

(defn responses
  "An evaluation's nREPL responses, as jank's server sends them: its output,
  then its value (only the inspector's text when `inspect?`), or its error."
  [ran inspect?]
  (let [out (when-not (str/blank? (:out ran)) {:out (:out ran)})
        err (when-not (str/blank? (:err ran)) {:err (:err ran)})]
    (cond
      (not (:ok ran))
      [out err {:err (:error ran)} {:ex (:error ran) :status [:done :eval-error]}]

      inspect?
      {:value (:inspected ran) :status [:done]}

      :else
      [out err {:value (:value ran) :ns (:ns ran)} {:status [:done]}])))
