; SPDX-License-Identifier: MIT
; The Lean replica of jank's runtime, round 2 (strings, printing, regex; compare, multimethods,
; namespaces), predicted where jank departs from Clojure's documented semantics (sdk/lean, jank
; f3d82d654). Each test asserts Clojure's result for one prediction: a failing test confirms it, a
; passing one refutes it, an error (jank crashed, hung or refused the form) is read from its
; message. Forms jank may refuse at compile time go through eval, so a refusal fails one test.
(ns jank-lean.deviations-r2-test
  (:require [clojure.string :as string]
            [clojure.test :refer [deftest is]]))

(deftest b01-string-count-is-in-utf16-units
  (is (= 1 (count "é")))
  (is (= \é (nth "é" 0)))
  (is (nil? (get "é" 1)))
  (is (not (contains? "é" 1)))
  (is (= "é" (subs "é" 0 1))))

(deftest b02-seq-of-a-string-is-utf16-units
  (is (= 3 (count (seq "a😀")))))

(deftest b03-seq-of-a-cut-string
  (is (= [\a \é] (vec (seq (subs "aé" 0 2))))))

(deftest b04-string-seq-equals-itself
  (let [x (seq "é")] (is (= x x)))
  (is (= (seq "é") (vec "é"))))

(deftest b05-string-seq-hashes-as-the-equal-vector
  (is (contains? (hash-set (seq "a")) [\a])))

(deftest b06-string-compare-in-utf16-order
  (is (pos? (compare "Ａ" "😀"))))

(deftest b07-index-of-in-characters-and-negative-starts
  (is (= 1 (string/index-of "éa" "a")))
  (is (= 0 (string/index-of "a" "a" -1)))
  (is (nil? (string/last-index-of "aa" "a" -1))))

(deftest b08-trim-and-blank-on-unicode-whitespace
  (is (= "a" (string/trim " a")))
  (is (string/blank? "\u001f")))

(deftest b09-case-mapping-of-sharp-s-and-final-sigma
  (is (= "SS" (string/upper-case "ß")))
  (is (= "aς" (string/lower-case "aΣ"))))

(deftest b10-capitalize-of-a-non-ascii-first-letter
  (is (= "Éa" (string/capitalize "Éa"))))

(deftest b11-replace-of-an-empty-match
  (is (= "-é-" (string/replace "é" "" "-"))))

(deftest b12-escape-of-a-non-ascii-character
  (is (= "X" (string/escape "é" {\é "X"}))))

(deftest b15-doubles-print-as-java-does
  (is (= "100000.0" (str 100000.0)))
  (is (= "1.0E7" (str 1.0E7)))
  (is (= "1.5E-4" (str 1.5E-4))))

(deftest b16-str-of-a-collection-is-readable
  (is (= "[\"a\" \\b]" (str ["a" \b]))))

(deftest b17-pr-str-of-bel
  (is (= 3 (count (pr-str (str (char 7)))))))

(deftest b18-pr-str-of-a-regex-with-a-quote
  (is (= "#\"\\\"\"" (pr-str (re-pattern "\"")))))

(deftest b19-bigdecimal-prints-its-scale
  (is (= "1" (str 1M)))
  (is (= "1.50M" (pr-str 1.50M))))

(deftest b20-pr-str-of-several-values
  (is (= "1 2" (eval '(pr-str 1 2)))))

(deftest b21-print-length
  (is (= "[1 2 ...]" (eval '(binding [clojure.core/*print-length* 2] (pr-str [1 2 3]))))))

(deftest b23-print-str-of-a-string-seq
  (is (= "(a b)" (print-str (seq "ab")))))

(deftest b24-regex-dot-matches-a-character
  (is (= "é" (re-find #"." "é"))))

(deftest b25-dollar-before-a-final-newline
  (is (= "a" (re-find #"a$" "a\n"))))

(deftest b26-an-unmatched-group-is-nil
  (is (= ["b" nil] (re-find #"(a)?b" "b"))))

(deftest b27-re-seq-anchors-and-empty-matches
  (is (= ["a"] (vec (re-seq #"^a" "aa"))))
  (is (= ["" ""] (vec (take 5 (re-seq #"a*" "b"))))))

(deftest b28-re-matches-finds-a-full-match
  (is (= "ab" (re-matches #"a|ab" "ab"))))

(deftest b29-regex-input-past-a-nul
  (is (= "b" (re-find #"b" "a\u0000b"))))

(deftest b30-case-insensitive-regex
  (is (= "A" (re-find (re-pattern "(?i)a") "A"))))

(deftest b31-replacement-templates-and-functions
  (is (= "$5" (string/replace "5" #"(\d)" "\\$$1")))
  (is (= "1a" (string/replace "a1" #"(a)(\d)" (fn [[_ x y]] (str y x))))))

(deftest c01-booleans-compare
  (is (= 1 (compare true false)))
  (is (= [false true] (vec (sort [true false])))))

(deftest c02-keyword-against-a-number-throws
  (is (= :caught (try (compare :a 1) (catch cpp/jank.runtime.object_ref _ :caught)))))

(deftest c03-compare-of-identical-empty-lists
  (is (= 0 (compare '() '()))))

(deftest c04-bigdecimal-against-a-double
  (is (= 0 (compare 0.1M 0.1))))

(defmulti r2-dispatch identity)
(derive ::t0 ::t1)
(derive ::t0 ::t2)
(defmethod r2-dispatch ::t0 [_] :t0)
(defmethod r2-dispatch ::t1 [_] :t1)
(prefer-method r2-dispatch ::t1 ::t2)

(deftest c05-dispatch-to-the-most-specific-method
  (is (= :t0 (r2-dispatch ::t0))))

(defmulti r2-prefer identity)
(derive ::c ::a)
(derive ::c ::b)
(derive ::b ::b0)
(defmethod r2-prefer ::a [_] :a)
(defmethod r2-prefer ::b [_] :b)
(prefer-method r2-prefer ::a ::b0)

(deftest c05b-prefer-method-on-an-ancestor
  (is (= :a (r2-prefer ::c))))

(deftest c06-get-method-without-one-is-nil
  (is (nil? (get-method r2-prefer ::nothing))))

(deftest c07-intern-replaces-a-referred-var
  (is (= "#'jank-lean.deviations-r2-test/map" (str (intern 'jank-lean.deviations-r2-test 'map 7))))
  (is (fn? @#'clojure.core/map)))

(deftest c08-clojure-core-cannot-be-removed
  (is (thrown? (remove-ns 'clojure.core)))
  (is (some? (find-ns 'clojure.core))))
