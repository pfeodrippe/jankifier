; SPDX-License-Identifier: MIT
; The Lean replica of jank (round 2, main 7135b7708): its analyzer, code generator, interop,
; sequence and core predictions, each test asserting Clojure's documented result (a failure
; confirms one). Forms the analyzer or code generator may refuse are compiled at run time
; (eval of read-string), so a refusal fails its own test. Run under a UTF-8 locale.
(ns jank-lean.deviations-main-test
  (:require [clojure.test :refer [deftest is]]))

(defn- ev [s] (eval (read-string s)))

(deftest r23-if-keeps-each-branch-value
  (is (= 1 (if true 1 2.5)))
  (is (= true (or true 0)))
  (is (= :no (if (and false 5) :yes :no))))

(deftest r24-loop-local-takes-any-value
  (is (= 1.5 (loop [x 0 n 0] (if (= n 1) x (recur 1.5 1))))))

(deftest r25-literal-arithmetic-is-long
  (is (= 2147483648 (+ 2147483647 1)))
  (is (= 4999950000 (loop [i 0 acc 0] (if (< i 100000) (recur (inc i) (+ acc i)) acc)))))

(deftest r26-case-branches-keep-their-values
  (is (= 0 (case 5 1 1.5 0)))
  (is (= "one" (case 1 1 "one" 2 :two :other))))

(deftest r27-recur-in-a-fn-inside-a-loop-targets-the-fn
  (is (= :done (ev "((loop [a 1 b 2] (fn [y] (if y (recur nil) :done))) 5)"))))

(deftest r28-a-named-fn-sees-its-own-name
  (is (= :done ((fn [f] ((fn f [n] (if (= n 0) :done (f 0))) 1)) 7))))

(deftest r29-a-named-fn-shadows-a-macro
  (is (= :done (ev "((fn when [n] (if (= n 0) :done (when 0))) 1)"))))

(defmacro r30-form-of [& _] (list 'quote &form))

(deftest r30-macro-form
  (is (= '(r30-form-of 1 2) (r30-form-of 1 2))))

(deftest r33-boolean-arithmetic-throws
  (is (thrown? (ev "(+ true 1)"))))

(deftest r34-keyword-call-without-a-map
  (is (thrown? (ev "(:k)"))))

(deftest r37-operator-evaluated-first
  (let [order (atom [])]
    ((do (swap! order conj :f) identity) (do (swap! order conj :a) 1))
    (is (= [:f :a] @order))))

(deftest r38-dash-and-underscore-locals-differ
  (is (= 1 (let [a-b 1 a_b 2] a-b))))

(deftest r39-nested-loop-rebinding
  (is (= 2 (ev "(loop [i 0] (let [z (loop [i 5] (if (< i 6) (recur (inc i)) i))] (if (< i 2) (recur (inc i)) i)))"))))

(deftest r40-nested-fn-refers-to-its-named-parent
  (is (fn? (ev "((fn my-f [] (fn [] my-f)))"))))

(deftest r41-two-letfns-in-one-fn
  (is (= [1 2] ((ev "(fn [] [(letfn [(f [] (g)) (g [] 1)] (f)) (letfn [(h [] 2)] (h))])")))))

(deftest r42-equal-constants-stay-distinct
  (is (list? (first (let [a [[]] b ['()]] b)))))

(deftest r44-case-on-a-long-past-int32
  (is (= :hit (case 2147483648 2147483648 :hit :miss))))

(def r45-x 1)
(defn r45-f [] (let [a r45-x] (def r45-x 2) [a r45-x]))

(deftest r45-var-read-after-redefinition
  (is (= [1 2] (r45-f))))

(deftest r47-param-named-like-its-fn
  (is (= 1 (let [y 1] ((fn f [f] y) 5)))))

(deftest r89-native-enum-zero-is-truthy
  (is (= :t (ev "(do (cpp/raw \"enum r89c { r89r, r89g };\") (if cpp/r89r :t :f))"))))

(deftest r104-sorted-sets-with-incomparable-keys-are-unequal
  (is (= false (= (sorted-set 0) (sorted-set "a")))))

(deftest r105-sorted-find-returns-the-stored-key
  (is (= [1 :x] (vec (find (sorted-map 1 :x) 1.0)))))

(defn r108-countdown [n] (if (pos? n) (r108-countdown (dec n)) :done))
(def r108-orig r108-countdown)
(defn r108-countdown [n] :redefined)

(deftest r108-defn-recursion-goes-through-the-var
  (is (= :redefined (r108-orig 3))))

(deftest r110-find-var-wants-a-qualified-symbol
  (is (thrown? (find-var 'map))))

(deftest r112-in-ns-returns-the-namespace
  (is (some? (in-ns 'jank-lean.deviations-main-test))))

(deftest r114-take-from-a-long-range
  (is (= [0 1] (vec (take 2 (range 9223372036854775807))))))

(deftest r116-range-with-a-real-end-past-int32
  (is (= 3 (count (range 2147483646 2147483649.0)))))

(deftest r117-doseq-leaves-held-seqs-alone
  (is (= 4 (let [w (cons 0 [1 2 3])] (doseq [x w]) (count w)))))

(deftest r118-partition-by-after-reduced
  (is (= [[1] [2]] (transduce (partition-by odd?)
                              (completing (fn [acc p] (let [a (conj acc p)] (if (= 2 (count a)) (reduced a) a))))
                              [] [1 2 3]))))

(deftest r119-first-of-an-infinite-mapped-range
  (is (= 1.0 (first (map inc (range 0.0 ##Inf))))))

(deftest r120-cons-is-a-collection
  (is (coll? (cons 0 [1]))))

(deftest r121-get-in-with-no-keys
  (is (= 5 (get-in 5 []))))

(deftest r122-bytes-are-signed
  (is (= -1 (aget (byte-array [-1]) 0))))

(deftest r123-find-returns-the-stored-key
  (is (= [1] (key (find {[1] :v} '(1))))))
