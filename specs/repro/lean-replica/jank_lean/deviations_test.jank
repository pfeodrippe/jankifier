; SPDX-License-Identifier: MIT
; A Lean model of jank's runtime predicted where jank departs from Clojure's documented semantics
; (sdk/lean, jank f3d82d654). Each test asserts Clojure's result for one prediction: a failing
; test confirms it on the real jank, a passing one refutes it, an error (jank crashed, hung or
; refused the form) is read from its message. Values pass through functions, as in the model, so
; the runtime's generic paths run rather than the analyzer's typed literals. The concurrency ones
; repeat their race: determinismo's thread faults draw the schedules.
(ns jank-lean.deviations-test
  (:require [clojure.test :refer [deftest is]]))

(defn- add [a b] (+ a b))
(defn- sub [a b] (- a b))
(defn- mul [a b] (* a b))
(defn- div [a b] (/ a b))
(defn- neg [a] (- a))
(defn- absolute [x] (abs x))

(deftest d01-arithmetic-past-32-bits
  (is (= 2147483648 (add 2147483647 1)))
  (is (= 4294967296 (mul 65536 65536)))
  (is (= 2147483648 (neg -2147483648)))
  (is (= 4999950000 (reduce + (range 100000)))))

(deftest d02-integer-division-is-a-ratio
  (is (= 0.5 (double (div 1 2)))))

(deftest d02b-int32-minimum-divided-by-minus-one
  (is (= 2147483648 (div -2147483648 -1))))

(deftest d03-promoting-subtraction-overflow
  (is (neg? (-' -9223372036854775808 1))))

(deftest d04-quot-exact-on-longs
  (is (= 9007199254740993 (quot 9007199254740993 1))))

(deftest d04b-quot-of-doubles-is-a-double
  (is (= "3.0" (str (quot 7.5 2)))))

(deftest d05-numeric-equivalence-of-longs
  (is (not (== 9007199254740993 9007199254740992))))

(deftest d06-abs-of-negative-zero
  (is (= "0.0" (str (absolute -0.0)))))

(deftest d07-bigdec-of-a-long-is-exact
  (is (= "9007199254740993" (str (bigdec 9007199254740993)))))

(deftest d08-bigdecimal-equality-is-exact
  (is (not= 1M 1.0000000000000000001M))
  (is (not= 0M 0.00000000000000015M)))

(deftest d09-nan-from-infinities
  (let [x (sub ##Inf ##Inf)] (is (not= x x))))

(deftest d09b-nan-from-zero-over-zero
  (let [x (div 0.0 0.0)] (is (not= x x))))

(deftest d10-parse-long-grammar
  (is (nil? (parse-long " 5"))))

(deftest d10b-parse-double-grammar
  (is (nil? (parse-double "inf")))
  (is (= 1.5 (parse-double "1.5 ")))
  (is (= 1.5 (parse-double "1.5d")))
  (is (= ##Inf (parse-double "1e400")))
  (is (= 0.0 (parse-double "1e-400"))))

(deftest d11-sequential-equality
  (is (not (= [] nil)))
  (is (not (= [] #{})))
  (is (not (= '() {})))
  (is (not (= [1] #{1})))
  (is (not (= [\a] "a"))))

(deftest d12-equal-means-same-hash
  (is (= 1 (count (hash-set 1 1N))))
  (is (= :a (get (hash-map 1N :a) 1)))
  (is (contains? #{0.0} -0.0))
  (is (= 1 (count (hash-set [] (lazy-seq nil)))))
  (is (= (hash (seq {:a 1})) (hash [[:a 1]]))))

(deftest d13-hash-unordered-coll-is-a-set-hash
  (is (= (hash-unordered-coll '(1 2)) (hash #{1 2})))
  (is (= (hash-unordered-coll [1 2]) (hash #{1 2}))))

(deftest d14-transient-array-map-leaves-its-source
  (is (= {:a 0 :b 1} (let [m {:a 0 :b 1} t (transient m)] (assoc! t :a 2) m)))
  (is (= {:a 0 :b 1} (let [m {:a 0 :b 1} t (transient m)] (dissoc! t :a) m)))
  (is (= {:a 1} (let [m {:a 1}] (into m {:a 2}) m))))

(deftest d15-transient-vector-after-persistent
  (is (thrown? (let [t (transient [7])] (persistent! t) (nth t 0)))))

(deftest d16-watch-removing-itself
  (let [a (atom 0)]
    (add-watch a :once (fn [k r _ _] (remove-watch r k)))
    (reset! a 1)
    (is (= 1 @a))))

(deftest d16b-watch-swapping-beside-add-watch
  (dotimes [_ 50]
    (let [b (atom 0)]
      (add-watch b :w (fn [_ r _ n] (when (< n 2) (swap! r inc))))
      (let [f (future (add-watch b :j (fn [& _])))]
        (swap! b inc)
        @f)
      (is (= 2 @b)))))

(deftest d18-alter-meta-loses-no-update
  (let [a (atom 0)]
    (run! deref (doall (for [_ (range 8)]
                         (future (dotimes [_ 1000] (alter-meta! a update :n (fnil inc 0)))))))
    (is (= 8000 (:n (meta a))))))

(deftest d19-delay-runs-once-even-for-nil
  (let [runs (atom 0)
        d (delay (swap! runs inc) nil)]
    @d
    @d
    (is (= 1 @runs))
    (is (realized? d))))

(deftest d20-second-deliver-is-nil
  (let [p (promise)]
    (deliver p 1)
    (is (nil? (deliver p 2)))))

(deftest d21-deref-with-timeout
  (is (= :timeout (deref (promise) 10 :timeout))))

(def ^:dynamic *x* :root)

(deftest d22-future-sees-its-creators-bindings-only
  (binding [*x* :one] @(future nil))
  (dotimes [_ 50]
    (is (= :root @(future *x*)))))

(def ^:dynamic *y* 1)

; The model predicted `set!` of a conveyed binding allowed in a future (C++ var::set). jank's
; analyzer has no `set!` for vars (var-set throws "TODO: port var-set"), so no jank code reaches
; it: what is checked is Clojure's plain case, compiled at run time so a refusal fails this test
; alone.
(deftest d23-set-of-a-thread-bound-var
  (is (= 3 (eval '(binding [jank-lean.deviations-test/*y* 2]
                    (set! jank-lean.deviations-test/*y* 3)
                    jank-lean.deviations-test/*y*)))))

(deftest d24-finally-throwing-after-a-throwing-catch
  (is (= "c" (try (try (throw (ex-info "a" {}))
                       (catch cpp/jank.runtime.object_ref _ (throw (ex-info "b" {})))
                       (finally (throw (ex-info "c" {}))))
                  (catch cpp/jank.runtime.object_ref e (ex-message e))))))

(deftest d25-locking
  (is (= 1 (eval '(locking :lock 1)))))
