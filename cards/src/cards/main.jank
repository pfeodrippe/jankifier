;; SPDX-License-Identifier: MIT
;; The cards' process: jank's nREPL server on a thread of its own (its port in .nrepl-port, as
;; `jank repl` writes it), the window's frames on the main thread, where macOS wants them. The
;; server has jankifier.nrepl's ops (completion, docs, tests, output as it's written, a large
;; stack for evaluations). What's sent with tap> goes on a card; each evaluation can too
;; (`run!`'s :evaluations, as Portal's nREPL middleware sends each to Portal).
;;
;; A project has a -main of its own that requires what defines its cards and calls `run!`.
;; This one shows the generic cards alone, and each evaluation:
;;   lein run --disable-sandbox                              the window
;;   lein run --disable-sandbox -- --hidden --record a.mp4   its frames to a video, nothing shown
(ns cards.main
  (:refer-clojure :exclude [run!])
  (:require [clojure.string :as str]
            [jank.nrepl.server.core :as nrepl]
            ;; After the server: its connections are then handled by jankifier.nrepl's loop.
            [jankifier.nrepl :as jankifier-nrepl]
            [cards.core :as cards]))

(defn- after [flag args]
  (second (drop-while (fn [arg] (not= arg flag)) args)))

(defn options
  "The command line's: --hidden, --record <video>, --width <points>, --height <points>,
  --scale <pixels a point> and --snap (how a hidden window or a recording is drawn),
  --announce (each evaluation said on stderr, for a script driving the REPL)."
  [args]
  {:hidden (boolean (some (fn [arg] (= arg "--hidden")) args))
   :announce (boolean (some (fn [arg] (= arg "--announce")) args))
   :record (after "--record" args)
   :width (when-let [w (after "--width" args)] (parse-long w))
   :height (when-let [h (after "--height" args)] (parse-long h))
   :scale (when-let [s (after "--scale" args)] (parse-double s))
   :snap (boolean (some (fn [arg] (= arg "--snap")) args))})

(defonce ^:private quiet (atom #{}))

(defn quiet!
  "Evaluations whose code has `part` are not told to the window: no card, no count. For a
  library's calls that a script makes to look at the window (a video's take asking where
  something was drawn)."
  [part]
  (swap! quiet conj (str part))
  nil)

(defn- tooling?
  "What an editor evaluates for itself on connecting, and the window's own calls: not a
  person's work."
  [code]
  (or (some (fn [part] (str/includes? code part)) @quiet)
      (str/includes? code "cider") (str/includes? code "clojure.main/repl-requires")
      (str/includes? code "clojure.stacktrace")
      (str/includes? code "cards.core/snapshot!") (str/includes? code "cards.core/stop!")
      (str/includes? code "cards.core/evaluations") (str/includes? code "cards.core/newest-box")
      (str/includes? code "cards.core/pointer") (str/includes? code "cards.core/click!")
      (str/includes? code "cards.core/wheel!")
      (str/starts-with? code "(in-ns ") (str/starts-with? code "(ns ")
      ;; A client's probe on connecting.
      (= code "1")))

(defonce ^:private showing (atom false))

(defn show-evaluations!
  "Whether each evaluation from the REPL goes on a card with its value or its error (and is
  counted: `cards.core/evaluations`). `run!` sets it from its :evaluations. Either way the
  window is told of each (`cards.core/on-evaluation!`, the pinned functions)."
  [on?]
  (reset! showing (boolean on?))
  nil)

(defn- watch-evaluations!
  "The window told of each evaluation from the REPL (`cards.core/evaluated!`)."
  []
  (jankifier-nrepl/watch-evaluations!
   ::cards
   (fn [{:keys [code ok result error]}]
     (let [code (str/trim code)]
       (when-not (tooling? code)
         (cards/evaluated! code (when ok result) (when-not ok error) @showing))))))

(defn run!
  "The REPL's server, then the window until it closes; the process ends there. `opts` as
  `cards.core/open!` takes them, and :evaluations, whether each evaluation goes on a card
  (`show-evaluations!`). What's sent with tap> goes on a card (`cards.core/submit`)."
  [opts]
  (deref (nrepl/background-main))
  (show-evaluations! (:evaluations opts))
  (watch-evaluations!)
  (add-tap cards/submit)
  (cards/open! opts)
  (cards/loop!)
  ;; Gone at once, nothing torn down under a REPL thread still compiling (cards::quit).
  (cpp/cards.quit))

(defn -main [& args]
  (run! (assoc (options args) :evaluations true)))
