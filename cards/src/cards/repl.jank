;; SPDX-License-Identifier: MIT
;; The process's nREPL evaluation, made safe for a process that does more than one thing at
;; a time. Loading this namespace replaces the nREPL's eval operation with the same one,
;; changed in two ways (include/cards/repl.hpp says how):
;;
;; - The code runs on a thread with a large stack. jank's nREPL evaluates on threads with a
;;   512 KB stack (macOS), which a function calling itself thirty deep overflows: (fib 30)
;;   from an editor ends the process.
;; - Output is captured so that evaluations at the same time are safe. jank points the
;;   process's stdout and stderr at a file for an evaluation's time and back afterwards;
;;   two evaluations that overlap without one being inside the other (a person's and an
;;   agent's, two editors') restore in the wrong order and leave the process writing to a
;;   file that is gone.
;;
;; Everything else of the operation is jank's: the namespace, *1, *e, the messages answered.
;; (They are set again on the thread that asked: what the large stack's thread sets is its own.)
;; No window is needed for it.
(ns cards.repl
  (:require [clojure.string :as str]
            [jank.nrepl.server.handler :as handler]
            [jank.nrepl.server.handler.eval]
            [jank.nrepl.server.eval :as nrepl-eval]
            [jank.nrepl.server.inspect :as inspect]))

(cpp/raw "#include <cards/repl.hpp>")

;; The stack an evaluation gets, in megabytes. Its memory is only taken as it is used.
(defonce stack-megabytes (atom 256))

(defn on-big-stack
  "What `f` (no arguments) returns, called on a thread of its own with a large stack and
  waited for. The calling thread's bindings are the new thread's; what `f` throws is thrown
  here."
  [f]
  (cpp/cards.repl.on_big_stack f @stack-megabytes))

(def ^:dynamic *result*
  "An atom, bound by who wants an evaluation's value itself (the window, for its card): the
  value is put in it, whichever thread asked."
  nil)

(defn evaluate
  "Code evaluated in namespace `ns` (\"user\" when there is none by that name), as the
  nREPL does, on a large stack. Returns {:ok :value :result :inspected :ns :out :err :error
  :raised}: :value is the value printed and :result itself, :error what was thrown as text
  and :raised itself. *1 and *e are the calling thread's too."
  [code ns file line column inspect?]
  (let [target (or (some-> ns symbol find-ns) (find-ns 'user))
        id (cpp/cards.repl.capture_start)
        ran (try
              (on-big-stack
               (fn []
                 (binding [*ns* target
                           *file* file]
                   ;; The evaluation may change the namespace. *1 and *e are read on the
                   ;; thread that set them, and then set on the one that asked.
                   (let [ok (nrepl-eval/safe-eval code line column)]
                     {:ok ok
                      :ns (str *ns*)
                      :value (when ok (pr-str *1))
                      :result (when ok *1)
                      :raised (when-not ok *e)
                      :inspected (when (and ok inspect?) (inspect/inspect-str *1))
                      :error (when-not ok (str *e))}))))
              (catch jank.runtime.object_ref e {:ok false :error (str e)})
              (catch cpp/std.exception e {:ok false :error (str (cpp/.what e))}))
        wrote (cpp/cards.repl.capture_end id)]
    (cpp/cards.repl.remember (boolean (:ok ran)) (if (:ok ran) (:result ran) (or (:raised ran) (:error ran))))
    (when (and *result* (:ok ran))
      (reset! *result* (:result ran)))
    (assoc ran :out (:out wrote) :err (:err wrote))))

(defn- answer
  "An nREPL eval message answered: jank's own messages."
  [msg]
  (let [inspect? (boolean (some-> (get msg "inspect") parse-boolean))
        ran (evaluate (get msg "code" "")
                      (get msg "ns")
                      (get msg "file" "NO_SOURCE_PATH")
                      (get msg "line" 1)
                      (get msg "column" 1)
                      inspect?)
        out (when-not (str/blank? (:out ran)) {:out (:out ran)})
        err (when-not (str/blank? (:err ran)) {:err (:err ran)})]
    (cond
      (not (:ok ran))
      [out err {:err (:error ran)} {:ex (:error ran) :status [:done :eval-error]}]

      inspect?
      {:value (:inspected ran) :status [:done]}

      :else
      [out err {:value (:value ran) :ns (:ns ran)} {:status [:done]}])))

(defmethod handler/handle-message :eval [msg]
  (answer msg))
