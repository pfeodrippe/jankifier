(ns supercollider-sys.example
  "Runs SuperCollider's server in this process, with no audio device: it renders a short score
  (non-realtime synthesis) into a file and reads the samples back. The score loads a SynthDef
  written here byte by byte, SinOsc into Out with a `freq` control, and plays it at 1000 Hz.")

(cpp/raw "
#include <SC_WorldOptions.h>

#include <cmath>
#include <cstdint>
#include <cstring>
#include <filesystem>
#include <fstream>
#include <string>
#include <vector>
#include <unistd.h>

namespace supercollider_sys_example
{
  // Big-endian bytes: OSC (strings and blobs padded to 4 bytes) and SynthDef files (strings
  // prefixed by their length).
  struct bytes
  {
    std::vector<char> b;

    void i8(int v) { b.push_back(static_cast<char>(v & 0xff)); }
    void i16(int v) { i8(v >> 8); i8(v); }
    void i32(int64_t v) { for(int s{ 24 }; s >= 0; s -= 8) { i8(static_cast<int>(v >> s)); } }
    void i64(int64_t v) { i32(v >> 32); i32(v & 0xffffffff); }
    void f32(float v) { uint32_t u; std::memcpy(&u, &v, 4); i32(u); }
    void pad() { while(b.size() % 4) { i8(0); } }
    void osc_string(std::string const &s) { b.insert(b.end(), s.begin(), s.end()); i8(0); pad(); }
    void osc_blob(std::vector<char> const &d) { i32(static_cast<int64_t>(d.size())); b.insert(b.end(), d.begin(), d.end()); pad(); }
    void pstring(std::string const &s) { i8(static_cast<int>(s.size())); b.insert(b.end(), s.begin(), s.end()); }
    void append(bytes const &o) { b.insert(b.end(), o.b.begin(), o.b.end()); }
  };

  // SynthDef file format version 2 (HelpSource/Reference/Synth-Definition-File-Format):
  // Out.ar(0, SinOsc.ar(freq)) with the control freq = 440.
  inline std::vector<char> sine_def()
  {
    bytes d;
    d.b = { 'S', 'C', 'g', 'f' };
    d.i32(2);
    d.i16(1);
    d.pstring(\"sine\");
    d.i32(1); d.f32(0.0f);               // constants: 0 (SinOsc's phase, Out's bus)
    d.i32(1); d.f32(440.0f);             // controls' initial values
    d.i32(1); d.pstring(\"freq\"); d.i32(0);
    d.i32(3);                            // UGens, each: name, rate, inputs, outputs, special index
    d.pstring(\"Control\"); d.i8(1); d.i32(0); d.i32(1); d.i16(0);
    d.i8(1);
    d.pstring(\"SinOsc\"); d.i8(2); d.i32(2); d.i32(1); d.i16(0);
    d.i32(0); d.i32(0);                  // freq: Control's output 0
    d.i32(-1); d.i32(0);                 // phase: constant 0
    d.i8(2);
    d.pstring(\"Out\"); d.i8(2); d.i32(2); d.i32(0); d.i16(0);
    d.i32(-1); d.i32(0);                 // bus: constant 0
    d.i32(1); d.i32(0);                  // signal: SinOsc's output 0
    d.i16(0);                            // variants
    return d.b;
  }

  // A score is OSC bundles, each preceded by its size; the render stops at the last one.
  inline void bundle(bytes &score, double seconds, std::vector<bytes> const &messages)
  {
    bytes b;
    b.osc_string(\"#bundle\");
    b.i64(static_cast<int64_t>(seconds * 4294967296.0));
    for(auto const &m : messages)
    {
      b.i32(static_cast<int64_t>(m.b.size()));
      b.append(m);
    }
    score.i32(static_cast<int64_t>(b.b.size()));
    score.append(b);
  }

  inline double peak{}, frequency{};
  inline long frames{};

  // Renders `seconds` of the sine at `freq`, mono at 48 kHz; 0 when it worked.
  inline int render(double freq, double seconds)
  {
    auto const dir{ std::filesystem::temp_directory_path() };
    auto const tag{ std::to_string(getpid()) };
    auto const score_path{ (dir / (\"supercollider-sys-example-\" + tag + \".osc\")).string() };
    auto const out_path{ (dir / (\"supercollider-sys-example-\" + tag + \".raw\")).string() };

    bytes d_recv, s_new, end;
    d_recv.osc_string(\"/d_recv\"); d_recv.osc_string(\",b\"); d_recv.osc_blob(sine_def());
    // /s_new name node-id add-action target, then control-value pairs.
    s_new.osc_string(\"/s_new\"); s_new.osc_string(\",siiisf\"); s_new.osc_string(\"sine\");
    s_new.i32(1000); s_new.i32(0); s_new.i32(0); s_new.osc_string(\"freq\"); s_new.f32(static_cast<float>(freq));
    end.osc_string(\"/c_set\"); end.osc_string(\",if\"); end.i32(0); end.f32(0.0f);
    bytes score;
    bundle(score, 0.0, { d_recv, s_new });
    bundle(score, seconds, { end });
    std::ofstream(score_path, std::ios::binary).write(score.b.data(), static_cast<long>(score.b.size()));

    WorldOptions options;
    options.mRealTime = false;
    options.mUGensPluginPath = SUPERCOLLIDER_SYS_PLUGIN_DIR;
    options.mLoadGraphDefs = 0;
    options.mNumInputBusChannels = 0;
    options.mNumOutputBusChannels = 1;
    options.mPreferredSampleRate = 48000;
    options.mNonRealTimeCmdFilename = score_path.c_str();
    options.mNonRealTimeOutputFilename = out_path.c_str();
    options.mNonRealTimeOutputHeaderFormat = \"raw\";
    options.mNonRealTimeOutputSampleFormat = \"float\";
    options.mVerbosity = -1;
    World *world{ World_New(&options) };
    if(!world)
    {
      return 1;
    }
    try
    {
      World_NonRealTimeSynthesis(world, &options);   // cleans the world up
    }
    catch(std::exception const &)
    {
      return 2;
    }

    std::ifstream in(out_path, std::ios::binary);
    std::vector<float> samples;
    for(float x; in.read(reinterpret_cast<char *>(&x), sizeof x);)
    {
      samples.push_back(x);
    }
    std::filesystem::remove(score_path);
    std::filesystem::remove(out_path);
    frames = static_cast<long>(samples.size());
    // The frequency from the periods between the first and the last upward zero crossing, each
    // placed between its two samples.
    peak = 0;
    long crossings{};
    double first{}, last{};
    for(size_t i{}; i < samples.size(); ++i)
    {
      peak = std::fmax(peak, std::fabs(samples[i]));
      if(i > 0 && samples[i - 1] < 0 && samples[i] >= 0)
      {
        double const at{ (i - 1) + samples[i - 1] / (samples[i - 1] - samples[i]) };
        (crossings++ ? last : first) = at;
        last = at;
      }
    }
    frequency = crossings > 1 ? (crossings - 1) / ((last - first) / 48000.0) : 0;
    return frames ? 0 : 3;
  }
}")

(defn -main [& _]
  (let [status (cpp/supercollider_sys_example.render 1000.0 0.05)]
    (when-not (zero? status)
      (throw (ex-info (str "render failed: " (get {1 "World_New" 2 "the score" 3 "no samples"} status))
                      {:status status})))
    (println "rendered" cpp/supercollider_sys_example.frames "frames at 48 kHz")
    (println "peak:" cpp/supercollider_sys_example.peak)
    (println "frequency from zero crossings (asked for 1000 Hz):" cpp/supercollider_sys_example.frequency)
    ;; Silence means the SynthDef didn't load: its UGens weren't found in the plugin folder.
    (when-not (and (< 0.99 cpp/supercollider_sys_example.peak 1.01)
                   (< 999.0 cpp/supercollider_sys_example.frequency 1001.0))
      (throw (ex-info "the render isn't the 1000 Hz sine asked for" {})))))
