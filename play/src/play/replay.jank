;; SPDX-License-Identifier: MIT
;; Games a model played, kept and played again. A recording holds what the model was told at
;; each step, its probabilities, thinking and committee votes, and the action taken; the
;; NES is deterministic, so playing the game again from power-on with the same actions
;; shows the same pictures. A replay keeps a save of the console at every step: any step
;; can be gone to at once. A game that can't be saved (NetHack: :saves false) is played again
;; from its start to go back. A game a harness agent played (play.agent) has its
;; conversation above it, as the harness shows any (harness.cards), and that conversation's
;; timeline leads: played, dragged or stepped there, the game goes to the actions whose
;; calls it shows (a few on are played, and their frames shown at the game's speed).
;;
;;   (replay/save! :nova @nova/decisions {:player-settings ...})   ; the file's path
;;   (replay/open! "path.edn")      ; the game again, in a card: the picture and the model's side
;;   (replay/play! 4)               ; steps a second, in the background; (replay/stop!) pauses
;;   (replay/go! 120)               ; to step 120
(ns play.replay
  (:require [clojure.string :as str]
            [cards.core :as c]
            [harness.cards :as hc]
            [play.core :as p]
            ;; (its clock, play_decide.seconds)
            [play.decide]
            [play.doom :as doom]
            [play.nethack :as nethack]
            [play.nova :as nova]
            [play.wnw :as wnw]))

(cpp/raw "#include <cstdlib>
#include <ctime>
#include <filesystem>
#include <string>
namespace play_replay_native
{
  inline bool make_dirs(std::string const &path)
  {
    std::error_code ec;
    std::filesystem::create_directories(path, ec);
    return std::filesystem::is_directory(path);
  }

  inline std::string stamp()
  {
    std::time_t const t{ std::time(nullptr) };
    char out[32];
    std::strftime(out, sizeof out, \"%Y%m%d-%H%M%S\", std::localtime(&t));
    return out;
  }

  inline std::string home()
  {
    char const *const h{ std::getenv(\"HOME\") };
    return h ? h : \".\";
  }

  inline bool exists(std::string const &path)
  {
    std::error_code ec;
    return std::filesystem::exists(path, ec);
  }
}")

(def folder
  "Where recordings are kept."
  (str (cpp/play_replay_native.home) "/Documents/jankifier/replay/games"))

(def games
  "Each game a replay can play again: how it starts from power-on and how a step is done
  (vars, so that a redefinition applies)."
  {:nova {:title "Nova the Squirrel" :start! #'nova/start! :act! #'nova/act! :stop! #'nova/stop!
          :play-model! #'nova/play-model! :decisions #'nova/decisions}
   :nethack {:title "NetHack" :start! #'nethack/start! :act! #'nethack/act! :stop! #'nethack/stop! :picture #'nethack/picture
             :play-model! #'nethack/play-model! :decisions #'nethack/decisions :saves false}
   :doom {:title "Doom" :start! #'doom/start! :act! #'doom/act! :stop! #'doom/stop! :picture #'doom/picture
          :version #'doom/version :acts {1 #'doom/act-v1! 2 #'doom/act-v2! 3 #'doom/act!}
          :play-model! #'doom/play-model! :decisions #'doom/decisions :conversation #'doom/conversation
          :saves false}
   :wnw {:title "Witch n' Wiz" :start! #'wnw/start! :act! #'wnw/act! :stop! #'wnw/stop!
         ;; How actions were played by version (a recording says its own; 1 when it doesn't).
         :version 2 :acts {1 #'wnw/act-v1! 2 #'wnw/act!}
         :play-model! #'wnw/play-model! :decisions #'wnw/decisions}})

(defn- deref-version
  "A game's actions' version now (a number, or a var of one: 1 when not said)."
  [game]
  (let [v (get-in games [game :version] 1)]
    (if (var? v) @v v)))

(defn save!
  "A game's decisions (each {:action :probs :told ...}) written to a file of `folder`, with
  `about` (the players' settings, notes): its path."
  ([game decisions] (save! game decisions {}))
  ([game decisions about]
   (cpp/play_replay_native.make_dirs folder)
   (let [path (str folder "/" (name game) "-" (cpp/play_replay_native.stamp) ".edn")]
     (spit path (pr-str {:game game :about (assoc about :version (deref-version game))
                         :steps (vec decisions)}))
     path)))

(defn record!
  "A game played from power-on by `deciders` (a player, or a vector of them: a committee,
  `opts` as the game's play-model!'s) for `steps` steps, or until :minutes (in `opts`) have
  gone by, in the background, and kept when it ends (also when stopped): a future of the
  recording's path."
  ([game deciders steps] (record! game deciders steps {}))
  ([game deciders steps opts]
   (let [{:keys [start! play-model! decisions stop! conversation]} (get games game)]
     (when-let [failed (start!)]
       (throw (ex-info (str "the game didn't start: " failed) {})))
     (let [playing (play-model! deciders steps (dissoc opts :minutes))]
       (when-let [minutes (:minutes opts)]
         (future
           (let [until (+ (cpp/play_decide.seconds) (* 60.0 minutes))]
             (loop []
               (when (and (not (realized? playing)) (< (cpp/play_decide.seconds) until))
                 (cpp/usleep 500000)
                 (recur)))
             (stop!))))
       (future
         @playing
         (let [path (save! game @@decisions
                           {:steps steps :opts (dissoc opts :minutes)
                            ;; The choices as a conversation beside it (a replay shows it).
                            :agent (boolean (and conversation @@conversation))
                            :settings (if (vector? deciders) (mapv (fn [d] @(:config d)) deciders) @(:config deciders))})]
           (when-let [conv (and conversation @@conversation)]
             (harness.core/save! conv (str/replace path #"\.edn$" ".agent.edn")))
           path))))))

(defonce st (atom {}))
(defonce replaying (atom nil))
(defonce running (atom false))

(defn- show!
  "Step `i` of the replay shown: the picture is the console's now (after the steps before it).
  With `push`, an agent's conversation is moved to the step's call (when the game moved it;
  not when the conversation's timeline did)."
  [i push]
  (let [{:keys [steps]} @replaying
        d (get steps i)]
    (reset! st {:step i :action (:action d) :decision d :told (:told d)
                :result (str "replay, step " i " of " (count steps))})
    (when (and push (:conversation @replaying) (:entry d))
      (hc/to-entry! "replay agent" (:entry d)))))

(defn- act-of
  "The game's action as the recording played it (its version), for step `step` (an agent's
  step says its own: the game may have changed while it played)."
  ([r] (act-of r nil))
  ([r step]
   (let [{:keys [acts] :as g} (get games (:game r))]
     (if acts
       (get acts (or (:version step) (:version (:about r)) 1))
       (:act! g)))))

(defn- go-to!
  "To step `i` (go!), the conversation moved there too when `push`."
  [i push]
  (let [{:keys [game steps saves at]} @replaying
        {:keys [start!]} (get games game)
        act! (act-of @replaying)
        i (max 0 (min i (dec (count steps))))
        known (dec (count @saves))]
    (cond
      (false? (get-in games [game :saves]))
      (let [from (if (< i at) (do (start!) 0) at)]
        (doseq [k (range from i)]
          ((act-of @replaying (get steps k)) (:action (get steps k)))))

      (<= i known)
      (p/nes-restore! (get @saves i))

      :else
      (do (p/nes-restore! (get @saves known))
          (doseq [k (range known i)]
            ((act-of @replaying (get steps k)) (:action (get steps k)))
            (swap! saves conj (p/nes-save!)))))
    (swap! replaying assoc :at i)
    (show! i push)
    i))

(defn go!
  "To step `i`: the game as it was when the model decided step `i` (from the save kept
  there, or played up to it), and an agent's conversation at that step's call."
  [i]
  (let [at (go-to! i true)]
    (p/nes-flush!)
    at))

(declare follow!)

(defn open!
  "A recording played again from its start, in a card pinned at the top of the window: the
  game's picture and, beside it, the model's side of each step."
  [path]
  (reset! running false)
  (let [r (read-string (slurp path))
        {:keys [start! title]} (get games (:game r))]
    (when-let [failed (start!)]
      (throw (ex-info (str "the game didn't start: " failed) {})))
    (let [conversation (str/replace path #"\.edn$" ".agent.edn")
          conversation (when (and (:agent (:about r)) (cpp/play_replay_native.exists conversation)) conversation)]
      (when conversation
        (hc/replay! conversation "replay agent"))
      (reset! replaying (assoc r :at 0 :path path :conversation conversation :token (str path "@" (cpp/play_decide.seconds))
                               :saves (atom (if (false? (get-in games [(:game r) :saves])) [] [(p/nes-save!)])))))
    ;; In the game's own card's place: there is one console.
    (c/pin! title st (p/decision-card ((or (:picture (get games (:game r))) (fn [] (p/picture-part :nes 300))))))
    (show! 0 false)
    ;; An agent's game follows its conversation's timeline.
    (when (:conversation @replaying)
      (hc/pause! "replay agent")
      (follow! (:token @replaying)))
    (count (:steps r))))

(defn step!
  "One step on: the action of the step shown done, the next shown."
  []
  (let [{:keys [at steps]} @replaying]
    (when (< (inc at) (count steps))
      (go! (inc at)))))

(defn- step-played!
  "One step on, its action played from the step shown (not taken from a save: its frames are
  run, to be seen); the conversation moved to the next call when `push`."
  [push]
  (let [{:keys [game at steps saves] :as r} @replaying
        savable (not (false? (get-in games [game :saves])))]
    (when (< (inc at) (count steps))
      (when savable
        (p/nes-restore! (get @saves at)))
      ((act-of r (get steps at)) (:action (get steps at)))
      (when (and savable (= (count @saves) (inc at)))
        (swap! saves conj (p/nes-save!)))
      (swap! replaying assoc :at (inc at))
      (show! (inc at) push)
      (inc at))))

(defn- follow!
  "While replay `token` is the one open: the game kept where the agent's conversation is
  shown (its timeline played, dragged or stepped): after the actions whose calls it shows.
  A few actions on are played frame by frame, a jump is gone to at once."
  [token]
  (future
    (try
      (loop []
        (when (= token (:token @replaying))
          (when-let [n (hc/shown-entries "replay agent")]
            (let [{:keys [at steps]} @replaying
                  target (min (dec (count steps))
                              (count (filter (fn [d] (and (:entry d) (< (:entry d) n))) steps)))]
              (cond
                (and (> target at) (<= (- target at) 4))
                (dotimes [_ (- target at)]
                  (step-played! false))

                (not= target at)
                (do (go-to! target false)
                    ;; A jump: its target at once, not the frames that got there.
                    (p/nes-flush!)))))
          (cpp/usleep 100000)
          (recur)))
      (catch :default _ nil))))

(defn- play-steps!
  "play! of a game without a conversation: `pace` steps a second, or :fluid."
  [pace]
  (reset! running true)
  (future
    (try
      (loop []
        (when @running
          (let [{:keys [at steps]} @replaying]
            (when (< (inc at) (count steps))
              (if (= pace :fluid)
                ;; Each action played, and its frames shown (at the game's speed) before the next.
                (do (step-played! true)
                    (loop []
                      (when (and @running (pos? (p/nes-queued)))
                        (cpp/usleep 20000)
                        (recur))))
                (do (step!)
                    (cpp/usleep (long (/ 1000000 pace)))))
              (recur)))))
      (catch :default _ nil))
    (reset! running false))
  :playing)

(defn play!
  "The replay going on by itself, in the background. An agent's game: its conversation's
  timeline played (the game follows it, each action's frames at the game's own speed).
  Else `per-second` steps a second (2 when not said), or with :fluid (`(play! :fluid)`) each
  step's frames at the game's own speed. stop! pauses it."
  ([] (play! 2))
  ([pace]
   (if (:conversation @replaying)
     (do (hc/play! "replay agent") :playing)
     (play-steps! pace))))

(defn stop!
  "The replay paused (an agent's conversation with it)."
  []
  (reset! running false)
  (when (:conversation @replaying)
    (hc/pause! "replay agent"))
  nil)
