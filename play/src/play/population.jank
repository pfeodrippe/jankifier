;; SPDX-License-Identifier: MIT
(ns play.population
  "Several harness agents on one model playing one game from the same start, each in its own
  copy of the game. There is one game in the process: it is switched to an agent's copy while
  that agent's tool call runs (one call at a time), and the engine makes the agents' tokens
  one forward when they meet (inkling's :auto-batch). Every few minutes the agents furthest on
  are kept and the others replaced by copies of them: their conversation and their game. What
  the best of them reaches is what the search reaches, not one agent alone.

    (def pop (population/start! :nethack m {:agents 4 :every 5 :minutes 30}))
    (population/report)   ; each agent's progress
    (population/stop!)"
  (:require [clojure.string :as str]
            [harness.core :as h]
            [cards.core :as c]
            [harness.cards :as hc]
            [inkling.core :as ink]
            [play.agent :as agent]
            [play.core :as p]
            [play.nethack :as nethack]
            [play.nova :as nova]
            [play.replay :as replay]))

;; A game's copy: what is kept of it while another agent plays, and how it is put back.
;; NetHack has no snapshot, but with the same seed it plays the same way: its copy is the
;; actions from its start (replayed in well under a second) and the traps the agent's text
;; has noted. Nova's is the emulator's saved state.
(defonce ^{:doc "The traps any agent's copy has noted (NetHack): #{[level x y]}."} shared-traps (atom #{}))
(defonce ^{:doc "The stairs down any agent's copy has seen (NetHack): #{[level x y]}."} shared-stairs (atom #{}))

(def copies
  {:nethack {:take (fn [c]
                    (swap! shared-traps into @nethack/traps)
                    (swap! shared-stairs into @nethack/stairs)
                    ;; The squares shown so far, by level (the screen alone counts less when a
                    ;; menu covers the map: a score from it went down and up).
                    (let [s (nethack/state)
                          depth (:depth (:stats s))
                          shown (when (:normal s)
                                  (for [r (range 1 22)
                                        :let [line (get (:screen s) r "")]
                                        x (range (count line))
                                        :when (not= \space (nth line x))]
                                    [depth x r]))]
                      (-> c
                          (assoc :traps @nethack/traps :stairs @nethack/stairs)
                          (update :seen (fnil into #{}) shown))))
             :put! (fn [c]
                     (nethack/start! (:seed c 1))
                     ;; Each screen looked at for traps and stairs (stairs seen before they were
                     ;; remembered, then hidden under the @, came back this way).
                     (doseq [k (:actions c)] (nethack/act! k) (nethack/note-map!))
                     ;; Its traps, and the traps any agent found on the first level: with the
                     ;; same seed that level is the same in every copy (deeper ones are made
                     ;; when first reached, from the game's random state then, so they differ).
                     (reset! nethack/traps (into (:traps c #{}) (filter (fn [[d]] (= 1 d)) @shared-traps)))
                     (reset! nethack/stairs (into (:stairs c #{}) (filter (fn [[d]] (= 1 d)) @shared-stairs))))
             :fresh (fn [seed] {:seed seed :actions [] :traps #{}})
             ;; Further on: deeper, then more of the dungeon seen, then more experience.
             ;; A game that has ended (the character died) is last.
             :score (fn [s c] (if (:done s)
                                -1
                                (+ (* 100000 (:depth (:stats s))) (* 10 (count (:seen c))) (:xp-level (:stats s)))))}
   :nova {:take (fn [c] (assoc c :save (p/nes-save!)))
          :put! (fn [c] (p/nes-restore! (:save c)))
          :fresh (fn [_] {:save (p/nes-save!)})
          ;; The areas in the level's order, then how far right, then health.
          :score (fn [s _] (+ (* 1000 (get {0 0 49 1 45 2} (:level s) 0)) (long (:x s)) (* 0.01 (:health s))))}})

(defonce ^{:doc "The agents: [{:id :agent :copy (atom) :steps (atom) :score}]."} members (atom []))
(defonce running (atom false))
(defonce ^{:doc "What the agents told each other: [{:from id :text}]."} board (atom []))
(defonce ^:private owner (atom nil))
(defonce ^:private holding (atom nil))

(defn- with-game
  "f run with the game switched to member `m`'s copy, one member at a time."
  [game m f]
  (let [{:keys [take put!]} (get copies game)
        id (:id m)]
    (loop []
      (when-not (compare-and-set! owner nil id)
        (cpp/usleep 2000)
        (recur)))
    (try
      (when-not (= @holding id)
        (put! @(:copy m))
        (reset! holding id))
      (let [r (f)]
        (swap! (:copy m) take)
        r)
      (finally (reset! owner nil)))))

(defn- member
  "Member `id` of game `game`: an agent on `m` whose tools play its own copy (`copy`) and keep
  its own steps."
  [game m opts id copy steps]
  (let [g (get agent/games game)
        mem {:id id :copy (atom copy) :steps (atom (vec steps))
             ;; Set to hold its turns (for a copy to be made of it); :paused once they are held.
             :hold (atom false) :paused (atom false)}
        ;; The game's act! also kept in the copy: NetHack's copy is its actions.
        g (assoc g :act! (fn [k] (swap! (:copy mem) update :actions (fnil conj []) k) ((:act! g) k)))
        tell {:name "tell_others"
              :doc (str "Tells the other agents playing this same game (the same dungeon, each in its own copy) "
                        "something you found that helps them: where the stairs are, a trap, a dead end, what "
                        "worked. Short and plain; they read it at their next turn.")
              :params {:text {:type "string" :doc "what to tell them"}}
              :fn (fn [{:keys [text]}]
                    (swap! board conj {:from id :text (str text)})
                    ;; A string made at the call (a bare literal here broke jank's C++).
                    (str "Told: the others read it at their next turn."))}
        a (agent/agent-of g m opts {:steps (:steps mem) :running running :guard (fn [f] (with-game game mem f))
                                    :extra-tools [tell]})]
    (assoc mem :agent a :read (atom (count @board)))))

(defn- turns!
  "Member `mem`'s agent asked to play, turn after turn, until `running` is off or its :retired
  is set: a future."
  [mem first-ask]
  (future
    (try
      (loop [i 0]
        (when (and @running (not (:retired @(:copy mem))))
          (when @(:hold mem)
            (reset! (:paused mem) true)
            (loop [] (when (and @(:hold mem) @running) (cpp/usleep 100000) (recur)))
            (reset! (:paused mem) false))
          (let [new (filter (fn [e] (not= (:from e) (:id mem))) (subvec @board (min @(:read mem) (count @board))))
                heard (when (seq new)
                        (str "\n\nThe other agents told you:\n"
                             (str/join "\n" (for [e new] (str "- agent " (:from e) ": " (:text e))))))]
            (reset! (:read mem) (count @board))
            ;; A reminder to share: no agent used tell_others in two runs, unasked.
            (h/ask! (:agent mem) (str (if (zero? i) first-ask "Go on playing: a new turn, with its own steps (the game is as you left it).")
                                      heard
                                      "\n\nWhen you find something the other agents should know (the stairs down, a trap, a dead end, what worked), tell_others.")))
          (h/answer (:agent mem))
          (recur (inc i))))
      (catch :default _ nil))
    :done))

(defn score-of
  "Member `mem`'s progress, read from its copy of the game."
  [game mem]
  (with-game game mem (fn [] ((:score (get copies game)) ((:state (get agent/games game))) @(:copy mem)))))

(defn report
  "Each member's id, score, actions and progress."
  ([] (report (:game (meta @members))))
  ([game]
   (vec (for [mem @members]
          {:id (:id mem) :score (score-of game mem) :actions (count @(:steps mem))
           :progress (with-game game mem (fn [] ((:progress (get agent/games game)) ((:state (get agent/games game))))))}))))

(defn- fork!
  "A new member from member `best`: best's turns held and its turn stopped, then its
  conversation and its session's state copied into a new agent (ink/copy!: no tokens made
  again; saving and making the conversation again took a minute), its game copy and steps
  copied; then both go on. Returns the new member, started."
  [game m opts best id]
  (let [a (:agent best)]
    (reset! (:hold best) true)
    ;; Its turn stopped, until its loop holds (a turn may have begun as the hold was set).
    (loop [] (h/stop! a) (when-not @(:paused best) (cpp/usleep 50000) (recur)))
    (try
      (let [mem (member game m opts id (dissoc @(:copy best) :retired) @(:steps best))
            b (:agent mem)
            v @a]
        (swap! b assoc :entries (:entries v) :view (:view v) :notes (:notes v) :effort-said (:effort-said v)
               :generated (:generated v) :seconds (:seconds v) :step-count (:step-count v))
        (ink/copy! (:session @b) (:session v))
        (hc/watch! b (str (name game) " agent " id))
        (assoc mem :future (turns! mem "You were stopped and are going on where you were: look, and go on playing.")))
      (finally (reset! (:hold best) false)))))

(defn start!
  "`agents` agents on model `m` playing `game` from its start for `minutes`; every `every`
  minutes the better half kept and the rest replaced by forks of it. `opts` also as
  agent/play!'s. A future of each member's result at the end."
  [game m opts]
  (let [opts (merge agent/defaults {:agents 4 :every 5 :minutes 30} opts)
        g (get agent/games game)
        {:keys [fresh]} (get copies game)]
    (reset! running true)
    (reset! board [])
    (reset! shared-traps #{})
    (reset! shared-stairs #{})
    (reset! owner nil)
    (reset! holding nil)
    (when-let [failed ((:start! g))]
      (throw (ex-info (str "the game didn't start: " failed) {})))
    ;; Only this game's card at the top (Nova's stayed above NetHack's and hid it).
    (c/unpin!)
    ((:watch! g))
    (let [first-copy (fresh (:seed opts 1))
          began (cpp/play_decide.seconds)
          minutes-of (fn [] (/ (- (cpp/play_decide.seconds) began) 60.0))
          started (vec (for [i (range (:agents opts))]
                         (let [mem (member game m (assoc opts :seed (+ (:seed opts 1) i)) i first-copy [])]
                           (hc/watch! (:agent mem) (str (name game) " agent " i))
                           (assoc mem :future (turns! mem "Play the game. Look first.")))))]
      (reset! members (with-meta started {:game game}))
      (future
        (try
          (loop [next-id (:agents opts) last-cut 0.0]
            (when (and @running (< (minutes-of) (:minutes opts)))
              (cpp/usleep 5000000)
              (if (< (- (minutes-of) last-cut) (:every opts))
                (recur next-id last-cut)
                ;; The cut: the better half kept, each of the rest replaced by a fork of one of
                ;; them (the best first).
                (let [ranked (sort-by (fn [mem] (- (score-of game mem))) @members)
                      kept (vec (take (quot (count ranked) 2) ranked))
                      dropped (vec (drop (count kept) ranked))]
                  (doseq [mem dropped]
                    (swap! (:copy mem) assoc :retired true)
                    (h/stop! (:agent mem))
                    (h/close! (:agent mem)))
                  (let [forks (vec (map-indexed (fn [i _] (fork! game m (assoc opts :seed (+ next-id i)) (nth kept (mod i (count kept))) (+ next-id i)))
                                                dropped))]
                    (reset! members (with-meta (into kept forks) {:game game}))
                    (recur (+ next-id (count dropped)) (minutes-of)))))))
          (catch :default _ nil))
        (reset! running false)
        (doseq [mem @members] (h/stop! (:agent mem)))
        (let [ranked (sort-by (fn [mem] (- (score-of game mem))) @members)]
          (vec (for [mem ranked]
                 (let [path (replay/save! game @(:steps mem) (assoc (select-keys opts [:effort :minutes :temperature :context]) :agent true :population (:id mem)))
                       conversation (str/replace path #"\.edn$" ".agent.edn")]
                   (h/save! (:agent mem) conversation)
                   (h/close! (:agent mem))
                   {:id (:id mem) :recording path :conversation conversation :score (score-of game mem)
                    :actions (count @(:steps mem))}))))))))

(defn stop! [] (reset! running false))
