;; SPDX-License-Identifier: MIT
;; NetHack (the NetHack Learning Environment's core, built in vendor/nle): a step is a key; what
;; a model is told is the terminal (24 lines), the bottom lines' numbers by name, the last
;; message and the inventory. A scripted player explores at random and answers what it is
;; asked.
;;
;;   (nethack/watch!)      ; its card, at the top of the window
;;   (nethack/start! 7)    ; a game, seed 7
;;   (nethack/play! 300)   ; the scripted player, 300 steps, in the background
;;   (nethack/told)        ; what a model is told now
(ns play.nethack
  (:require [clojure.string :as str]
            [cards.core :as c]
            [play.core :as p]
            [play.decide :as decide]))

(def library (p/vendor "nle" "build" "libnethack.so"))
(def nhdat (p/vendor "nle" "build" "dat" "nhdat"))
(def run-dir (str p/here "/target/nethack-run"))

;; The NetHack Learning Environment's options (nle/nethack/nethack.py).
(def options
  (str "autopickup,color,disclose:+i +a +v +g +c +o,mention_walls,nobones,nocmdassist,"
       "nolegacy,nosparkle,pickup_burden:unencumbered,pickup_types:$?!/,runmode:teleport,showexp,"
       "showscore,time"))

(defonce st (atom {}))

(defn state
  "{:screen [24 lines] :cursor [row col] :stats {...} :message :normal :done :inventory}."
  []
  (let [s (cpp/play.nethack_state)
        n (:stats s)
        stat (fn [i] (nth n i 0))]
    (assoc s :stats {:x (stat 0) :y (stat 1) :strength (stat 2) :dexterity (stat 4) :constitution (stat 5)
                     :intelligence (stat 6) :wisdom (stat 7) :charisma (stat 8) :score (stat 9)
                     :hp (stat 10) :hp-max (stat 11) :depth (stat 12) :gold (stat 13) :energy (stat 14)
                     :energy-max (stat 15) :armor-class (stat 16) :xp-level (stat 18) :xp (stat 19)
                     :turn (stat 20) :hunger (stat 21) :dungeon-level (stat 24)})))

;; NetHack's hunger states (u.uhs): 0 satiated, 1 not hungry, 2 hungry, 3 weak, 4 fainting, 5
;; fainted, 6 starved.
(def hunger-names ["satiated" "not hungry" "hungry" "weak" "fainting" "fainted" "starved"])

(def char-names
  {"." "floor" "#" "a corridor" "|" "a wall" "-" "a wall or an open door" "+" "a closed door (or a spellbook)"
   " " "nothing seen (rock or dark)" "<" "stairs up" ">" "stairs down" "$" "gold" "%" "food" ")" "a weapon"
   "[" "armor" "!" "a potion" "?" "a scroll" "/" "a wand" "=" "a ring" "\"" "an amulet" "*" "a gem or rock"
   "^" "a trap" "{" "a fountain" "_" "an altar" "`" "a boulder or stone"})

(defn- char-name [ch]
  (cond (contains? char-names ch) (get char-names ch)
        (re-matches #"[a-zA-Z@&;:']" ch) (str "a monster or person (" ch ")")
        :else (str "'" ch "'")))

(declare open-door?)

(defn- around
  "What is next to the @ (the cursor) in each direction, as a sentence."
  [s]
  (let [[row col] (:cursor s)
        screen (:screen s)
        at (fn [dr dc]
             (let [line (get screen (+ row dr) "")
                   c (+ col dc)]
               (if (and (>= c 0) (< c (count line))) (subs line c (inc c)) " ")))]
    (when (= "@" (at 0 0))
      (str "Next to you: "
           (str/join ", " (for [[label dr dc] [["north" -1 0] ["north-east" -1 1] ["east" 0 1] ["south-east" 1 1]
                                               ["south" 1 0] ["south-west" 1 -1] ["west" 0 -1] ["north-west" -1 -1]]]
                            (let [ch (at dr dc)]
                              (str label " "
                                   ;; | and - are walls, or open doors: the wall around tells.
                                   (if (contains? #{"|" "-"} ch)
                                     (if (open-door? s (+ col dc) (+ row dr -1)) "an open door" "a wall")
                                     (char-name ch))))))
           ".\n"))))

(defonce ^{:doc "Traps seen on the map: #{[dungeon-level x y]}. Once the @ stands on one the map
  shows the @, not the ^: an agent stepped back into the bear trap it had left, again and again."}
  traps (atom #{}))

(defonce ^{:doc "Stairs down seen on the map: #{[dungeon-level x y]}. Standing on them, the map shows
  the @: two agents found the stairs, stepped onto them and lost them."}
  stairs (atom #{}))

(declare note-traps!)

(defn note-map!
  "The traps and stairs on the screen now (and under the @ when the game's message speaks of
  them) remembered: for a game played again key by key, whose screens nobody was told."
  []
  (note-traps! (state)))

(defn- note-traps!
  "Adds the traps (^) on the screen's map (rows 1 to 21; a map row is the screen row less one),
  and the @'s square when the game's message speaks of a trap."
  [s]
  (let [depth (:depth (:stats s))]
    ;; A trap under an item shows the item, not the ^ (an agent's bear trap had a corpse on
    ;; it): the square the @ is on when the game speaks of a trap is one too.
    (when (re-find #"trap|shoots out at you" (str/lower-case (str (:message s))))
      (swap! traps conj [depth (:x (:stats s)) (:y (:stats s))]))
    (when (re-find #"staircase down here" (str/lower-case (str (:message s))))
      (swap! stairs conj [depth (:x (:stats s)) (:y (:stats s))]))
    (doseq [r (range 1 22)
            :let [line (get (:screen s) r "")]
            c (range (count line))
            :when (contains? #{\^ \>} (nth line c))]
      (swap! (if (= \^ (nth line c)) traps stairs) conj [depth c (dec r)]))))

(def ^:private steps-by-direction
  {:north [0 -1] :south [0 1] :east [1 0] :west [-1 0]
   :north-east [1 -1] :north-west [-1 -1] :south-east [1 1] :south-west [-1 1]})

(declare open-door? map-cell)

(defn caution
  "Why `action` should not be done now (nil: it may be): a step onto a trap seen before; a
  diagonal step into a door (NetHack allows none: an agent tried again and again)."
  [s action]
  (when-let [[dx dy] (get steps-by-direction action)]
    (let [{:keys [depth x y]} (:stats s)
          tx (+ x dx) ty (+ y dy)]
      (cond
        (contains? @traps [depth tx ty])
        (str "a trap (^) you have seen is " (name action) " of you: stepping onto it springs it again "
             "(a bear trap holds you for turns, an arrow or dart trap hurts). Go around it.")
        (and (not (zero? dx)) (not (zero? dy))
             (or (= "+" (map-cell s tx ty)) (open-door? s tx ty)))
        (str "the " (name action) " square is a door: no one steps into a door diagonally. Step "
             "beside it first, then into it straight (north, south, east or west).")))))

;; The way through the map: a search from the @ over the squares one can walk (an open door
;; told from a wall by the wall around it), for the stairs down when they are in view, else
;; for the nearest place the unexplored goes on from (a doorway with unseen space beyond it,
;; a corridor's end). An agent counted terminal columns, was 6 off, and went round the same
;; rooms for minutes. The map is the screen's rows 1 to 21 (a map row is the screen row less
;; one, a column the screen column).

(defn- map-cell [s x y]
  (let [line (get (:screen s) (inc y) "")]
    (if (and (<= 0 x) (< x (count line)) (<= 0 y) (< y 21)) (subs line x (inc x)) " ")))

(defn- open-door?
  "An open door: a | with wall on both its left and right (in a wall of -), or a - with wall
  above and below it (in a wall of |), and not its own kind in line (a wall's | has | above or
  below; a corner - next to a doorway has wall only one way)."
  [s x y]
  (let [c (map-cell s x y) wall? (fn [cc] (contains? #{"|" "-"} cc))]
    (or (and (= "|" c) (not= "|" (map-cell s x (dec y))) (not= "|" (map-cell s x (inc y)))
             (wall? (map-cell s (dec x) y)) (wall? (map-cell s (inc x) y)))
        (and (= "-" c) (not= "-" (map-cell s (dec x) y)) (not= "-" (map-cell s (inc x) y))
             (wall? (map-cell s x (dec y))) (wall? (map-cell s x (inc y))))
        ;; In a dark room's wall not seen yet: a | with somewhere to walk above and below it
        ;; (or a - with it left and right) is a door.
        ;; Walkable and not a door itself: a - between two + is wall (---+-+-).
        (let [open? (fn [cc] (not (contains? #{" " "|" "-" "+"} cc)))]
          (or (and (= "|" c) (open? (map-cell s x (dec y))) (open? (map-cell s x (inc y))))
              (and (= "-" c) (open? (map-cell s (dec x) y)) (open? (map-cell s (inc x) y))))))))

(defn- passable-at? [s x y]
  (let [c (map-cell s x y)]
    (or (not (contains? #{" " "|" "-"} c)) (open-door? s x y))))

(def ^:private way-steps {[0 -1] "north" [0 1] "south" [1 0] "east" [-1 0] "west"
            [1 -1] "north-east" [-1 -1] "north-west" [1 1] "south-east" [-1 1] "south-west"})

(defn- way-search
  "Breadth first from the @ over passable squares: {[x y] [dx dy from]}."
  [s]
  (let [{:keys [x y]} (:stats s)]
    (loop [frontier [[x y]] seen {[x y] nil}]
      (if (empty? frontier)
        seen
        (let [[px py] (first frontier)
              here (map-cell s px py)
              next (for [[dx dy] (keys way-steps)
                         :let [nx (+ px dx) ny (+ py dy)]
                         :when (and (not (contains? seen [nx ny]))
                                    (passable-at? s nx ny)
                                    ;; No diagonal step into or out of a doorway (+, or a
                                    ;; door square in a wall line).
                                    (or (zero? dx) (zero? dy)
                                        (and (not= "+" here) (not= "+" (map-cell s nx ny)))))]
                     [nx ny dx dy])]
          (recur (into (vec (rest frontier)) (map (fn [[nx ny]] [nx ny]) next))
                 (reduce (fn [m [nx ny dx dy]] (assoc m [nx ny] [dx dy [px py]])) seen next)))))))

(defn- path-to [seen goal]
  (loop [at goal acc ()]
    (let [[dx dy from] (get seen at)]
      (if (nil? dx) (vec acc) (recur from (conj acc [dx dy]))))))

(defn- legs
  "Moves as runs of the same direction: \"3 east, 2 south-east\"."
  [moves]
  (str/join ", " (for [run (partition-by identity moves)] (str (count run) " " (get way-steps (first run))))))

(defn- doorway?
  "A door square: + or an open door, or a floor square in a wall line (a broken door)."
  [s x y]
  (let [c (map-cell s x y) wall? (fn [cc] (contains? #{"|" "-"} cc))]
    (or (= "+" c) (open-door? s x y)
        (and (= "." c) (or (and (wall? (map-cell s (dec x) y)) (wall? (map-cell s (inc x) y)))
                           (and (wall? (map-cell s x (dec y))) (wall? (map-cell s x (inc y)))))))))

(defn- frontier?
  "Where the unexplored may go on: a doorway with unseen space beyond it, or a corridor square
  with one passable square around it (its end, or where it goes on unseen). A corridor is
  always next to rock, so being next to unseen space alone says nothing."
  [s [x y]]
  (let [around (filter (fn [[dx dy]] (passable-at? s (+ x dx) (+ y dy))) (keys way-steps))]
    (or (and (doorway? s x y)
             (some (fn [[dx dy]] (= " " (map-cell s (+ x dx) (+ y dy)))) [[0 -1] [0 1] [1 0] [-1 0]]))
        (and (= "#" (map-cell s x y)) (<= (count around) 1)))))

(defn- way
  "Sentences: the way to the stairs down when they are in view, else to the nearest edge of
  what has been seen."
  [s]
  (let [seen (way-search s)
        depth (:depth (:stats s))
        stairs (first (filter (fn [p] (or (= ">" (map-cell s (first p) (second p)))
                                           (contains? @stairs [depth (first p) (second p)])))
                              (keys seen)))
        dist (fn [p] (count (path-to seen p)))]
    (cond
      (and stairs (pos? (count (path-to seen stairs))))
      (str "The way to the stairs down (>): " (legs (path-to seen stairs)) ", then down.")
      stairs nil
      :else (when-let [f (first (sort-by dist (filter (fn [p] (frontier? s p)) (keys seen))))]
              (when (pos? (dist f))
                (str "No stairs down in view. The nearest way into what you haven't seen: "
                     (legs (path-to seen f)) "."))))))

(def ^:private direction-names
  {[0 -1] "north" [0 1] "south" [1 0] "east" [-1 0] "west"
   [1 -1] "north-east" [-1 -1] "north-west" [1 1] "south-east" [-1 1] "south-west"})

(defn- changed
  "A line for what changed from `before` to `s`: the game's message, where the @ went, the HP."
  [s before]
  (let [a (:stats before) b (:stats s)
        msg (str/trim (str (:message s)))
        dx (- (:x b) (:x a)) dy (- (:y b) (:y a))
        moved (cond (and (zero? dx) (zero? dy)) nil
                    (contains? direction-names [dx dy]) (str "You moved " (get direction-names [dx dy]) ".")
                    :else "You moved.")
        hp (when (not= (:hp a) (:hp b)) (str " HP " (:hp a) " to " (:hp b) "."))
        depth (when (not= (:depth a) (:depth b)) (str " Dungeon level " (:depth a) " to " (:depth b) "."))]
    (str (or moved (if (= (:screen s) (:screen before)) "Nothing changed." "You stayed where you were."))
         hp depth
         (when (seq msg) (str " The game says: " msg)))))

(defn told
  "What a model is told: the terminal, then the numbers and the inventory in words; with the
  state a step before, first a line of what changed."
  ([] (told (state)))
  ([s before] (if before (str (changed s before) "\n" (told s)) (told s)))
  ([s]
   (let [st (:stats s)
         ;; The top lines joined (a long message wraps, --More-- with it).
         top (str/replace (str/join "" (take 3 (:screen s))) #"\s+" " ")
         waiting (cond (str/includes? (str/replace top " " "") "--More--")
                       "The game waits for you to read its message (--More--): answer more.\n"
                       (re-find #"\[[yn]+[^\]]*\]" top)
                       "The game asks a question: answer yes or no (or escape).\n")]
     (note-traps! s)
     (str waiting
          (str/join "\n" (map str/trimr (:screen s))) "\n"
          "HP " (:hp st) "/" (:hp-max st) ", armor class " (:armor-class st) ", experience level "
          (:xp-level st) ", dungeon level " (:depth st) ", gold " (:gold st) ", turn " (:turn st)
          ", " (get hunger-names (:hunger st) "hunger unknown") ".\n"
          (around s)
          (when (:normal s) (when-let [w (way s)] (str w "\n")))
          (let [{:keys [depth x y]} (:stats s)]
            (when (contains? @stairs [depth x y])
              "You stand on the stairs down (>; the map shows you, not the >): the action down goes down them.\n"))
          (let [{:keys [depth x y]} (:stats s)]
            (when (contains? @traps [depth x y])
              "You stand on a trap you saw before (the map shows you, not the ^): moving off it may take some tries if it holds you.\n"))
          (let [near (filter (fn [[d tx ty]] (and (= d (:depth (:stats s)))
                                                   (<= (max (- tx (:x (:stats s))) (- (:x (:stats s)) tx)) 1)
                                                   (<= (max (- ty (:y (:stats s))) (- (:y (:stats s)) ty)) 1)
                                                   (not (and (= tx (:x (:stats s))) (= ty (:y (:stats s)))))))
                             @traps)]
            (when (seq near)
              (str "Traps you have seen next to you: "
                   (str/join ", " (for [[_ tx ty] near] (get direction-names [(- tx (:x (:stats s))) (- ty (:y (:stats s)))])))
                   " (don't step there).\n")))
          (when (seq (str/trim (:message s))) (str "Message: " (str/trim (:message s)) "\n"))
          (when-not (:normal s) "A menu or a question is open.\n")
          "Inventory:\n" (:inventory s)))))

(declare act!)

(defn start!
  "A new game with `seed`, past its opening: the character picked by the game (`y`), its
  story and welcome passed (Enter), until the map is there. nil, or what went wrong."
  ([] (start! 1))
  ([seed]
   (reset! traps #{})
   (reset! stairs #{})
   (let [dir (cpp/play.nethack_prepare run-dir nhdat)]
     (or (cpp/play.nethack_open library dir options seed)
         (do
           (act! :yes)
           (loop [i 0]
             (when (and (< i 20) (not (:normal (state))))
               (act! :enter)
               (recur (inc i))))
           (reset! st {:step 0 :told (told)})
           nil)))))

;; Keys, by name.
(def keys-by-name
  {:north (int \k) :south (int \j) :east (int \l) :west (int \h)
   :north-east (int \u) :north-west (int \y) :south-east (int \n) :south-west (int \b)
   :down (int \>) :up (int \<) :search (int \s) :pick-up (int \,) :eat (int \e) :wait (int \.)
   :open (int \o) :kick 4 :enter 13 :escape 27 :yes (int \y) :no (int \n) :more 13
   ;; In a menu, , selects every item on its page (Enter then takes them).
   :select-all (int \,)})

;; Keys sent for one action: rest searches 20 turns (a count, then s), stopped by the game when
;; something comes into view. An agent waited a turn at a time, hundreds of times, to heal.
(def key-runs {:rest [(int \2) (int \0) (int \s)]})

(defn act!
  "One key (a name of keys-by-name, a character or a number): whether the game ended."
  [k]
  (if-let [run (get key-runs k)]
    (last (mapv (fn [key] (cpp/play.nethack_step key)) run))
    (cpp/play.nethack_step (cond (keyword? k) (get keys-by-name k 27)
                                 (char? k) (int k)
                                 :else k))))

;; A scripted player: answers what it is asked, goes down stairs it stands on, else walks in
;; a random direction (and searches now and then).

(def directions [:north :south :east :west :north-east :north-west :south-east :south-west])

(defn scripted [s]
  (let [msg (str/lower-case (str (:message s)))]
    (cond
      (not (:normal s)) :enter
      (str/includes? msg "--more--") :more
      (str/includes? msg "[yn") :no
      (str/includes? msg "there is a staircase down here") :down
      (< (rand) 0.08) :search
      :else (rand-nth directions))))

(defonce running (atom false))

(defn play!
  "`steps` keys of `chooser` (fn [state] key, or a decision {:action :probs}; the scripted
  player by default) in the background, each shown in the card: a future, done when they
  are. (stop!) ends it; the game's end too."
  ([steps] (play! steps scripted))
  ([steps chooser]
   (reset! running true)
   (future
     (try
       (loop [i 0]
         (when (and @running (< i steps))
           (let [s (state)
                 d (chooser s)
                 k (if (map? d) (:action d) d)
                 done (act! k)]
             (reset! st (cond-> {:step (inc i) :action k :told (told) :result (when done "the game ended")}
                          (map? d) (assoc :decision d :told (:told d))))
             (cpp/usleep 60000)
             (when-not done (recur (inc i))))))
       (catch :default _ nil))
     (reset! running false)
     :done)))

(defn stop! [] (reset! running false))

;; A model playing.

(def rules
  "What a model playing NetHack is told of the game."
  (str "You play NetHack, a game in a terminal: you are the @ on the map, exploring a dungeon. "
       "Go down as deep as you can and stay alive. Walk with the direction actions (north is up "
       "the screen); walking into a monster attacks it. Letters on the map are monsters, + is a "
       "door or a spellbook, > stairs down, < stairs up, # a corridor, . floor, $ gold, ) a "
       "weapon, [ armor, % food, ! a potion, ? a scroll. When a message ends with --More--, "
       "answer more; when you are asked a question or a menu is open, answer it (yes, no, "
       "escape, or enter). Eat when you are hungry. down goes down stairs you stand on, search "
       "looks for hidden doors, pick-up picks up what is here (in its menu, select-all then enter "
       "takes everything), open opens a door next to you (a direction follows), kick kicks (a "
       "direction follows), wait waits a turn, rest rests up to 20 turns (it stops when "
       "something comes into view): HP comes back slowly, so rest when it is low and nothing is "
       "near. You can't step into or out of a door diagonally: go straight through it. ^ is a trap: don't step on one you have seen (a bear trap holds you for turns). "
       "Your pet (a little dog d, a kitten f or a pony u, by your role) starts next to you and "
       "follows you; it fights for you: don't attack it (walking into it swaps places with it)."))

(def model-actions
  [:north :south :east :west :north-east :north-west :south-east :south-west :down :up :search
   :pick-up :eat :open :kick :wait :rest :select-all :more :enter :escape :yes :no])

(defonce decisions (atom []))

(defn model-player
  "A player of NetHack for model `m` (play.decide); `settings` as decide/player's."
  ([m] (model-player m {}))
  ([m settings] (decide/player m (merge {:rules rules :actions model-actions} settings))))

(defn play-model!
  "`steps` keys chosen by `deciders` (a model-player, or a vector of them: a committee) in the
  background, each decision kept in `decisions`: a future, done when they are."
  ([deciders steps] (play-model! deciders steps {}))
  ([deciders steps opts]
   (reset! decisions [])
   (play! steps (decide/chooser deciders #'told decisions opts))))

(defn- terminal-part [] [:draw 420 (fn [x y width] (cpp/play.draw_nethack x y width 420.0))])

(defn watch!
  "NetHack's card at the top of the window: the terminal as it is played and, when a model
  plays, its side (the probabilities, its thinking, what it was told)."
  []
  (c/pin! "NetHack" st (p/decision-card (terminal-part))))

(def picture
  "The game's picture as a layout's part (for replays)."
  terminal-part)
