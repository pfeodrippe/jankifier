;; SPDX-License-Identifier: MIT
;; A game played by a harness agent (harness.core): the model's own conversation, thinking as
;; long as it likes, and tools to look at the game and act in it (one action or several in a
;; row, stopping at one that changes nothing). The far end of how close a choice is to a real
;; model step: play.decide scores one action at a time; this is the model working as it does
;; on any task. Its conversation is in the window as the harness shows any agent's
;; (harness.cards), above the game's card. Each action is kept with its place in the
;; conversation, so a replay shows the conversation as it was at each step of the game.
;;
;;   (def run (agent/play! :wnw m {:minutes 10}))   ; in the background; a future of the result
;;   (agent/stop!)                                   ; ends it (the result is kept)
(ns play.agent
  (:require [clojure.string :as str]
            [harness.cards :as hc]
            [harness.core :as h]
            [harness.tools :as harness-tools]
            [play.core :as p]
            [play.decide :as decide]
            [play.doom :as doom]
            [play.nethack :as nethack]
            [play.nova :as nova]
            [play.replay :as replay]
            [play.wnw :as wnw]))

(def games
  "What the agent plays: the game's state, how it is told (with the state before), an
  action, the actions, the rules, the card's atom, whether an action changed nothing, and
  the progress to count."
  {:wnw {:start! #'wnw/start! :state #'wnw/state :told #'wnw/told :act! #'wnw/act!
         :actions wnw/model-actions :rules wnw/rules :st #'wnw/st :watch! #'wnw/watch!
         :same? (fn [a b] (= a b))
         :progress (fn [s] {:room (inc (:room s)) :screen (:state s)})}
   :doom {:start! #'doom/start! :state #'doom/state :told #'doom/told :act! #'doom/act! :version #'doom/version
          ;; Why the game is over, or nil: the agent's run ends there.
          :over #'doom/over
          :actions doom/model-actions :rules #'doom/rules :st #'doom/st :watch! #'doom/watch!
          ;; A shot changes the ammo: only a step that changes none of these changed nothing.
          :same? (fn [a b] (= (select-keys a [:x :y :angle :health :ammo :kills :changes])
                              (select-keys b [:x :y :angle :health :ammo :kills :changes])))
          :progress (fn [s] {:kills (long (:kills s)) :health (long (:health s)) :items (long (:items s))
                             :x (long (:x s)) :y (long (:y s))})}
   :nethack {:start! #'nethack/start! :state #'nethack/state :told #'nethack/told :act! #'nethack/act!
             ;; The game ends when the character dies (or the game is quit).
             :over (fn [] (when (:done (nethack/state)) "the game ended (the character died)."))
             ;; A step onto a trap seen before is not done (an agent stepped back into a bear
             ;; trap again and again).
             :caution #'nethack/caution
             ;; Answers to the game's messages and menus don't move the @.
             :still #{:more :enter :escape :yes :no :select-all}
             :actions nethack/model-actions :rules nethack/rules :st #'nethack/st :watch! #'nethack/watch!
             ;; Walking into a wall takes no turn: the screen stays the same.
             :same? (fn [a b] (and (= (:screen a) (:screen b)) (= (:message a) (:message b))))
             :progress (fn [s] (select-keys (:stats s) [:depth :hp :hp-max :xp-level :turn :score]))}
   :nova {:start! #'nova/start! :state #'nova/state :told #'nova/told :act! #'nova/act! :version #'nova/version
          ;; A walk into a pit is not done (agents walked off into the same one, four times).
          :caution #'nova/caution
          ;; Not moving her is what these do: they don't stop the actions after them (an
          ;; attack stopped an agent's list as if it had changed nothing).
          :still #{:attack :wait :face-right :face-left}
          ;; A planned list stops when she is hurt or dies (an agent's 25 waits went on while a
          ;; GOOMBA touched her).
          :stop-when #'nova/stop-when
          :actions nova/model-actions :rules nova/rules :st #'nova/st :watch! #'nova/watch!
          :same? (fn [a b] (and (= (:x a) (:x b)) (= (:y a) (:y b))))
          :progress (fn [s] {:x (/ (long (* 10 (:x s))) 10.0) :health (:health s)})}})

(def guidance
  (str "\n\nYou play through tools. look tells you the game as it is now. act does actions "
       "in order (one, or several you have planned) and tells you what each changed and the "
       "game after them; it stops at an action that changes nothing. notes keeps your own notes "
       "apart from the conversation: keep in them where you have been, what is a dead end, what "
       "you have tried and what came of it, and read them before you choose where to go. Plan "
       "from what you are told, act, and read what changed. Keep playing: when a turn ends you "
       "are asked to go on."))

(defonce running (atom false))
(defonce current (atom nil))
(defonce steps (atom []))

(defn- last-of
  "The text of the agent's last entry of `role` (nil when none)."
  [a role]
  (:text (last (filter (fn [e] (= (:role e) role)) (:entries @a)))))

(defn- tools
  "The game's tools for an agent."
  [g]
  (let [{:keys [state told act! actions same? st]} g
        allowed (set actions)]
    [{:name "look"
      :doc "The game as it is now."
      :params {}
      :fn (fn [_] (told (state) nil))}
     {:name "act"
      :doc (str "Does actions in order and tells what each changed, then the game after them. "
                "Stops at an action that changes nothing. Actions: " (str/join ", " (map name actions)) ".")
      :params {:actions {:type "array" :doc "the actions, in order (one or more)"}}
      :fn (fn [{:keys [actions]}]
            (let [names (if (string? actions) [actions] (vec actions))
                  a (:agent (h/me))]
              (loop [left names said []]
                (if (or (empty? left) (not @running))
                  (str (str/join "\n" said) "\n\nThe game now:\n" (told (state) nil))
                  (let [k (keyword (str/trim (str (first left))))
                        ;; A game's caution: an action not done, and why (one that only harms:
                        ;; the model sent several calls in one message, each planned before
                        ;; the game said what it says now, and walked into a pit).
                        wary (when (:caution g) ((:caution g) (state) k))]
                    (cond
                      wary
                      (str (str/join "\n" (conj said (str (name k) ": not done: " wary " Stopped here.")))
                           "\n\nThe game now:\n" (told (state) nil))

                      (not (contains? allowed k))
                      (str (str/join "\n" (conj said (str (name k) ": not an action (the actions: "
                                                          (str/join ", " (map name actions)) "); stopped here.")))
                           "\n\nThe game now:\n" (told (state) nil))

                      :else
                      (let [before (state)
                            seen (told before nil)
                            _ (act! k)
                            after (state)
                            changed (first (str/split-lines (told after before)))
                            step {:action k :told seen
                                  :thinking (when a (last-of a :thinking))
                                  :said (when a (str "act " (pr-str (vec names))))
                                  :agent-step (when a (:step-count @a))
                                  ;; The version the game's actions were played with now.
                                  :version (when-let [v (:version g)] (if (var? v) @v v))
                                  ;; Where this call's entry goes in the conversation.
                                  :entry (when a (count (:entries @a)))}]
                        (swap! steps conj step)
                        (reset! @st {:step (count @steps) :action k :decision step :told (told after before)})
                        (cond
                          (and (:over g) ((:over g)))
                          (str (str/join "\n" (conj said (str (name k) ": " changed)))
                               "\n\nThe game is over: " ((:over g)) " Stopped here.")

                          (and (:stop-when g) (seq (rest left)) ((:stop-when g) before after))
                          (str (str/join "\n" (conj said (str (name k) ": " changed " Stopped here: " ((:stop-when g) before after))))
                               "\n\nThe game now:\n" (told after before))

                          (and (same? before after) (not (contains? (:still g) k)))
                          (str (str/join "\n" (conj said (str (name k) ": " changed " Stopped here: it changed nothing.")))
                               "\n\nThe game now:\n" (told after before))
                          :else
                          (recur (rest left) (conj said (str (name k) ": " changed)))))))))))}
     (harness-tools/notes)]))

(defn- playing!
  "Agent `a` playing game `game` (already where it should start) for `minutes`, in the
  background, asked `first-ask` first and to go on after: a future of the result (play!'s)."
  [game a minutes first-ask about]
  (let [g (get games game)
        began (cpp/play_decide.seconds)
        minutes-of (fn [] (/ (- (cpp/play_decide.seconds) began) 60.0))]
    (reset! running true)
    (reset! current a)
    (hc/watch! a (str (name game) " agent"))
    (future
      (try
        (loop [i 0]
          (when (and @running (< (minutes-of) minutes) (not (and (:over g) ((:over g)))))
            (h/ask! a (if (zero? i) first-ask "Go on playing: a new turn, with its own steps (the game is as you left it)."))
            ;; The turn, cut at the time, or once the game is over (a few seconds on, for the
            ;; model to read it).
            (loop [over-since nil]
              (when-not (realized? (:turn @a))
                (let [over (and (:over g) ((:over g)))
                      since (when over (or over-since (cpp/play_decide.seconds)))]
                  (if (or (not @running) (>= (minutes-of) minutes)
                          (and since (> (- (cpp/play_decide.seconds) since) 20.0)))
                    (h/stop! a)
                    (cpp/usleep 200000))
                  (recur since))))
            (h/answer a)
            (recur (inc i))))
        (catch :default _ nil))
      (reset! running false)
      (let [path (replay/save! game @steps about)
            conversation (str/replace path #"\.edn$" ".agent.edn")]
        (h/save! a conversation)
        (h/close! a)
        {:recording path :conversation conversation :actions (count @steps)
         :progress ((:progress g) ((:state g))) :minutes (/ (long (* 10 (minutes-of))) 10.0)}))))

(defn- agent-of
  "A game agent on model `m` with `opts` (play!'s)."
  [g m {:keys [effort context max-steps max-thinking temperature seed]}]
  (h/agent m {:tools (tools g)
              ;; Rules as text, or a function of none (a game whose rules depend on where it is
              ;; played: Doom's scenario).
              :system (str (let [r (:rules g)] (if (string? r) r (r))) guidance)
              :effort effort :context context
              :max-steps max-steps :max-thinking max-thinking
              :sampling {:temperature temperature :seed seed}
              ;; A game's results are its state, soon old: the summary is written from less
              ;; of them, and of the thinking, so that it is ready before the session fills.
              :summary-result-chars 400 :summary-thinking-chars 400
              ;; The recent part kept beside a summary: a few steps (the default, 20% of 64k, kept
              ;; so much that a compaction left the session nearly as full).
              :compact-keep 6000}))

(def ^:private defaults
  ;; 64k of context: a game agent adds about 6000 tokens a minute (its thinking mostly), and
  ;; in 32k its compactions, 80 seconds each, came one after another.
  {:minutes 10 :effort :medium :context 65536 :max-steps 40 :max-thinking 1200 :temperature 1.0 :seed 1})

(defn play!
  "Game `game` (a key of `games`) played from its start by a harness agent on model `m`, for
  `minutes`, in the background: a future of {:recording :conversation :actions :progress
  :minutes}. `opts`: :effort (:medium), :context (65536), :max-steps a turn (40),
  :max-thinking (1200), :temperature (1.0, as the model's publisher evaluates it: greedy
  thinking goes round in the same sentences), :seed (1)."
  [game m opts]
  (let [opts (merge defaults opts)
        g (get games game)]
    (when-let [failed ((:start! g))]
      (throw (ex-info (str "the game didn't start: " failed) {})))
    ((:watch! g))
    (reset! steps [])
    (playing! game (agent-of g m opts) (:minutes opts) "Play the game. Look first."
          (assoc (select-keys opts [:effort :minutes :temperature :seed :context]) :agent true))))

(defn resume!
  "A game an agent played (its recording's path), gone on with for `minutes` more: the game
  played again to where it was (each step with the version it was played with), and the
  agent's conversation made again (harness.core/resume!), then asked to go on. The new
  recording holds the steps before too. `opts` as play!'s (the run's own, by default)."
  [path m opts]
  (let [r (read-string (slurp path))
        game (:game r)
        g (get games game)
        opts (merge defaults (select-keys (:about r) [:effort :context :temperature :seed]) opts)
        conversation (str/replace path #"\.edn$" ".agent.edn")]
    (replay/catch-up! r)
    ((:watch! g))
    (reset! steps (vec (:steps r)))
    (let [a (agent-of g m opts)]
      (h/resume! a conversation)
      (playing! game a (:minutes opts)
            "The game was stopped and has been started again where it was: look, and go on playing."
            (assoc (select-keys opts [:effort :minutes :temperature :seed :context]) :agent true :resumed path)))))

(defn stop! [] (reset! running false))
