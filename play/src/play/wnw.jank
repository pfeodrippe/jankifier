;; SPDX-License-Identifier: MIT
;; Witch n' Wiz (a free NES puzzle platformer, built from its sources in vendor/games/): the
;; room and the players read from RAM by the addresses its build names (BUILD/labels.txt) and
;; the structs of its sources (game/main.h), the room as text, the actions a player has, and a
;; scripted player that wanders.
;;
;;   (wnw/watch!)        ; its card, at the top of the window
;;   (wnw/start!)        ; the game, through its menus into the first room
;;   (wnw/play! 200)     ; the scripted player, 200 steps, in the background
;;   (wnw/told)          ; what a model is told now
(ns play.wnw
  (:require [clojure.string :as str]
            [cards.core :as c]
            [play.core :as p]
            [play.decide :as decide]
            [play.wnw-tiles :as tiles]))

(def game (p/vendor "games" "mbh-A53-witchnwiz" "game" "BUILD" "main.nes"))

;; RAM (BUILD/labels.txt). A game_object is 17 bytes: its data (is_cur_player 0, is_wiz 2,
;; facing_left 4; or object_def 0), then alive 9, start_x_grid 11, start_y_grid 12.
(def addr {:state 0x65D :room-index 0x3DB :room 0x3DD :player1 0x551 :player2 0x562 :objects 0x575})
(def object-size 17)
(def max-objects 8)
(def states ["boot" "logo" "sound test" "menu" "menu" "new game menu" "password" "level select" "game"
             "level complete" "pause" "ending"])
(def object-names ["block" "heavy monster" "floating monster" "web" "door" "key"])
(def width 16)
(def height 15)

(defn- object-at [ram base]
  {:alive (pos? (nth ram (+ base 9)))
   :x (nth ram (+ base 11))
   :y (nth ram (+ base 12))
   :data [(nth ram base) (nth ram (+ base 2)) (nth ram (+ base 4))]})

(defn state
  "The game now, from its RAM: {:state :room :players [{:who :x :y :current :facing}]
  :objects [{:kind :x :y}] :tiles [240 tile indices]}; x and y are grid cells (16 pixels)."
  []
  (let [ram (p/nes-ram)
        players (for [k [:player1 :player2]
                      :let [o (object-at ram (get addr k))]
                      :when (:alive o)]
                  (let [[current wiz facing-left] (:data o)]
                    {:who (if (pos? wiz) "the wizard" "the witch") :x (:x o) :y (:y o)
                     :current (pos? current) :facing (if (pos? facing-left) :left :right)}))
        objects (for [i (range max-objects)
                      :let [o (object-at ram (+ (get addr :objects) (* i object-size)))]
                      :when (:alive o)]
                  {:kind (get object-names (first (:data o)) "object") :x (:x o) :y (:y o)})]
    {:state (get states (nth ram (get addr :state)) "unknown")
     :room (nth ram (get addr :room-index))
     :players (vec players)
     :objects (vec objects)
     :tiles (subvec ram (get addr :room) (+ (get addr :room) (* width height)))}))

(defn tile-char [i]
  (if (< i (count tiles/tile-chars)) (subs tiles/tile-chars i (inc i)) "?"))

(defn view
  "The room as text: @ a player, o an object, and the tiles (tools/wnw_tiles.py)."
  [st]
  (let [players (set (map (fn [pl] [(:x pl) (:y pl)]) (:players st)))
        objects (set (map (fn [o] [(:x o) (:y o)]) (:objects st)))]
    (str/join "\n"
              (for [y (range height)]
                (str/join ""
                          (for [x (range width)]
                            (cond
                              (contains? players [x y]) "@"
                              (contains? objects [x y]) "o"
                              :else (tile-char (nth (:tiles st) (+ (* y width) x))))))))))

(def tile-names
  {"." "empty" "#" "solid" "H" "a ladder" "w" "a web" "B" "a block" "c" "something to carry" "k" "a key"
   "m" "a monster" "D" "the closed door" "E" "the open door" "|" "a mirror"})

(defn- around
  "What is at and next to the player you move, as a sentence."
  [st]
  (when-let [pl (first (filter :current (:players st)))]
    (let [at (fn [dx dy]
               (let [x (+ (:x pl) dx) y (+ (:y pl) dy)]
                 (if (and (< -1 x width) (< -1 y height))
                   (get tile-names (tile-char (nth (:tiles st) (+ (* y width) x))) "something")
                   "the edge")))]
      (let [open? (fn [t] (not (contains? #{"solid" "the edge" "the closed door"} t)))
            ladder? (= "a ladder" (at 0 0))
            move (fn [label dx dy ok]
                   (str label " " (if ok
                                    (str "to (" (+ (:x pl) dx) ", " (+ (:y pl) dy) "), " (at dx dy))
                                    "does nothing")))]
        (str "Where " (:who pl) " is: " (at 0 0) (when ladder? " (up and down climb it)")
             "; left " (at -1 0) ", right " (at 1 0) ", above " (at 0 -1) ", below " (at 0 1) ".\n"
             ;; The moves by the game's rules: walking into what isn't solid; up only on a
             ;; ladder; down on a ladder or onto one.
             "Moves from here: "
             (str/join "; " [(move "left" -1 0 (open? (at -1 0)))
                             (move "right" 1 0 (open? (at 1 0)))
                             (move "up" 0 -1 (and ladder? (open? (at 0 -1))))
                             (move "down" 0 1 (or (= "a ladder" (at 0 1)) (and ladder? (open? (at 0 1)))))])
             ".\n")))))

(defn- moved
  "What changed from `before` to `st`: the players' moves, objects gone."
  [before st]
  (let [was (into {} (map (fn [pl] [(:who pl) pl]) (:players before)))
        moves (for [pl (:players st)
                    :let [b (get was (:who pl))]
                    :when (and b (or (not= (:x b) (:x pl)) (not= (:y b) (:y pl))))]
                (str (:who pl) " moved from (" (:x b) ", " (:y b) ") to (" (:x pl) ", " (:y pl) ")"))
        gone (- (count (:objects before)) (count (:objects st)))
        monsters (fn [x] (count (filter (fn [ch] (= ch "m")) (map tile-char (:tiles x)))))
        defeated (- (monsters before) (monsters st))]
    (str "Since the last action: "
         (if (seq moves) (str/join "; " moves) "nobody moved")
         (when (pos? defeated) (str "; " defeated (if (= 1 defeated) " monster" " monsters") " defeated"))
         (when (pos? gone) (str "; " gone (if (= 1 gone) " object" " objects") " gone"))
         ".\n")))

(defn runs
  "The room as runs of the same tile on a row, with their x (empty left out): a line a row."
  [st]
  (let [players (into {} (map (fn [pl] [[(:x pl) (:y pl)] (:who pl)]) (:players st)))]
    (str/join "\n"
              (for [y (range height)
                    :let [cells (for [x (range width)]
                                  [x (or (get players [x y]) (get tile-names (tile-char (nth (:tiles st) (+ (* y width) x))) "something"))])
                          groups (remove (fn [g] (= "empty" (second (first g)))) (partition-by second cells))]
                    :when (seq groups)]
                (str "y " y ": "
                     (str/join ", " (map (fn [g] (let [[x0 t] (first g) [x1 _] (last g)]
                                                   (str t (if (= x0 x1) (str " at x " x0) (str " x " x0 " to " x1)))))
                                         groups)))))))

(defonce telling
  ;; How the room is told: :grid, a character a tile; :runs, each row's things with their x.
  (atom {:map :grid}))

(defn told
  "What a model is told: where it is (and what changed since `before`, the state a step
  ago), the players, the objects, the room."
  ([] (told (state)))
  ([st] (told st nil))
  ([st before]
   (str (when before (moved before st))
        "Screen: " (:state st) ", room " (inc (:room st)) ".\n"
        (if (seq (:players st))
          (str/join "\n" (map (fn [pl] (str (str/capitalize (:who pl)) " at (" (:x pl) ", " (:y pl) "), facing "
                                            (name (:facing pl)) (when (:current pl) ", the one you move")))
                              (:players st)))
          (if (= "game" (:state st))
            "No player is in the room now (gone through the door, or lost): if the room doesn't end, undo or restart."
            ""))
        "\n"
        (around st)
        (if (seq (:objects st))
          (str "Objects: " (str/join ", " (map (fn [o] (str (:kind o) " at (" (:x o) ", " (:y o) ")")) (:objects st))) ".\n")
          "No objects.\n")
        (let [found (frequencies (map tile-char (:tiles st)))
              at (fn [ch] (for [i (range (count (:tiles st))) :when (= ch (tile-char (nth (:tiles st) i)))]
                            (str "(" (mod i width) ", " (quot i width) ")")))]
          (str (let [n (get found "m" 0)] (str n (if (= 1 n) " monster" " monsters") " left"
                                               (when (pos? n) (str ", at " (str/join ", " (at "m")))) ". "))
               (cond (seq (at "E")) (str "The door is open, at " (str/join ", " (at "E")) ": walk into it.\n")
                     (seq (at "D")) (str "The door is closed, at " (str/join ", " (at "D")) ".\n")
                     :else "\n")))
        (if (= :runs (:map @telling))
          (str "The room by row (x across, y down; empty cells left out):\n" (runs st))
          (str "The room (x across, y down; @ a player, o an object, . empty, # solid, H ladder, w web, "
               "B a block to push, c something to carry, k a key, m a monster, D the closed door, E the "
               "open door, | a mirror):\n"
               (view st))))))

;; Actions: buttons held for some frames (a move is a grid cell).

(def actions
  {:left [:left] :right [:right] :up [:up] :down [:down] :a [:a] :b [:b] :undo [:b] :restart [:select]
   :wait []})

(def step-frames 16)

(defn act-v1!
  "An action as recordings made before the 23rd of November 2026 played it (`act!` is the
  action now): the buttons held step-frames frames, released for one, and, when that took
  the last player through the door, the frames until the room ends. A move can still be
  under way after it (a move takes about 16 frames, and the position changes halfway)."
  [action]
  (p/nes-run! (get actions action []) step-frames)
  (p/nes-run! [] 1)
  (loop [i 0]
    (let [s (state)]
      (when (and (< i 60) (= "game" (:state s)) (empty? (:players s)))
        (p/nes-run! [] 1)
        (recur (inc i))))))

(def press-frames 4)

(defn act!
  "One action, finished: its buttons pressed for press-frames frames, then frames until the
  room has stayed the same for 20 of them (moves, falls and the room's end done; at most 150):
  what is told after it is what the action did."
  [action]
  (p/nes-run! (get actions action []) press-frames)
  (loop [i 0 same 0 before (state)]
    (when (and (< i 150) (< same 20))
      (p/nes-run! [] 1)
      (let [now (state)]
        (recur (inc i) (if (= now before) (inc same) 0) now)))))

;; Into the game: Start three times, Up to "new game", A twice (the first room).
(def to-room
  [[0 []] [200 [:start]] [206 []] [296 [:start]] [302 []] [392 [:start]] [398 []] [488 [:up]] [494 []]
   [584 [:a]] [590 []] [680 [:a]] [686 []] [840 []]])

(defonce st (atom {}))

(defn start!
  "The game from power-on into its first room: nil, or what went wrong."
  []
  (or (p/nes-open! game)
      (do
        (doseq [[[f ks] [next-f _]] (partition 2 1 to-room)]
          (p/nes-run! ks (- next-f f)))
        (p/nes-flush!)
        (reset! st {:step 0 :told (told)})
        nil)))

;; A scripted player: mostly across, sometimes up or down, now and then A.
(defn scripted [_]
  (let [r (rand)]
    (cond (< r 0.35) :left (< r 0.7) :right (< r 0.82) :up (< r 0.92) :down :else :a)))

(defonce running (atom false))

(defn play!
  "`steps` steps of `chooser` (fn [state] action, or a decision {:action :probs}; the scripted
  player by default) in the background, each shown in the card: a future, done when they
  are. (stop!) ends it."
  ([steps] (play! steps scripted))
  ([steps chooser]
   (reset! running true)
   (future
     (try
       (loop [i 0]
         (when (and @running (< i steps))
           (let [d (chooser (state))
                 a (if (map? d) (:action d) d)]
             (act! a)
             (reset! st (cond-> {:step (inc i) :action a :told (told)}
                          (map? d) (assoc :decision d :told (:told d))))
             (recur (inc i)))))
       (catch :default _ nil))
     (reset! running false)
     :done)))

(defn stop! [] (reset! running false))

;; A model playing.

(def rules
  "What a model playing Witch n' Wiz is told of the game (from its sources, game/PRG0.c)."
  (str "You play Witch n' Wiz, a puzzle game on the NES. A room is a grid seen from the side, "
       "16 cells across (x) and 15 down (y). You move one cell an action: left and right walk; "
       "up and down climb ladders (H), and do nothing off a ladder; with nothing under you, you "
       "fall. Each turn says which moves work from where you are. Walking into a monster "
       "(m) defeats it. Walking into a block (B) pushes it, and it falls when nothing is under "
       "it. Standing on something to carry (c, or a key k), a picks it up, and a again puts it "
       "down ahead of you; a key put into the closed door (D) opens it. When every monster is "
       "defeated the door opens (E): walk into it to finish the room. undo takes back your last "
       "action; "
       "restart starts the room again; wait does nothing. On the level complete screen, a goes "
       "on to the next room."))

(def model-actions [:left :right :up :down :a :undo :restart :wait])

(defonce decisions (atom []))

(defn model-player
  "A player of Witch n' Wiz for model `m` (play.decide); `settings` as decide/player's."
  ([m] (model-player m {}))
  ([m settings] (decide/player m (merge {:rules rules :actions model-actions} settings))))

(defn play-model!
  "`steps` steps chosen by `deciders` (a model-player, or a vector of them: a committee) in
  the background, each decision kept in `decisions`: a future, done when they are. Each
  state is told with what changed since the one before."
  ([deciders steps] (play-model! deciders steps {}))
  ([deciders steps opts]
   (reset! decisions [])
   (let [before (atom nil)
         telling (fn [s] (let [t (#'told s @before)] (reset! before s) t))]
     (play! steps (decide/chooser deciders telling decisions opts)))))

(defn watch!
  "Witch n' Wiz's card at the top of the window: the picture as it is played and, when a
  model plays, its side (the probabilities, its thinking, what it was told)."
  []
  (c/pin! "Witch n' Wiz" st (p/decision-card (p/picture-part :nes 300))))
