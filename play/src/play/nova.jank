;; SPDX-License-Identifier: MIT
;; Nova the Squirrel (a free NES platformer, built from its sources in vendor/games/): its
;; state read from RAM by the addresses its sources name (debug.dbg), the level around Nova
;; as text, the actions a player has, and a scripted player that runs right and jumps.
;;
;;   (nova/watch!)        ; its card, at the top of the window
;;   (nova/start!)        ; the game, through its menus into level 1-1
;;   (nova/play! 400)     ; the scripted player, 400 steps, in the background
;;   (nova/told)          ; what a model is told now
;;
;; A model playing (play.decide: each step, every action's probability from the model):
;;
;;   (def m (ink/open "../inkling/models/inkling-2-mini.ink"))
;;   (def player (nova/model-player m))
;;   (nova/play-model! player 200)   ; in the background; (nova/stop!) ends it
;;   @nova/decisions                 ; each step: what it was told, the probabilities, the action
(ns play.nova
  (:require [clojure.string :as str]
            [cards.core :as c]
            [play.core :as p]
            [play.decide :as decide]
            [play.nova-blocks :as blocks]))

(def game (p/vendor "games" "NovaTheSquirrel" "nova.nes"))

;; RAM, from the game's sources (src/memory.s, its addresses in debug.dbg).
(def addr {:player-x 0x26 :player-x-sub 0x25 :player-y 0x27 :player-y-sub 0x28
           :player-vx 0x29 :player-vx-sub 0x2A :player-vy 0x2B :player-vy-sub 0x2C
           :player-dir 0x43 :jumping 0x45 :on-ground 0x46 :health 0x4B
           :object-f1 0x2D :object-f2 0x463 :object-x 0x3E3 :object-y 0x403 :level 0xA7})

;; The level map is in the cartridge's RAM at $6000: 16 rows a column, a byte a block.
(def rows 16)

(defn one-place "x with one decimal, as text." [x] (str (/ (long (* (double x) 10.0)) 10.0)))

(defn- signed [hi lo]
  (+ (if (> hi 127) (- hi 256) hi) (/ lo 256.0)))

(defn state
  "The game now, from its RAM: {:x :y :vx :vy :facing :on-ground :jumping :health :level
  :objects [{:type :x :y :stunned}] :map (fn [col row] block-id)}. x and y are in blocks (16
  pixels); y grows downwards. An enemy her shot hit is stunned for a while (ObjectF2 is
  ENEMY_STATE_STUNNED, $82): it can't hurt her then (src/object.s, EnemyPlayerTouchHurt)."
  []
  (let [ram (p/nes-ram)
        cart (p/cartridge-ram)
        at (fn [k] (nth ram (get addr k)))]
    {:x (+ (at :player-x) (/ (at :player-x-sub) 256.0))
     ;; Above the level's top the byte wraps to 255: such a y is negative (an agent was told
     ;; she moved 255 blocks).
     :y (let [y (+ (at :player-y) (/ (at :player-y-sub) 256.0))] (if (>= y 128) (- y 256) y))
     :vx (signed (at :player-vx) (at :player-vx-sub))
     :vy (signed (at :player-vy) (at :player-vy-sub))
     :facing (if (zero? (at :player-dir)) :right :left)
     :on-ground (pos? (at :on-ground))
     :jumping (pos? (at :jumping))
     :health (at :health)
     :level (at :level)
     :objects (vec (for [i (range 16)
                         :let [f1 (nth ram (+ (get addr :object-f1) i))]
                         :when (pos? f1)]
                     {:type (get blocks/objects (bit-shift-right f1 1) (str "object " (bit-shift-right f1 1)))
                      :x (nth ram (+ (get addr :object-x) i))
                      :y (nth ram (+ (get addr :object-y) i))
                      :stunned (= 0x82 (nth ram (+ (get addr :object-f2) i)))}))
     ;; Outside the rows (above the top) is empty: a negative row read the column before's.
     :map (fn [col row]
            (let [i (+ (* col rows) row)]
              (if (and (>= col 0) (<= 0 row) (< row rows) (< i (count cart))) (nth cart i) 0)))}))

(defn block-char [id]
  (if (< id (count blocks/block-chars)) (subs blocks/block-chars id (inc id)) "?"))

(defn feet-row
  "The row of the level Nova's feet are in: her y is her top, and she is a block and a half
  tall (standing on row 8, her y is 6.5)."
  [st]
  (let [v (+ (:y st) 1)]
    ;; Down to the row below when above the level's top (long cuts toward zero).
    (if (neg? v) (dec (long v)) (long v))))

(defn view
  "The level around Nova as text: `before` columns behind her and `after` ahead, every row.
  N is Nova (where her feet are), e an object."
  ([st] (view st 6 18))
  ([st before after]
   (let [px (long (:x st)) py (feet-row st)
         objects (set (map (fn [o] [(:x o) (:y o)]) (:objects st)))
         from (max 0 (- px before))]
     (str/join "\n"
               (for [row (range rows)]
                 (str/join ""
                           (for [col (range from (+ px after))]
                             (cond
                               (and (= col px) (= row py)) "N"
                               (contains? objects [col row]) "e"
                               :else (block-char ((:map st) col row))))))))))

(def char-names
  {"#" "solid" "=" "ledge" "-" "platform" "H" "ladder" "D" "door" "o" "coins" "^" "spikes" "s" "spring" "?" "sign"
   "!" "prize block" "~" "water or lava" "L" "lock" "k" "key" "+" "heart" "E" "exit" "e" "object"})

(defn runs
  "The level around Nova as runs of the same thing on a row, positions relative to her (x
  right, y down; her feet at 0, 0): one line a row that has something, in the columns
  `before` behind her to `after` ahead."
  ;; 24 ahead: with 18, an agent at a wall could not see where a jump over it lands.
  ([st] (runs st 6 24))
  ([st before after]
   (let [px (long (:x st)) py (feet-row st)
         objects (set (map (fn [o] [(:x o) (:y o)]) (:objects st)))
         ch (fn [col row] (if (contains? objects [col row]) "e" (block-char ((:map st) col row))))]
     (str/join "\n"
               (for [row (range rows)
                     :let [cells (for [col (range (max 0 (- px before)) (+ px after))] [(- col px) (ch col row)])
                           groups (->> (partition-by second cells)
                                       (remove (fn [g] (= "." (second (first g))))))]
                     :when (seq groups)]
                 (str "y " (- row py)
                      ;; The two rows the agent kept working out: hers, and the one she stands on.
                      (case (- row py) 0 " (her row: the row she stands in; solid here is a wall in her way, a ledge or platform is not: she walks through it)" 1 " (under her feet: what she stands on)" "")
                      ": "
                      (str/join ", " (map (fn [g] (let [[x0 c] (first g) [x1 _] (last g)]
                                                    (str (get char-names c c) " "
                                                         (if (= x0 x1) (str "at x " x0) (str "x " x0 " to " x1)))))
                                          groups))))))))

(defonce telling
  ;; How the level is told: :grid, a character a block; :runs, runs of the same thing with
  ;; positions relative to Nova (no counting needed: an agent counting a grid's characters
  ;; spent a minute an action; with runs it went on at ten).
  (atom {:map :runs}))

(def harmless
  "Objects that don't hurt Nova (the others may: enemies, fire, shots)."
  #{"POOF" "PLAYER_PROJECTILE" "CHECKPOINT" "COLLECTIBLE" "MOVING_PLATFORM_HORIZ" "MOVING_PLATFORM_LINE"
    "MOVING_PLATFORM_PUSH" "BUDDY" "POTION" "EXPLOSION"})

(def unshootable
  "The objects Nova's shot doesn't hurt (in the game's tools/objects.txt, without GET_SHOT):
  fire, shots, cannons, falling things."
  #{"BIG_GEORGE" "ALAN" "CANNON_1" "CANNON_2" "ROCKET_LAUNCHER" "TORNADO" "BLASTER_SHOT" "FACEBALL_SHOT"
    "BOOMERANG" "FIREBALL" "FLAMES" "WATER_BOTTLE" "ICE_BLOCK" "FIREBAR" "FLYING_ARROW" "FALLING_BOMB"
    "BOULDER" "FALLING_SPIKE" "CLOUD_SWORD" "FIREWORK_SHOT" "LASER_BEAM" "BEAM_EMITTER" "FINAL_PROJECTILE"
    "SCHEME_TEAM" "TOAST" "FRY" "FRIES"})

(defn- dangers
  "The objects that may hurt Nova within 3 blocks across and 2 up or down of her: [[type dx dy] ...],
  nearest first (dy from her feet's row)."
  [st]
  (let [px (long (:x st)) py (feet-row st)]
    (->> (:objects st)
         (remove (fn [o] (or (contains? harmless (:type o)) (:stunned o))))
         (map (fn [o] [(:type o) (- (long (:x o)) px) (- (long (:y o)) py)]))
         (filter (fn [[_ dx dy]] (and (<= (max dx (- dx)) 3) (<= (max dy (- dy)) 2))))
         (sort-by (fn [[_ dx dy]] (+ (max dx (- dx)) (max dy (- dy))))))))

(defn- loaded?
  "Whether the level's map holds anything near Nova (going through a door, the new area is
  drawn over some frames: until then it is empty)."
  [st]
  (let [px (long (:x st))]
    (some (fn [c] (some (fn [row] (pos? ((:map st) c row))) (range rows))) (range (max 0 (- px 20)) (+ px 40)))))

(defn- fall?
  "Whether column `col` below the row under Nova's feet holds nothing to land on down to the
  map's bottom (empty, coins, water or lava): a fall out of the level. A drop of 6 to a floor
  read as one when only 2 to 5 blocks down were looked at."
  [st col]
  (let [py (feet-row st)]
    (every? (fn [row] (contains? #{"." "o" "~"} (block-char ((:map st) col row)))) (range (+ py 2) rows))))

(defn- fall-edge
  "How far (blocks) the edge of a fall is from Nova that way (`dir` 1 right, -1 left), when one
  starts within 8 columns: her ground stops there over 2 or more empty columns with nothing to
  land on below. nil when none."
  [st dir]
  (let [px (long (:x st)) py (feet-row st)
        at (fn [dx dy] (block-char ((:map st) (+ px dx) (+ py dy))))]
    (when-let [d (first (filter (fn [d] (and (= "." (at (* dir d) 1)) (= "." (at (* dir (inc d)) 1))
                                           (fall? st (+ px (* dir d)))))
                                (range 1 9)))]
      (if (pos? dir) (- (+ px d) (:x st)) (- (:x st) (+ (- px d) 1))))))

(defn- step-blocks
  "How far a step that way (`dir`) walks her, and a tenth more: about 0.35 blocks from rest and
  7.5 times her speed that way more (measured: 0.33 at rest, 0.75 at 0.047 a frame, 1.1 at
  0.109). A fall's edge nearer than this is walked into; jumps from about this far cleared the
  pits (from further back they fell short)."
  [st dir]
  (+ 0.45 (* 7.5 (max 0.0 (* dir (:vx st))))))

(defn- tenths [x] (/ (long (* 10 x)) 10.0))

(defn- over-fall
  "When Nova is in the air over a fall (nothing to land on below her column): the way to
  ground she can steer to, [dir blocks] (dir :right or :left), or [nil nil] when none is within
  5 columns; the way she is going first when ground is within 3 columns that way (the nearest
  was the ledge she jumped from), else the nearest. nil when she isn't over a fall."
  [st]
  (when (and (not (:on-ground st)) (fall? st (long (:x st))))
    (let [px (long (:x st))
          going (cond (> (:vx st) 0.01) :right (< (:vx st) -0.01) :left :else (:facing st))
          py (feet-row st)
          ;; Ground she can come down onto: not a fall, and open at her own row there (ground
          ;; higher than her is a wall she hits: an agent steered on toward "ground 2 blocks
          ;; right" that was a stair top above her, and fell in front of it).
          ground-at (fn [dir d] (let [col (if (= dir :right) (+ px d) (- px d))]
                                  (and (not (fall? st col))
                                       (not (contains? #{"#" "!" "L" "=" "-"} (block-char ((:map st) col py)))))))
          ahead (first (filter (fn [d] (ground-at going d)) (range 1 4)))
          nearest (first (for [d (range 1 6) dir [going (if (= going :right) :left :right)]
                               :when (ground-at dir d)]
                           [dir d]))]
      (cond ahead [going ahead]
            nearest nearest
            :else [nil nil]))))

(defn- far-rise
  "How many blocks higher than her own ground the ground across a gap on her right is: the gap
  starting at column offset `from` (its first empty column), the ground being the first
  column after it with something under her row's level or on it. 0 when level or lower.
  A short jump fell short of a far side 1 higher (it rose to 3 just behind)."
  [st from]
  (let [px (long (:x st)) py (feet-row st)
        at (fn [dx dy] (block-char ((:map st) (+ px dx) (+ py dy))))
        land (first (filter (fn [dx] (not (contains? #{"." "o" "~"} (at dx 1)))) (range from (+ from 9))))]
    (if land
      (count (take-while (fn [dy] (not (contains? #{"." "o" "~"} (at land (- dy))))) (range 0 6)))
      0)))

(defn- jump-for
  "The jump for a gap starting at offset `from`: high-jump-right when the ground across is
  higher than hers, else jump-right."
  [st from]
  (if (pos? (far-rise st from)) "high-jump-right" "jump-right"))

(defn- stairs
  "Steps up on Nova's right starting at column offset `d` (her row's solid there): the walls
  of the columns from d rise a block or two each, for 3 columns or more: [first-height
  top-height columns fall-behind?], else nil. Each is climbed with a jump onto it; a jump
  steered right in the air carried an agent past their top into the pit behind."
  [st d]
  (let [px (long (:x st)) py (feet-row st)
        at (fn [dx dy] (block-char ((:map st) (+ px dx) (+ py dy))))
        solid? (fn [ch] (contains? #{"#" "!" "L"} ch))
        height (fn [col] (count (take-while (fn [dy] (solid? (at col (- dy)))) (range 0 10))))
        hs (mapv height (range d (+ d 8)))
        n (inc (count (take-while (fn [i] (< (nth hs i) (nth hs (inc i)) (+ (nth hs i) 3))) (range 0 7))))]
    (when (and (pos? (first hs)) (>= n 3))
      [(first hs) (nth hs (dec n)) n (fall? st (+ px d n))])))

(defn- stairs-text
  "The sentence for steps up from column offset `d`."
  [[h0 top n fall-behind] d]
  (str "On her right are steps up, a column each from x " d " to x " (+ d n -1) " (" h0 " to " top
       " blocks high): climb them a step at a time, each with a jump-right on its own and no right after it"
       " (a high-jump-right for a step 2 higher than the one she is on)"
       " (rights after a jump steer her on past the step, and past the top into what is behind it)"
       (when fall-behind ", and behind the top is a fall: from the top, jump-right over it, then right in the air")
       ". "))

(defn- around
  "What is next to Nova, from the map and the objects: the dangers near her, the wall on her
  right and how high, a gap or spikes ahead on the ground, as sentences."
  [st]
  (let [px (long (:x st)) py (feet-row st)
        at (fn [dx dy] (block-char ((:map st) (+ px dx) (+ py dy))))
        solid? (fn [ch] (contains? #{"#" "!" "L"} ch))
        wall (count (take-while (fn [dy] (solid? (at 1 (- dy)))) (range 0 6)))
        gap (when (:on-ground st)
              (count (take-while (fn [dx] (= "." (at dx 1))) (range 1 6))))
        ;; A fall on her left within 4 blocks: where her ground stops (an agent backing away
        ;; from a danger walked into the pit it had jumped).
        fall-left (when (:on-ground st)
                    (first (filter (fn [dx] (and (= "." (at (- dx) 1)) (fall? st (- px dx)))) (range 1 5))))
        ;; A gap further ahead on her ground (within 8 blocks): where it starts and how wide,
        ;; and whether it has a floor below (else a fall).
        gap-ahead (when (and (:on-ground st) (not (pos? (or gap 0))))
                    (when-let [from (first (filter (fn [dx] (= "." (at dx 1))) (range 2 9)))]
                      ;; Only when no wall stands on her row before it (stairs before a pit read
                      ;; as "the ground goes on 7 blocks, then stops").
                      (when-not (some (fn [dx] (contains? #{"#" "!" "L"} (at dx 0))) (range 1 from))
                      (let [width (count (take-while (fn [dx] (= "." (at dx 1))) (range from (+ from 8))))
                            floor (not (fall? st (+ px from)))]
                        [from width floor]))))
        spikes (first (filter (fn [dx] (or (= "^" (at dx 0)) (= "^" (at dx 1)))) (range 1 5)))
        ledge (and (:on-ground st) (= "=" (at 0 1)))
        ladder (or (= "H" (at 0 0)) (= "H" (at 0 -1)))
        door (= "D" (at 0 0))
        ;; The level's end on her right: within 3 columns of the first column after which the
        ;; level's data holds nothing for 12 (walking right is blocked by the level's edge).
        empty-col? (fn [c] (every? (fn [row] (zero? ((:map st) c row))) (range rows)))
        end-col (first (filter (fn [c] (every? empty-col? (range c (+ c 12)))) (range px (+ px 40))))
        ended (and end-col (<= (- end-col px) 4) (loaded? st))
        ;; The nearest ladder or door on her row within 4 blocks, when she isn't at one.
        near (first (for [dx [1 -1 2 -2 3 -3 4 -4]
                          :let [ch (at dx 0)]
                          :when (contains? #{"H" "D"} ch)]
                      [dx ch]))]
    (str (when-not (loaded? st) "The area is still being drawn (after a door): wait a moment. ")
         (when ladder "She is at a ladder (H): up climbs it. ")
         (when door "She is at a door (D): up goes through it. ")
         (when (and near (not ladder) (not door))
           (let [[dx ch] near
                 n (max dx (- dx))]
             (str "A " (if (= ch "H") "ladder (H)" "door (D)") " is " n (if (= 1 n) " block" " blocks")
                  " to her " (if (pos? dx) "right" "left")
                  (if (= ch "H")
                    ": stand at it, then up climbs it. "
                    ": stand in it (its column), then up goes through it. "))))
         ;; In the air over a fall: an agent waited after two steers and fell in.
         (when-let [[dir d] (over-fall st)]
           (if dir
             (str "She is in the air over a fall (nothing below her): keep pressing " (name dir)
                  " to reach the ground " d (if (= 1 d) " block " " blocks ") (name dir) "; waiting drops her in. ")
             "She is in the air over a fall (nothing below her, no ground near): steer the way she was going. "))
         (when ledge "She stands on a ledge (=): down drops her through it. ")
         ;; The game takes her onto a ladder from above when down is held on its top
         ;; (src/player.s): a way down nothing told the agent of.
         (when (and (:on-ground st) (= "H" (at 0 1))) "She stands on a ladder's top (H): down climbs down it. ")
         (when (and (:on-ground st) (= "-" (at 0 1))) "She stands on a platform (-): down doesn't drop through it. ")
         (when-let [ds (seq (dangers st))]
           (str "Near her, what may hurt her when it touches her: "
                (str/join ", " (for [[t dx dy] ds]
                                 (str t (when (contains? unshootable t) " (shots don't hurt it)") " "
                                      (cond (zero? dx) "at her column"
                                            (pos? dx) (str dx (if (= 1 dx) " block" " blocks") " right")
                                            :else (str (- dx) (if (= -1 dx) " block" " blocks") " left"))
                                      (cond (zero? dy) " (her row)"
                                            (neg? dy) (str ", " (- dy) " above")
                                            :else (str ", " dy " below")))))
                ;; The advice by where the nearest is: "jump over it" for one 2 above had the
                ;; agent reasoning about it for minutes.
                (let [[t dx dy] (first ds)]
                  (cond
                    ;; One in her column at her height touches her: a GOOMBA there hurt an agent
                    ;; again and again while it shot (too close) and waited.
                    (and (zero? dx) (<= -1 dy 0))
                    (str ": it is touching her, and hurts her again and again: get away from it now (a step left, or a jump)"
                         (when-not (contains? unshootable t) ", then shoot it from 3 blocks or more (a shot stuns it)"))
                    ;; One walking on the wall ahead: up there it is on her row (an owl pacing a
                    ;; 2-high wall held agents for minutes; this play got past it in replay).
                    (and (<= dy -2) (pos? wall))
                    (str ": it is above her, on top of the wall ahead (her shot goes along her row, not up): when it is 3 or more blocks along that wall, "
                         (if (<= wall 1) "jump-right" "high-jump-right") " onto the wall, then shoot it there (up there it is on her row)")
                    (<= dy -2) ": it is above her: walk on under it (a jump would touch it), or wait for it to move"
                    (pos? dy) ": it is below her: don't drop onto it"
                    (every? (fn [[t]] (contains? unshootable t)) ds) ": jump over it or wait for it to pass"
                    :else ": jump over it, wait for it to pass, or attack it (a shot stuns it: stunned, it can't hurt her and she walks through it)"))
                ;; Only a GOOMBA is flattened by landing on it (src/enemy.s, GoombaSmoosh).
                (when (= "GOOMBA" (first (first ds))) " (landing on a GOOMBA from above flattens it)")
                ;; Her shot goes the way she faces: an agent facing away fired at nothing.
                (let [[t dx dy] (first ds)]
                  (when (and (<= -1 dy 0) (not (zero? dx)) (not (contains? unshootable t))
                             (not= (:facing st) (if (pos? dx) :right :left)))
                    (str " (her shot goes the way she faces, " (name (:facing st)) " now: face-"
                         (if (pos? dx) "right" "left") " turns her toward it where she stands)")))
                ;; A shot starts about 2 blocks ahead of her: one closer is passed over.
                (when (some (fn [[_ dx dy]] (and (<= 1 (max dx (- dx)) 2) (<= -1 dy 0))) ds)
                  " (one 1 or 2 blocks from her on her row is too close to shoot: her shot starts past it; step back first, or jump over it)")
                ". "))
         (cond
           ended "On her right the level ends: nothing is past it, and walking right is blocked. The way on is elsewhere: a door (D) or a ladder (H). "
           (and (pos? wall) (stairs st 1)) (stairs-text (stairs st 1) 1)
           (pos? wall) (str "On her right is a wall " wall (if (= 1 wall) " block" " blocks") " high: walking right is blocked; "
                            (case wall
                              1 "jump-right gets over it."
                              ;; From rest against it a jump-right rose 1.94 and fell back.
                              2 "high-jump-right gets over it (a jump-right only when she is already walking)."
                              "it is too high to jump; look for another way."))
           ;; Ground below the gap: a drop onto it, not a jump across (from a high platform an
           ;; agent jumped "a gap 5 blocks wide" and came down into a pit beyond it).
           (and gap (pos? gap) (not (fall? st (inc px))))
           (let [depth (first (filter (fn [dy] (not (contains? #{"." "o" "~"} (at 1 dy)))) (range 2 16)))]
             (str "On her right the ground stops, with ground " (dec depth) " blocks down below it: a step right drops her onto it"
                  " (the ground at her own height is " gap (if (< gap 5) "" " or more") " blocks on: "
                  (cond (<= gap 2) "jump-right gets across" (<= gap 4) "high-jump-right gets across" :else "too far to jump across") ")."))

           (and gap (pos? gap)) (str "On her right the ground stops: a gap " gap (if (= 1 gap) " block" " blocks") " wide"
                                     (let [r (far-rise st 1)] (when (pos? r) (str ", the ground across " r (if (= 1 r) " block" " blocks") " higher than hers")))
                                     ": " (jump-for st 1) " to cross it"
                                     (when (> gap 1) ", then right while in the air (a jump alone is short: wait in the air and she falls in)")
                                     ".")
           gap-ahead (let [[from width floor] gap-ahead]
                       (str "On her right the ground goes on " (dec from) (if (= 2 from) " block" " blocks")
                            ", then stops: a gap " width (if (= 1 width) " block" " blocks") " wide"
                            (if floor "" ", with no floor below (a fall)")
                            (let [edge (when-not floor (fall-edge st 1))]
                              (cond
                                (and edge (< edge (step-blocks st 1)))
                                (str ": its edge is " (tenths edge) " blocks ahead"
                                     (let [r (far-rise st from)] (when (pos? r) (str ", and the ground across is " r (if (= 1 r) " block" " blocks") " higher than hers")))
                                     ": " (jump-for st from) " from here, then right while in the air (a step right would carry her over the edge).")
                                edge
                                (str ": its edge is " (tenths edge) " blocks ahead"
                                     (let [r (far-rise st from)] (when (pos? r) (str ", and the ground across is " r (if (= 1 r) " block" " blocks") " higher than hers")))
                                     ": step right toward it (a step that would go over is not done, and said so), then " (jump-for st from)
                                     " from there, then right while in the air (jumping from further back falls short; a jump straight up falls short too).")
                                :else ": walk to its edge, then jump-right, then right while in the air to carry over it."))))
           (some (fn [[_ dx dy]] (and (< 0 dx 3) (<= (max dy (- dy)) 1))) (dangers st))
           "On her right the ground goes on, but something that hurts is in the way."
           ;; How far clear, and the wall after it: "clear" with a wall 5 blocks on read as a
           ;; contradiction to an agent.
           :else (if-let [d (first (filter (fn [dx] (solid? (at dx 0))) (range 2 13)))]
                   (if-let [up (stairs st d)]
                     (str "On her right the way is clear for " (dec d) (if (= 2 d) " block" " blocks") ". " (stairs-text up d))
                   (let [height (fn [col] (count (take-while (fn [dy] (solid? (at col (- dy)))) (range 0 8))))
                         h (height d)
                         ;; A taller wall just behind a step decides the advice (an agent read
                         ;; "1 block high" for a step in front of a lock wall 6 high).
                         taller (first (filter (fn [col] (> (height col) (max h 2))) (range (inc d) (+ d 4))))
                         top (if taller (height taller) h)]
                     (str "On her right the way is clear for " (dec d) (if (= 2 d) " block" " blocks") ", then a wall "
                          h (if (= 1 h) " block" " blocks") " high"
                          ;; Named when the map calls it something else (an agent didn't match
                          ;; the wall to the map's lock).
                          (let [c (at d 0)] (when (not= "#" c) (str " (the " (get char-names c c) " at x " d ")")))
                          (when taller (str ", and behind it at x " taller " one " top " high"))
                          ;; A low part in front of a high one can be jumped onto (a spring on it
                          ;; was the way on, which "too high: look for another way" hid).
                          (cond
                            (and taller (<= h 2)) (str " (" (if (= h 1) "jump-right" "high-jump-right") " gets her onto the low part; the one behind it is too high to jump: see what is on the low part)")
                            :else (case top 1 " (jump-right gets over it)." 2 " (high-jump-right gets over it)." " (too high to jump: look for another way).")))))
                   "On her right the way is clear."))
         (when spikes (str " Spikes " spikes (if (= 1 spikes) " block" " blocks") " to her right."))
         (when fall-left (str " On her left "
                              (if (= 1 fall-left)
                                "her ground stops right where she stands"
                                (str "the ground goes on " (dec fall-left) (if (= 2 fall-left) " block" " blocks") ", then stops"))
                              ", over a fall (no floor below): walking left goes into it.")))))

(defn caution
  "Why action `action` should not be done now (nil: it may be): a step right or left on the
  ground with a fall's edge nearer that way than a step walks (nothing to land on down to the
  map's bottom), or with a danger in her way within 3 blocks that way: she would fall in, or
  be hurt, which never helps. A drop to a floor is let be."
  [st action]
  (or
   ;; In the air over a fall, an action that doesn't steer lets her drop in (an agent waited
   ;; after two steers and fell).
   (when (contains? #{:wait :attack :down :jump} action)
     (when-let [[dir d] (over-fall st)]
       (when dir
         (str "she is in the air over a fall (nothing below her): " (name action) " lets her drop into it. Press "
              (name dir) " (ground " d (if (= 1 d) " block " " blocks ") (name dir) ") to carry over."))))
  ;; A fall's edge nearer than a step walks is walked into (an agent stepped off from a block
  ;; before the edge).
  (when-let [dir (and (:on-ground st) ({:right 1 :left -1} action))]
    (or (when-let [edge (fall-edge st dir)]
          (when (< edge (step-blocks st dir))
            (str "the ground stops " (tenths edge) " blocks on her " (name action)
                 " over a fall (no floor below): a step " (name action) " carries her into it. "
                 (if (and (= action :right) (pos? (far-rise st (inc (long edge)))))
                   "High-jump-right (the ground across is higher)"
                   (str "Jump-" (name action)))
                 " from here, then " (name action) " while in the air, to cross it.")))
        ;; A danger in her way (her row or her head's, within 3 blocks that way: enemies come
        ;; toward her): an agent at 1 health walked on into a GOOMBA 3 blocks away.
        (when-let [[t dx] (first (filter (fn [[_ dx dy]] (and (<= 1 (* dir dx) 3) (<= -1 dy 0))) (dangers st)))]
          (let [n (* dir dx)]
            (str t " is " n (if (= 1 n) " block" " blocks") " on her " (name action) ", in her way: a step " (name action)
                 " walks into it, and it hurts her. "
                 (if (contains? unshootable t)
                   "Jump over it, or wait for it to pass."
                   (str "Jump over it, or attack it (a shot stuns it" (when (<= n 2) "; this near, step back first: her shot starts past it") ").")))))))))

(defn- died?
  "Whether Nova died between `before` and `st`: her health back up while she went far back
  (the game starts that part of the level again)."
  [before st]
  (and (> (:health st) (:health before)) (< (- (:x st) (:x before)) -8.0)))

(defn stop-when
  "Why the actions planned after one that went from `before` to `st` should not be done (nil:
  they may be): she was hurt, or died (planned before, they no longer fit)."
  [before st]
  (cond
    (died? before st) "she died and starts this part again."
    (< (:health st) (:health before)) (str "she was hurt (health " (:health before) " to " (:health st) ").")))

(defn- moved
  "How far Nova went from `before` to `st`, as a sentence (or that she died and starts again)."
  [before st]
  (let [dx (- (:x st) (:x before))
        dy (- (:y st) (:y before))
        far (fn [d] (one-place (max d (- d))))
        across (when (>= (max dx (- dx)) 0.05) (str (far dx) " blocks " (if (pos? dx) "right" "left")))
        down (when (>= (max dy (- dy)) 0.05) (str (far dy) " blocks " (if (pos? dy) "down" "up")))
        parts (remove nil? [across down])]
    (cond
      ;; Health back up while she jumped far back in the same area (or another): the game
      ;; started this part again after she died.
      (died? before st)
      (str "Nova died (her health ran out, or she fell) and starts this part of the level again, "
           "her health back to " (:health st) ".\n")

      (seq parts)
      (str "Since the last action she moved " (str/join " and " parts) ".\n")

      :else "Since the last action she hasn't moved.\n")))

(defn told
  "What a model is told of the game: Nova's state (and how she moved since `before`, the
  state a step ago), what is next to her, the objects near, and the level around her
  (positions relative to her, as the map shows them)."
  ([] (told (state)))
  ([st] (told st nil))
  ([st before]
   (let [px (long (:x st)) py (feet-row st)]
     (str (when before (moved before st))
          "Nova is facing " (name (:facing st))
          (cond (:on-ground st) ", on the ground" (:jumping st) ", jumping" :else ", in the air")
          ", moving " (one-place (:vx st)) " blocks a frame across. Health " (:health st) ".\n"
          ;; An agent took a dying Nova for a game that had ended, and stopped playing.
          (when (zero? (:health st))
            "Health 0: she has died. A few waits and the game starts this part of the level again, her health back to 4.\n")
          (around st) "\n"
          (if (seq (:objects st))
            (str "Objects (blocks from her: + is right, + is down): "
                 (str/join ", " (map (fn [o] (str (:type o) (when (:stunned o) " (stunned: harmless, she can walk through it)") " at (" (- (long (:x o)) px) ", " (- (long (:y o)) py) ")")) (:objects st))) ".\n")
            "No objects near.\n")
          (if (= :runs (:map @telling))
            (str "The level around her, by row (y: blocks down from her feet, negative above; x: blocks "
                 "right of her, negative behind; empty space left out):\n"
                 (runs st))
            (str "The level around her, a character a block (N Nova, e an object, . empty, # solid, = a ledge, - a platform down doesn't drop through, "
                 "H a ladder, D a door, o coin, ^ spikes, s spring, ? sign, ! prize block, ~ water or lava, "
                 "L a lock, k a key, + a heart, E the exit); rows go down, and it shows a few columns behind "
                 "her and more ahead:\n"
                 (view st)))))))

;; Actions: buttons held for some frames.

(def actions
  "What a player can do in a step: a name and the buttons held, for `step-frames` frames."
  {:right [:right] :left [:left] :jump [:a] :jump-right [:a :right] :jump-left [:a :left]
   :down [:down] :up [:up] :attack [:b] :wait [] :face-right [:right] :face-left [:left]
   :high-jump [:a] :high-jump-right [:a :right] :high-jump-left [:a :left]})

(def step-frames 8)

(def action-frames
  "Actions held longer than step-frames: down drops through a ledge once held 8 frames
  (player.s), so it is held 12."
  {:down 12})

(defn act-v1!
  "One step as version 1 played it: the action's buttons held for its frames, then released
  for one (so a jump can be pressed again)."
  [action]
  (p/nes-run! (get actions action []) (get action-frames action step-frames))
  (p/nes-run! [] 1))

(def version
  "How act! plays an action, for replays (each agent's step says the version it was played
  with): 1 the first, 2 with up stepping to a door or ladder near her first, 3 with a door's
  new area waited for, 4 waited for until it is done changing, 5 with up at a door stopping
  her in its column first, 6 with face-right and face-left, 7 with high jumps. Raised whenever
  act! changes."
  7)

(defn- step-to!
  "Nova walked a frame at a time to the middle of column `col` (at most 40 frames)."
  [col]
  (loop [i 0]
    (let [dx (- (+ col 0.5) (:x (state)))]
      (when (and (> (max dx (- dx)) 0.25) (< i 40))
        (p/nes-run! [(if (pos? dx) :right :left)] 1)
        (recur (inc i)))))
  (p/nes-run! [] 2))

(defn- act-v2-up!
  "Up as version 2 played it: a door or a ladder within 2 blocks on her row (and none at her
  column) stepped to first."
  []
  (let [st (state)
        px (long (:x st)) py (feet-row st)
        at (fn [dx dy] (block-char ((:map st) (+ px dx) (+ py dy))))
        here (or (contains? #{"D" "H"} (at 0 0)) (= "H" (at 0 -1)))
        near (first (for [dx [1 -1 2 -2] :when (contains? #{"D" "H"} (at dx 0))] dx))]
    (when (and near (not here))
      (step-to! (+ px near))))
  (act-v1! :up))

(defn act-v2!
  "One step as version 2 played it: up stepping to a door or ladder near her first."
  [action]
  (if (= action :up) (act-v2-up!) (act-v1! action)))

(defn act-v3!
  "One step as version 3 played it: through a door, frames run until anything near her is
  drawn."
  [action]
  (if (= action :up)
    (let [level (:level (state))]
      (act-v2-up!)
      (when (not= level (:level (state)))
        (loop [i 0]
          (when (and (< i 180) (not (loaded? (state))))
            (p/nes-run! [] 1)
            (recur (inc i))))))
    (act-v1! action)))

(defn- area-now
  "The map near Nova and the objects' types, to tell when a new area is done changing."
  [st]
  (let [px (long (:x st))]
    [(vec (for [c (range (max 0 (- px 20)) (+ px 40)) r (range rows)] ((:map st) c r)))
     (mapv :type (:objects st))]))

(defn act-v4!
  "One step as version 4 played it: up at a door pressed while she may still be sliding."
  [action]
  (if (= action :up)
    (let [level (:level (state))]
      (act-v2-up!)
      (when (not= level (:level (state)))
        (loop [i 0 still 0 seen (area-now (state))]
          (when (and (< i 240) (< still 20))
            (p/nes-run! [] 1)
            (let [now (area-now (state))]
              (recur (inc i) (if (= now seen) (inc still) 0) now))))))
    (act-v1! action)))

(defn- settle!
  "Frames with no button until she stops sliding (at most 40)."
  []
  (loop [i 0]
    (let [vx (:vx (state))]
      (when (and (< i 40) (> (max vx (- vx)) 0.01))
        (p/nes-run! [] 1)
        (recur (inc i))))))

(defn- door-up!
  "Up at a door in her column or within 2 blocks on her row: she is stopped, walked to the
  middle of its column, stopped again, then up (pressed while sliding, it slid her out of the
  door's column and didn't take her through). Else up as version 2 played it (a ladder near
  her stepped to first)."
  []
  (let [st (state)
        px (long (:x st)) py (feet-row st)
        door (first (for [dx [0 1 -1 2 -2] :when (= "D" (block-char ((:map st) (+ px dx) py)))] dx))]
    (if door
      (do (settle!)
          (step-to! (+ px door))
          (settle!)
          (act-v1! :up))
      (act-v2-up!))))

(defn act-v5!
  "One step as version 5 played it: no turning in place."
  [action]
  (if (= action :up)
    (let [level (:level (state))]
      (door-up!)
      (when (not= level (:level (state)))
        (loop [i 0 still 0 seen (area-now (state))]
          (when (and (< i 240) (< still 20))
            (p/nes-run! [] 1)
            (let [now (area-now (state))]
              (recur (inc i) (if (= now seen) (inc still) 0) now))))))
    (act-v1! action)))

(defn- face!
  "Nova turned to face `dir` (:right or :left) where she stands: stopped, then the direction
  pressed for one frame (it turns her and moves her 0.008 blocks; a step to turn walked her
  into the too-close range of an owl she meant to shoot)."
  [dir]
  (settle!)
  (p/nes-run! [dir] 1)
  (p/nes-run! [] 1))

(defn act-v6!
  "One step as version 6 played it: jumps held 8 frames (cut short as she rises)."
  [action]
  (case action
    :face-right (face! :right)
    :face-left (face! :left)
    (act-v5! action)))

(defn- high-jump!
  "A full jump (`dir` :right, :left or nil): the jump button held, with the direction, until
  she stops rising (at most 40 frames), then released for one frame. Let go while she rises,
  the game cuts the jump short (src/player.s, PlayerJumpCancel): the 8-frame jumps topped out
  near 2 blocks, and an agent fell short of a higher ledge across a gap."
  [dir]
  (p/nes-run! (if dir [:a dir] [:a]) 2)
  (loop [i 2]
    (when (and (< i 40) (neg? (:vy (state))))
      (p/nes-run! (if dir [:a dir] [:a]) 1)
      (recur (inc i))))
  (p/nes-run! [] 1))

(defn act!
  "One step: the action's buttons held for its frames, then released for one (so a jump can
  be pressed again); high-jump, high-jump-right and high-jump-left hold the jump until she
  stops rising (high-jump!); face-right and face-left turn her where she stands (face!); up
  at a door in her column or within 2 blocks stops her and walks her to its middle first
  (door-up!), and up with a ladder within 2 blocks on her row steps to it first; through a
  door, frames run until the new area hasn't changed for 20 frames (at most 240)."
  [action]
  (case action
    :high-jump (high-jump! nil)
    :high-jump-right (high-jump! :right)
    :high-jump-left (high-jump! :left)
    (act-v6! action)))

;; Into the game: the menus, then level 1-1.

(def to-level
  "The frames at which buttons change, from power-on to level 1-1 (worked out with
  test/shot.cpp): Start twice, down to Level Select, A, down to Start!, A."
  [[0 []] [200 [:start]] [206 []] [300 [:start]] [306 []] [480 [:down]] [486 []] [540 [:down]] [546 []]
   [600 [:up]] [606 []] [660 [:a]] [666 []] [780 [:down]] [786 []] [840 [:a]] [846 []] [960 []]])

(defonce st (atom {}))

(defn start!
  "The game from power-on into level 1-1: nil, or what went wrong."
  []
  (or (p/nes-open! game)
      (do
        (doseq [[[f ks] [next-f _]] (partition 2 1 to-level)]
          (p/nes-run! ks (- next-f f)))
        (p/nes-flush!)
        (reset! st {:step 0 :told (told)})
        nil)))

;; A scripted player: right, and a jump when a wall, a gap or spikes are ahead.

(defn scripted
  "The action for a state: jump right when something is in the way, else right."
  [s]
  (let [px (long (:x s)) py (feet-row s)
        ahead (fn [dx dy] (block-char ((:map s) (+ px dx) (+ py dy))))
        solid? (fn [ch] (contains? #{"#" "!" "L"} ch))
        wall (or (solid? (ahead 1 0)) (solid? (ahead 1 -1)))
        gap (and (:on-ground s) (= "." (ahead 1 1)) (= "." (ahead 2 1)))
        danger (or (= "^" (ahead 1 0)) (= "^" (ahead 1 1)) (= "^" (ahead 2 1))
                   (some (fn [o] (and (<= 0 (- (:x o) px) 3) (<= (max (- (:y o) py) (- py (:y o))) 1))) (:objects s)))]
    (if (and (:on-ground s) (or wall gap danger)) :jump-right :right)))

(defonce running (atom false))

(defn- probs-said
  "A decision's probabilities, likeliest first: \"right 0.62  jump-right 0.30 ...\"."
  [probs]
  (str/join "  " (map (fn [[a q]] (str (name a) " " (/ (long (* 100 q)) 100.0)))
                      (sort-by (fn [[_ q]] (- q)) probs))))

(defn play!
  "`steps` steps of `chooser` (fn [state] action, or a decision {:action :probs}; the
  scripted player by default) in the background, each shown in the card: a future, done
  when they are. (stop!) ends it."
  ([steps] (play! steps scripted))
  ([steps chooser]
   (reset! running true)
   (future
     (try
       (loop [i 0]
         (when (and @running (< i steps))
           (let [s (state)
                 d (chooser s)
                 a (if (map? d) (:action d) d)]
             (act! a)
             (reset! st (cond-> {:step (inc i) :action a :told (told (state))}
                          (map? d) (assoc :decision d :told (:told d) :result (probs-said (:probs d)))))
             (recur (inc i)))))
       (catch :default _ (reset! running false)))
     (reset! running false)
     :done)))

;; A model playing.

(def rules
  "What a model playing Nova is told of the game."
  (str "You play Nova the Squirrel, a platform game on the NES. You move Nova, a squirrel, "
       "through a level that goes from left to right: get as far right as you can. Solid "
       "blocks stop her and she can stand on them; she falls through empty space; spikes hurt "
       "her, and so do enemies she touches. Getting right is what counts: coins and prize blocks "
       "(!) are extras, not worth much time. Each action holds the "
       "controller's buttons for a moment (8 frames): right and left walk; jump jumps straight "
       "up; jump-right and jump-left jump forward (short jumps); high-jump, high-jump-right and "
       "high-jump-left hold the jump for a full one, higher and further (for a higher ledge or a "
       "wide gap); down, standing on a ledge (=), drops her "
       "through it (not through a platform, -), and climbs down a ladder (H) she stands on; up climbs a ladder (H) she is at, or goes through a door (D); attack uses "
       "Nova's ability (the B button), shooting the way she faces; face-right and face-left turn her "
       "where she stands (to shoot without stepping closer); wait does nothing. Holding a "
       "direction while in the air steers her. When a wall is too high, look for another way: "
       "under a ledge, or back."))

(def model-actions [:right :jump-right :jump :left :jump-left :high-jump-right :high-jump :high-jump-left
                    :up :down :attack :wait :face-right :face-left])

(defonce decisions (atom []))

(defn model-player
  "A player of Nova for model `m` (play.decide); `settings` as decide/player's (:think n: it
  thinks up to n tokens before each choice). (decide/tune! player {...}) changes them while
  it plays."
  ([m] (model-player m {}))
  ([m settings] (decide/player m (merge {:rules rules :actions model-actions} settings))))

(defn play-model!
  "`steps` steps chosen by `deciders` (a model-player, or a vector of them: a committee, `opts`
  as decide/committee!'s), in the background, each decision kept in `decisions` and its
  probabilities shown in the card. `told` is called through its var: redefining it changes
  what the model is told from the next step."
  ([deciders steps] (play-model! deciders steps {}))
  ([deciders steps opts]
   (reset! decisions [])
   (let [before (atom nil)
         ;; Each state told with the one a step before it.
         telling (fn [st] (let [t (#'told st @before)] (reset! before st) t))]
     (play! steps (decide/chooser deciders telling decisions opts)))))

(defn stop! [] (reset! running false))

(defn watch!
  "Nova's card at the top of the window: the picture as it is played and, when a model
  plays, its side (the probabilities, its thinking, what it was told)."
  []
  (c/pin! "Nova the Squirrel" st (p/decision-card (p/picture-part :nes 300))))
