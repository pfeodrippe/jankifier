;; SPDX-License-Identifier: MIT
;; Doom (ViZDoom, built in vendor/ViZDoom, with Freedoom's free game data): what a model is
;; told is the player's numbers and the objects in view with how far and which way each is;
;; an action is the buttons held for some tics. A scripted player turns to what's in view and
;; shoots, else walks, turning when it is stuck, and uses doors.
;;
;;   (doom/watch!)      ; its card, at the top of the window
;;   (doom/start! 7)    ; Freedoom's MAP01, seed 7
;;   (doom/play! 300)   ; the scripted player, 300 steps, in the background
;;   (doom/told)        ; what a model is told now
(ns play.doom
  (:require [clojure.string :as str]
            [cards.core :as c]
            [harness.cards :as hc]
            [play.core :as p]
            [play.decide :as decide]))

(def engine (p/vendor "ViZDoom" "build" "bin" "vizdoom.app" "Contents" "MacOS" "vizdoom"))
(def wad (p/vendor "ViZDoom" "src" "freedoom2.wad"))

(def scenarios
  "Where Doom is played: Freedoom's MAP01, or one of ViZDoom's scenarios (made to test players:
  a goal and a time limit, in tics; picking up the goal ends the episode). Each with its skill
  (0: ViZDoom's own) and its goal as the player is told it."
  {:map01 {:map "map01" :skill 0 :timeout 0
           :title "Freedoom's first map"
           :goal "Find the way to the exit, and shoot the monsters that attack you."}
   :my-way-home {:scenario (p/vendor "ViZDoom" "scenarios" "my_way_home.wad") :map "map01" :skill 5 :timeout 2100
                 :title "a maze (ViZDoom's my_way_home)" :goal-item "GreenArmor"
                 :goal (str "Find the green armor (GreenArmor) somewhere in this maze and walk onto it: "
                            "picking it up wins. There are no monsters. You have 2100 tics (60 seconds of "
                            "game time).")}
   :deadly-corridor {:scenario (p/vendor "ViZDoom" "scenarios" "deadly_corridor.wad") :map "map01" :skill 5
                     :timeout 2100 :title "a corridor (ViZDoom's deadly_corridor)" :goal-item "GreenArmor"
                     :goal (str "Get to the green armor (GreenArmor) at the end of the corridor and walk onto "
                                "it: picking it up wins. Monsters on both sides shoot at you; at the hardest "
                                "skill a few hits kill you: kill them before you walk past them. You have 2100 "
                                "tics (60 seconds of game time).")}
   ;; The same at Doom's middle skill (ViZDoom's deadly_corridor is at the hardest: the agent died
   ;; there in 76 tics, three actions).
   :deadly-corridor-3 {:scenario (p/vendor "ViZDoom" "scenarios" "deadly_corridor.wad") :map "map01" :skill 3
                       :timeout 2100 :title "a corridor (ViZDoom's deadly_corridor, at Doom's middle skill)"
                       :goal-item "GreenArmor"
                       :goal (str "Get to the green armor (GreenArmor) at the end of the corridor and walk "
                                  "onto it: picking it up wins. Monsters on both sides shoot at you: kill them "
                                  "before you walk past them. You have 2100 tics (60 seconds of game time).")}})

(defonce chosen
  ;; The scenario start! plays (scenario! chooses it).
  (atom :map01))

(defn scenario!
  "The scenario start! plays from now on (a key of `scenarios`)."
  [k]
  (when-not (contains? scenarios k)
    (throw (ex-info (str "no Doom scenario " k) {:scenarios (keys scenarios)})))
  (reset! chosen k))


;; The buttons, as play.h orders them.
(def buttons {:forward 1 :back 2 :turn-left 4 :turn-right 8 :attack 16 :use 32 :strafe-left 64 :strafe-right 128
              :speed 256})

(def actions
  "What a player can do in a step: a name and the buttons held."
  {:forward [:forward] :back [:back] :turn-left [:turn-left] :turn-right [:turn-right]
   :attack [:attack] :use [:use] :strafe-left [:strafe-left] :strafe-right [:strafe-right]
   :forward-left [:forward :strafe-left] :forward-right [:forward :strafe-right] :wait []
   ;; Forward with the run key held, not waited out: the player keeps its speed.
   :run [:forward :speed]})

(def ^:private arcs
  ;; Versions 1 to 3: forward-left and forward-right walked while turning (an arc; the agent
  ;; took them for steps to the side and walked in circles).
  (assoc actions :forward-left [:forward :turn-left] :forward-right [:forward :turn-right]))

(def step-tics 4)

(def aimed-within
  "Degrees within which a monster is in the sights (a zombie 300 units away is about 4
  degrees across either way)."
  2.0)

(def action-tics
  "Actions held longer than step-tics (measured: walking builds up speed, 4 tics move 0 to 3
  units and 8 about 34; turning too, 8 tics turn 16 degrees and 12 about 33; the pistol fires
  once in 14 tics every time, in 8 half the time, in 16 sometimes twice)."
  {:forward 12 :back 12 :strafe-left 12 :strafe-right 12 :forward-left 12 :forward-right 12
   :turn-left 10 :turn-right 10 :attack 14 :run 12})

(defonce st (atom {}))

(defonce changes
  ;; How many uses moved something: a use can move things elsewhere while the player's own
  ;; numbers stay the same (the state says it, and play.agent's :same? reads it).
  (atom 0))

(defn state []
  (when-let [s (cpp/play.doom_state)]
    (assoc s :changes @changes)))

(def pi 3.141592653589793)

(defn- degrees [r] (* r (/ 180.0 pi)))

(defn- compass
  "Angle `a` (degrees, counterclockwise from east) as one of eight compass words."
  [a]
  (let [a (loop [a a] (cond (< a 0.0) (recur (+ a 360.0)) (>= a 360.0) (recur (- a 360.0)) :else a))]
    (nth ["east" "north-east" "north" "north-west" "west" "south-west" "south" "south-east"]
         (mod (long (/ (+ a 22.5) 45.0)) 8))))

(defn bearing
  "Where an object is from the player: [distance degrees], degrees to the left positive
  (Doom's angles grow anticlockwise)."
  [s o]
  (let [dx (- (:x o) (:x s)) dy (- (:y o) (:y s))
        to (degrees (cpp/play.atan2 dy dx))
        rel (- to (:angle s))
        rel (loop [r rel] (cond (> r 180.0) (recur (- r 360.0)) (< r -180.0) (recur (+ r 360.0)) :else r))]
    [(cpp/play.sqrt (+ (* dx dx) (* dy dy))) rel]))

;; The monsters (ViZDoom's names).
(def enemies #{"Zombieman" "ShotgunGuy" "ChaingunGuy" "DoomImp" "Demon" "Spectre" "LostSoul" "Cacodemon"
               "HellKnight" "BaronOfHell" "Arachnotron" "PainElemental" "Revenant" "Fatso" "Archvile"})

(defn- direction [a]
  (cond (< (max a (- a)) 1.0) "ahead"
        (pos? a) (str (long a) " degrees left")
        :else (str (long (- a)) " degrees right")))

(def cell
  "The side of a square of the map whose visit is kept (map units)."
  128.0)

(defonce ^:private visited
  ;; The squares of the map the player has stood in since the game started: [column row].
  (atom #{}))

(defn squares-visited
  "How many squares of the map the player has stood in."
  []
  (count @visited))

(defn- square
  "The square of the map point x, y is in."
  [x y]
  (let [down (fn [v] (let [q (long (/ v cell))] (if (and (neg? v) (not= (* q cell) v)) (dec q) q)))]
    [(down x) (down y)]))

(defn- visit!
  "The squares on the way from state `before` to state `s`, and those around them, kept as
  visited (a corridor is wider than a square: only the squares walked through left its sides
  new ground)."
  [before s]
  (let [dx (- (:x s) (:x before)) dy (- (:y s) (:y before))
        n (inc (long (/ (cpp/play.sqrt (+ (* dx dx) (* dy dy))) 32.0)))]
    (swap! visited into (for [i (range (inc n))
                              :let [[c r] (square (+ (:x before) (* dx (/ i n))) (+ (:y before) (* dy (/ i n))))]
                              oc [-1 0 1]
                              or [-1 0 1]]
                          [(+ c oc) (+ r or)]))))

(defn- new-ground?
  "Whether walking from `s` toward direction `a` (degrees, left positive) for `far` units
  (at most 512) goes through a square the player hasn't stood in."
  [s a far]
  (let [th (* (+ (:angle s) a) (/ pi 180.0))
        dx (cpp/play.cos th) dy (cpp/play.sin th)]
    (boolean (some (fn [d] (not (contains? @visited (square (+ (:x s) (* dx d)) (+ (:y s) (* dy d))))))
                   (range 48.0 (min (- far 16.0) 512.0) 32.0)))))

(defn- turns
  "How many turns face direction `a` (degrees, left positive), as words: (2 turn-left)."
  [a]
  (let [n (long (+ 0.5 (/ (max a (- a)) 30.0)))]
    (cond (zero? n) nil
          (>= (max a (- a)) 179.0) "(6 turns)"
          :else (str "(" n (if (pos? a) " turn-left" " turn-right") ")"))))

(def lifts
  "ZDoom's lift specials (Plat_...)."
  #{60 62 63 64 65 206})

(defn- ends-text
  "What ends a way, said after its distance: a door, the exit, a lift or a switch."
  [r]
  (case (:ends r)
    :door " (a closed door: use opens it within 64 units)"
    :exit " (the exit switch: use it within 64 units to finish the level)"
    :thing " (a monster, a barrel, a column or a tree in the way)"
    :switch (if (contains? lifts (:special r))
              " (a lift's edge: use it on or beside the lift within 64 units; it goes down, waits about 3 seconds, then comes up)"
              " (a switch: use presses it within 64 units)")
    nil))

(defn- exits
  "The exits and teleporters in sight (nothing of the map between: the line's middle), as
  lines; nil when none is."
  [s]
  (let [seen (for [e (cpp/play.doom_exits)
                   :when (cpp/play.doom_sees (:x e) (:y e))
                   :let [[d a] (bearing s e)]]
               [(:how e) d (str (case (:how e)
                                :walk "The exit, in sight: walk over it to finish the level, "
                                :use "The exit switch, in sight: use it to finish the level, "
                                "A teleporter, in sight: walk onto it to be carried elsewhere, ")
                              (long d) " away, " (direction a) (when-let [t (turns a)] (str " " t)) ".\n")])]
    ;; A teleporter's pad has several lines: its nearest said.
    (when (seq seen)
      (apply str (map last (concat (remove (fn [[how _ _]] (= how :teleport)) seen)
                                   (take 1 (sort-by second (filter (fn [[how _ _]] (= how :teleport)) seen)))))))))

(defn- legs
  "The way along `path` (points, from the player in state `s` on) as stretches to walk: each
  [turns distance], turns a whole number of turn-left (positive) or turn-right (negative) from
  the facing the stretch before left, points needing no turn joined into one stretch."
  [s path]
  (loop [points path at [(:x s) (:y s)] facing (:angle s) out []]
    (if (empty? points)
      out
      (let [[x y] (first points)
            [ax ay] at
            dx (- x ax) dy (- y ay)
            far (cpp/play.sqrt (+ (* dx dx) (* dy dy)))
            heading (degrees (cpp/play.atan2 dy dx))
            turn (loop [d (- heading facing)] (cond (> d 180.0) (recur (- d 360.0)) (< d -180.0) (recur (+ d 360.0)) :else d))
            k (long (cpp/play.round_half (/ turn 30.0)))]
        (if (< far 1.0)
          (recur (rest points) at facing out)
          (if (and (zero? k) (seq out))
            (recur (rest points) [x y] facing (conj (pop out) [(first (peek out)) (+ (second (peek out)) far)]))
            (recur (rest points) [x y] (+ facing (* 30.0 k)) (conj out [k far]))))))))

(defn- folded
  "Stretches (legs's) with those shorter than 32 joined into the next: their turns added, so
  that the way doesn't say to walk a few units between two turns."
  [ways]
  (loop [ways ways out []]
    (if (empty? ways)
      out
      (let [[k d] (first ways)
            more (rest ways)]
        (if (and (< d 32.0) (seq more))
          (let [[k2 d2] (first more)]
            (recur (cons [(+ k k2) (+ d d2)] (rest more)) out))
          (recur more (conj out [k d])))))))

(defn- leg-text
  "A stretch to walk ([turns distance]) as words: 2 turn-left, about 150 ahead."
  [[k far]]
  (str (cond (pos? k) (str k " turn-left, ")
             (neg? k) (str (- k) " turn-right, ")
             :else "")
       "about " (long far) " ahead"))

(defn- frontier
  "The nearest part of the map (a sector) the player hasn't stood in or been near, walking the
  map (as an automap would show it), and the way there stretch by stretch, as a line."
  [s]
  (let [path (cpp/play.doom_frontier (vec @visited) cell)]
    (if (empty? path)
      "No new ground can be walked to from here: a lift or a switch may lead on.\n"
      (let [far (long (reduce + 0.0 (map (fn [[ax ay] [bx by]]
                                           (cpp/play.sqrt (+ (* (- bx ax) (- bx ax)) (* (- by ay) (- by ay)))))
                                         (cons [(:x s) (:y s)] path) path)))
            ways (folded (legs s path))]
        (str "Nearest new ground, walking the map: about " far " away. The way there: "
             (str/join "; then " (map leg-text (take 4 ways)))
             (when (> (count ways) 4) "; and on")
             " (forward walks about 100, run about 170).\n")))))

(defn- walls
  "How far the player can walk in each direction a whole number of turns away and behind
  (cpp/play.doom_rays), and whether that way is new ground, as lines."
  [s]
  (str "Free way before a wall (new ground: you haven't been that way):\n"
       (str/join "\n" (map (fn [r] (let [a (:angle r)]
                                     (str "- " (if (>= (max a (- a)) 179.0) "behind" (direction a))
                                          (when-let [t (turns a)] (str " " t)) ": " (long (:distance r))
                                          (cond (< (:distance r) 64.0) ", a wall close by"
                                                (new-ground? s a (:distance r)) ", new ground"
                                                :else ", been there")
                                          (ends-text r))))
                           (cpp/play.doom_rays)))
       "\n"))

(defonce ^:private note
  ;; What the last action did that the state doesn't say (use: whether something opened).
  (atom nil))

(def shown-categories
  "The kinds of objects a player is told of (ViZDoom's categories): what fights, what can be
  picked up, and barrels; not decorations, trees, lights, bodies or effects."
  #{"Monster" "Ammo" "Armor" "Health" "Weapon" "Powerup" "Power" "Artifact" "Key" "Hazard"})

(def shown-at-most
  "How many objects in view a player is told of, the nearest first."
  12)

(defn- shown?
  "Whether object `o` is one a player is told of (and projectiles coming: an imp's fireball)."
  [o]
  (or (contains? shown-categories (:category o))
      (str/ends-with? (str (:name o)) "Ball")))

(defn- alive?
  "Whether object `o` is a monster that is alive (ViZDoom names a killed one Dead and its
  class: DeadZombieman)."
  [o]
  (contains? enemies (:name o)))

(defn- threats
  "The monsters alive that can see the player, the nearest first: [object distance degrees].
  Those on the screen (ViZDoom's labels: in view, so seen; not with `sight-only`, as version
  8 played), and those anywhere around within 1500 that the line of sight reaches (to their
  middle, their feet and 28: one on a ledge is seen over it)."
  ([s] (threats s false))
  ([s sight-only]
  (let [shown (if sight-only [] (for [o (:objects s) :when (alive? o) :let [[d a] (bearing s o)]] [o d a]))
        apart (fn [a b] (let [d (- a b)] (max d (- d))))
        near (fn [o p] (< (+ (apart (:x o) (:x p)) (apart (:y o) (:y p))) 48.0))
        sighted (for [o (cpp/play.doom_monsters)
                      :when (and (alive? o) (not (some (fn [[p]] (near o p)) shown)))
                      :let [[d a] (bearing s o)]
                      :when (and (< d 1500.0) (cpp/play.doom_sees_at (:x o) (:y o) (+ (:z o) 28.0)))]
                  [o d a])]
    (vec (sort-by second (concat shown sighted))))))

(defn- moved
  "How the player moved from `before` to `s`, as a sentence (and what the last action did:
  monsters killed, a door that opened)."
  [before s]
  (let [dx (- (:x s) (:x before)) dy (- (:y s) (:y before))
        far (cpp/play.sqrt (+ (* dx dx) (* dy dy)))
        turn (- (:angle s) (:angle before))
        turn (loop [r turn] (cond (> r 180.0) (recur (- r 360.0)) (< r -180.0) (recur (+ r 360.0)) :else r))]
    (str "Since the last action you "
         (if (< far 2.0) "didn't move" (str "moved " (long far)))
         (when (>= (max turn (- turn)) 1.0) (str " and turned " (direction turn)))
         (when (< (- (:health s) (:health before)) 0) (str ", and lost " (long (- (:health before) (:health s))) " health"))
         "."
         (when (< (- (:health s) (:health before)) 0)
           (let [near (take 3 (for [[o d a] (threats s)] [d a o]))]
             (when (seq near)
               (str " Monsters that can see you: "
                    (str/join "; " (for [[d a o] near]
                                     (str (:name o) " " (long d) " away, " (direction a)
                                          (when-let [t (turns a)] (str " " t)))))
                    "."))))
         (let [n (- (long (:kills s)) (long (:kills before)))]
           (when (pos? n) (str " You killed " n (if (= 1 n) " monster." " monsters."))))
         (when-let [said @note] (reset! note nil) (str " " said))
         "\n")))

(defn over
  "Why the game is over, or nil while it goes on: the player died, reached the exit (within 96
  of an exit line), or the level ended elsewhere (Doom's episode also ends on a floor that ends
  the level: in Freedoom's MAP01, one where the player stands with 10 health or less)."
  []
  (when (cpp/play.doom_finished)
    (let [s (state)
          {:keys [goal-item timeout]} (get scenarios @chosen)]
      (cond (or (cpp/play.doom_dead) (pos? (:dead s 0))) "You died."
            (and (pos? timeout) (>= (:tic s 0) timeout)) "Time ran out."
            goal-item (str "You won: you picked up the " goal-item ".")
            (some (fn [e] (< (first (bearing s e)) 96.0)) (cpp/play.doom_exits))
            "You finished the level: you reached the exit."
            :else "The level ended, but not at its exit: a floor ended it (some do when your health is 10 or less)."))))

(defn told
  "What a model is told: the player's numbers (and how it moved since `before`, the state a
  step ago), how far it can walk each way, and each object in view with its distance (map
  units; a corridor is about 128 wide) and its direction."
  ([] (told (state)))
  ([s] (told s nil))
  ([s before]
   (if-not s
     "No game."
     (str (when-let [why (over)] (str "The game is over. " why "\n"))
          (when before (moved before s))
          "Health " (long (:health s)) ", armor " (long (:armor s)) ", ammo " (long (:ammo s))
          ", kills " (long (:kills s)) ", items " (long (:items s)) (when (pos? (:dead s 0)) ", dead") ".\n"
          "At (" (long (:x s)) ", " (long (:y s)) "), facing " (long (:angle s)) " degrees (" (compass (:angle s)) ").\n"
          (walls s)
          (exits s)
          (frontier s)
          (if (seq (filter shown? (:objects s)))
            (str "In view (what fights, what can be picked up, barrels):\n"
                 (str/join "\n"
                           (for [o (take shown-at-most (sort-by (fn [o] (first (bearing s o))) (filter shown? (:objects s))))
                                 :let [[d a] (bearing s o)]]
                             (str "- " (:name o)
                                  (when (str/ends-with? (str (:name o)) "Ball") " (a fireball coming: step aside, shooting it does nothing)")
                                  (case (:category o)
                                    "Weapon" " (a weapon: walk over it to pick it up)"
                                    "Ammo" " (ammo: walk over it)"
                                    "Health" " (health: walk over it)"
                                    "Armor" " (armor: walk over it)"
                                    "Monster" " (a monster)"
                                    nil)
                                  ", " (long d) " away, "
                                  (let [enemy (alive? o)
                                        side (if (pos? a) "left" "right")]
                                    (cond (< (max a (- a)) aimed-within)
                                          (str "straight ahead" (when enemy " (in your sights)"))
                                          :else
                                          (str (long (max a (- a))) " degrees to the " side
                                               (when-let [t (turns a)] (str " " t))
                                               (when enemy " (attack turns to the nearest monster)"))))))))
            "Nothing in view.")
          (let [unseen (take 4 (filter (fn [[_ _ a]] (> (max a (- a)) 45.0)) (threats s)))]
            (when (seq unseen)
              (str "\nOut of view, monsters that can see you:\n"
                   (str/join "\n" (for [[o d a] unseen]
                                    (str "- " (:name o) ", " (long d) " away, " (direction a)
                                         (when-let [t (turns a)] (str " " t))))))))))))

(defn- nearest-enemy
  "The nearest monster in view: [object distance degrees], or nil."
  [s]
  ;; (seq first: jank's `first` of an empty sort crashes the process.)
  (first (seq (sort-by second (for [o (:objects s)
                               :when (alive? o)
                               :let [[d a] (bearing s o)]]
                           [o d a])))))

(defn start!
  "The chosen scenario (Freedoom's MAP01 unless scenario! said another) with `seed`: nil, or
  what went wrong."
  ([] (start! 1))
  ([seed]
   (let [{:keys [scenario map skill timeout]} (get scenarios @chosen)]
     (or (cpp/play.doom_open engine wad (or scenario "") map skill timeout seed 320)
       (let [s (state)]
         ;; Nothing said of a game before this one.
         (reset! note nil)
         (reset! visited #{})
         (visit! s s)
         (reset! st {:step 0 :told (told)})
         nil)))))

(defn setting
  "What a recording keeps of where it was played (the scenario)."
  []
  {:scenario @chosen})

(defn start-with!
  "The game started as a recording's `about` says (its scenario; MAP01 for those before
  scenarios)."
  [about]
  (scenario! (:scenario about :map01))
  (start!))

(defn- aim!
  "Turned toward the nearest monster a tic at a time (each turn read back: the nearest in view,
  or with `around` the nearest that can see the player, anywhere around), until it is within
  aimed-within degrees (at most 60 tics): the reward."
  [around]
  (loop [i 0 reward 0.0]
    (let [s (state)
          [_ _ a] (if around (first (seq (threats s (= around :sight)))) (nearest-enemy s))]
      (if (and a (>= (max a (- a)) aimed-within) (< i 60) (not (cpp/play.doom_finished)))
        (recur (inc i) (+ reward (cpp/play.doom_act (get buttons (if (pos? a) :turn-left :turn-right)) 1)))
        reward))))

(def turn-degrees
  "How far turn-left and turn-right turn."
  30.0)

(defn- turn!
  "Turned `degrees` (left positive) a tic at a time, the angle read back each tic (Doom's
  turning speeds up as the key is held, so tics alone don't say how far): the reward."
  [degrees]
  (let [start (:angle (state))
        turned (fn [] (let [r (- (:angle (state)) start)]
                        (loop [r r] (cond (> r 180.0) (recur (- r 360.0)) (< r -180.0) (recur (+ r 360.0)) :else r))))]
    (loop [i 0 reward 0.0]
      (let [left (- degrees (turned))]
        (if (and (>= (max left (- left)) 3.0) (< i 40) (not (cpp/play.doom_finished)))
          (recur (inc i) (+ reward (cpp/play.doom_act (get buttons (if (pos? left) :turn-left :turn-right)) 1)))
          reward)))))

(defn- what-moved
  "What a sector's change `m` ({:floor :ceiling}) looks like."
  [m]
  (cond (pos? (:ceiling m)) "a ceiling rose (a door opening)"
        (neg? (:ceiling m)) "a ceiling came down (a door closing)"
        (neg? (:floor m)) "a floor went down (a lift or a way opening)"
        :else "a floor rose"))

(defn- moved-near
  "What moved since play.doom_mark (any sector of the map whose floor or ceiling moved: a
  door, a lift), the nearest first: [[distance degrees change] ...]."
  [s]
  (vec (sort-by first (for [m (cpp/play.doom_moved)
                            :let [[d a] (bearing s m)]]
                        [d a m]))))

(defn- moved-text
  "What moved (moved-near's), as a sentence."
  [moved]
  (str "Something moved: "
       (str/join "; " (for [[d a m] (take 3 moved)]
                        (str (what-moved m) ", " (long d) " away, " (direction a)
                             (when-let [t (turns a)] (str " " t)))))
       "."))

(defn- use!
  "Use pressed, then a moment for what it sets off to move (with `lift-wait`, a lift's start
  waited for: about 3 seconds): what moved (any sector of the map whose floor or ceiling
  moved: a door, a lift), where, said in the next turn."
  [lift-wait]
  (let [ahead (fn [] (first (filter (fn [r] (zero? (long (:angle r)))) (cpp/play.doom_rays))))
        before (ahead)
        _ (cpp/play.doom_mark)
        reward (+ (cpp/play.doom_act (get buttons :use) 4) (cpp/play.doom_act 0 30))
        ;; A lift waits about 3 seconds before it moves: waited for, at most 4 seconds more.
        lift (and lift-wait before (contains? lifts (:special before)) (< (:distance before) 64.0))
        reward (+ reward (loop [i 0 r 0.0]
                           (if (or (not lift) (seq (cpp/play.doom_moved)) (>= i 14))
                             r
                             (recur (inc i) (+ r (cpp/play.doom_act 0 10))))))
        s (state)
        moved (moved-near s)
        door-ahead (and before (= :door (:ends before)) (< (:distance before) 64.0)
                        (some (fn [[d _ m]] (and (< d 192.0) (pos? (:ceiling m)))) moved))]
    (when (seq moved)
      (swap! changes inc))
    (reset! note
            (cond
              door-ahead
              "The door ahead opened."

              (seq moved)
              (moved-text moved)

              (and before (:ends before) (< (:distance before) 64.0))
              (str "You pressed it, but nothing moved yet.")
              :else
              (str "Nothing happened: use works on a door, a switch or a lift edge within 64 units straight ahead.")))
    reward))

(def version
  "How act! plays an action, for replays (each recording, and each agent's step, says the
  version it was played with): 1 the first (attack held 8 tics, turns 10), 2 with aim, 3
  with turns of a fixed angle, 4 with forward-left and forward-right stepping to the side
  instead of turning, 5 with each move waited out until the player stops, 6 with use waiting
  for a lift to start, 7 with attack not fired with no monster in view, 8 with attack turning
  to the nearest monster that can see the player, in view or not, 9 with every monster on the
  screen counting as one that can see the player. Raised whenever act! changes."
  9)

(def ^:private v1-tics
  {:forward 12 :back 12 :strafe-left 12 :strafe-right 12 :forward-left 12 :forward-right 12
   :turn-left 10 :turn-right 10 :attack 8})

(defn act-v1!
  "An action as version 1 played it: its buttons held for its tics."
  [action]
  (cpp/play.doom_act (reduce + 0 (map buttons (get arcs action []))) (get v1-tics action step-tics)))

(defn act-v2!
  "An action as version 2 played it: version 1, and aim (turned to the nearest monster)."
  [action]
  (if (= action :aim) (aim!) (act-v1! action)))

(defn- settled!
  "Tics run with no key held until the player stops (Doom's momentum carries it on after the
  keys are let go, so a step's length depended on how fast it already went), at most 40:
  the reward."
  []
  (loop [i 0 reward 0.0 still 0 s (state)]
    (if (or (>= still 2) (>= i 40) (cpp/play.doom_finished))
      reward
      (let [r (cpp/play.doom_act 0 1)
            n (state)
            dx (- (:x n) (:x s)) dy (- (:y n) (:y s))]
        (recur (inc i) (+ reward r) (if (< (+ (* dx dx) (* dy dy)) 0.25) (inc still) 0) n)))))

(defn- acted!
  "An action as act! plays it, its version's ways in `how`: :moves (the buttons of each move),
  :settle (a move waited out until the player stops), :lift-wait (use waiting for a lift),
  :hold-fire (attack not fired with no monster to shoot) and :around (attack turning to the
  nearest monster that can see the player, in view or not): the reward."
  [{:keys [moves settle lift-wait hold-fire around]} action]
  (case action
    :turn-left (turn! turn-degrees)
    :turn-right (turn! (- turn-degrees))
    :use (use! lift-wait)
    (if (and hold-fire (= action :attack)
             (not (if around (seq (threats (state) (= around :sight))) (nearest-enemy (state)))))
      (do (reset! note (if around "No monster can see you: not fired." "No monster in view: not fired."))
          0.0)
    (let [before (state)
          _ (cpp/play.doom_mark)
          aimed (if (= action :attack) (aim! around) 0.0)
          reward (+ aimed (cpp/play.doom_act (reduce + 0 (map buttons (get moves action []))) (get action-tics action step-tics)))
          reward (+ reward (if (and settle (not= action :run)) (settled!) 0.0))
          moved (moved-near (state))]
      ;; A line walked over, a shot switch: what it set off, said.
      (when (seq moved)
        (swap! changes inc)
        (reset! note (moved-text moved)))
      (visit! before (state))
      reward))))

(defn act-v3!
  "An action as version 3 played it: forward-left and forward-right walked while turning."
  [action]
  (acted! {:moves arcs} action))

(defn act-v4!
  "An action as version 4 played it: a move not waited out (the player slid on into the next
  action)."
  [action]
  (acted! {:moves actions} action))

(defn act-v5!
  "An action as version 5 played it: use not waiting for a lift to start."
  [action]
  (acted! {:moves actions :settle true} action))

(defn act-v6!
  "An action as version 6 played it: attack fired with no monster in view."
  [action]
  (acted! {:moves actions :settle true :lift-wait true} action))

(defn act-v7!
  "An action as version 7 played it: attack turning only to a monster in view."
  [action]
  (acted! {:moves actions :settle true :lift-wait true :hold-fire true} action))

(defn act-v8!
  "An action as version 8 played it: the monsters that can see the player only by the line of
  sight."
  [action]
  (acted! {:moves actions :settle true :lift-wait true :hold-fire true :around :sight} action))

(defn act!
  "One step: the action's buttons held for its tics, then a move waited out until the player
  stops; turn-left and turn-right turn turn-degrees, attack turns to the nearest monster that
  can see the player first (in view or not; with none, it doesn't fire), use says what moved;
  the reward."
  [action]
  (acted! {:moves actions :settle true :lift-wait true :hold-fire true :around true} action))

;; A scripted player.


(defonce memory (atom {:last nil :stuck 0}))

(defn- abs-diff [a b] (let [d (- a b)] (if (neg? d) (- d) d)))

(defn scripted [s]
  (let [targets (filter alive? (:objects s))
        stuck? (when-let [l (:last @memory)]
                 (< (+ (abs-diff (:x l) (:x s)) (abs-diff (:y l) (:y s))) 2.0))]
    (swap! memory (fn [m] {:last s :stuck (if stuck? (inc (:stuck m)) 0)}))
    ;; (attack turns to the nearest monster itself.)
    (if (seq targets)
      :attack
      (let [stuck (:stuck @memory)]
        (cond
          (= stuck 2) :use
          (> stuck 2) (if (even? (quot stuck 6)) :turn-left :turn-right)
          :else :forward)))))

(defonce running (atom false))

(defn play!
  "`steps` steps of `chooser` (fn [state] action, or a decision {:action :probs}; the scripted
  player by default) in the background, each shown in the card: a future, done when they
  are. (stop!) ends it; the episode's end too."
  ([steps] (play! steps scripted))
  ([steps chooser]
   (reset! running true)
   (future
     (try
       (loop [i 0]
         (when (and @running (< i steps) (not (cpp/play.doom_finished)))
           (let [s (state)
                 d (chooser s)
                 a (if (map? d) (:action d) d)
                 r (act! a)]
             (reset! st (cond-> {:step (inc i) :action a :told (told) :result (str "reward " r)}
                          (map? d) (assoc :decision d :told (:told d))))
             (recur (inc i)))))
       (reset! running false)
       :done
       (catch :default e
         (reset! running false)
         ;; What went wrong, shown in the card and returned.
         (let [why (str "failed: " (try (ex-message e) (catch :default _ nil)) " " (pr-str e))]
           (swap! st assoc :result why)
           why))))))

(defn stop! [] (reset! running false))

;; A model playing.

(defn rules
  "What a model playing Doom is told of the game (the chosen scenario's)."
  []
  (str "You play Doom (" (:title (get scenarios @chosen)) "), seen from the player's eyes. "
       (:goal (get scenarios @chosen)) " Each action holds the keys for a moment: "
       "forward and back walk (about 100 units: each move is waited out until you stop), turn-left and "
       "turn-right turn 30 degrees, forward-left and "
       "forward-right walk ahead and to the side at once, without turning, run runs ahead (about "
       "twice as far as forward, and not waited out: you keep your speed into the next action; for "
       "when time matters), strafe-left and strafe-right step sideways, attack "
       "turns to the nearest monster that can see you, in view or not, and shoots it (with none, it "
       "doesn't fire), use opens a door within 64 units straight ahead or "
       "presses a switch right in front of you, wait does nothing. Distances are in map units: "
       "the player is 32 wide, a corridor about 128. Directions: your facing is in degrees "
       "counterclockwise, 0 east (x grows) and 90 north (y grows); turn-left adds 30 to it, "
       "turn-right takes 30 away. Each direction you are told says how many turns face it. Armor "
       "takes part of each hit until it runs out; health items heal, and at 0 health you die. "
       "Game time passes only while you act. A door opened from afar (by a line walked over or a "
       "switch) closes again after about 4 seconds of game time: run to it."))

(def model-actions
  [:forward :run :turn-left :turn-right :forward-left :forward-right :back :strafe-left :strafe-right :attack
   :use :wait])

(defonce decisions (atom []))
;; The last model game's conversation (play.decide/conversation), shown above the game.
(defonce conversation (atom nil))

(defn model-player
  "A player of Doom for model `m` (play.decide); `settings` as decide/player's."
  ([m] (model-player m {}))
  ([m settings] (decide/player m (merge {:rules rules :actions model-actions} settings))))

(defn play-model!
  "`steps` steps chosen by `deciders` (a model-player, or a vector of them: a committee) in
  the background, each decision kept in `decisions`: a future, done when they are. Each
  state is told with how the player moved since the one before."
  ([deciders steps] (play-model! deciders steps {}))
  ([deciders steps opts]
   (reset! decisions [])
   (let [before (atom nil)
         telling (fn [s] (let [t (#'told s @before)] (reset! before s) t))
         conv (decide/conversation)]
     (reset! conversation conv)
     (hc/watch! conv "Doom player")
     (play! steps (decide/chooser deciders telling decisions (assoc opts :conversation conv))))))

(defn watch!
  "Doom's card at the top of the window: the picture as it is played and, when a model plays,
  its side (the probabilities, its thinking, what it was told)."
  []
  (c/pin! "Doom" st (p/decision-card (p/picture-part :doom 300))))

(defn picture "The game's picture as a layout's part (for replays)." [] (p/picture-part :doom 300))
