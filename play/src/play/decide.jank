;; SPDX-License-Identifier: MIT
;; A model choosing a game's actions (a decision API). The game is told as text, and the
;; actions it allows are named: the model's answer is scored as each action's name in turn
;; (the log-probability of its tokens and the end of the message), so it gives a
;; probability for every allowed action and can't answer anything else. The likeliest is
;; taken.
;;
;; A player's settings are in an atom read at every choice, so they can be changed while a
;; game goes on (tune!); changed rules or actions rebuild its starting session at the next
;; choice. Several players can choose together (committee!).
;;
;;   (def m (ink/open "../inkling/models/inkling-2-mini.ink"))
;;   (def p (decide/player m {:rules "..." :actions [:right :left :jump]}))
;;   (decide/choose! p "the game now, as text")   ; {:action :right :probs {...} :seconds s}
;;   (decide/tune! p {:think 300})                ; from the next choice on
(ns play.decide
  (:require [clojure.string :as str]
            [inkling.core :as ink]))

(cpp/raw "#include <chrono>
#include <cmath>
namespace play_decide
{
  inline double exp_of(double const x)
  {
    return std::exp(x);
  }

  inline double seconds()
  {
    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
  }
}")

(def defaults
  "A player's settings:
    :rules     what the game is, what the actions do, what to aim for
    :actions   the allowed actions (keywords: each one's name is how the model answers)
    :think     tokens the model may think before each choice (0: it answers at once)
    :effort    its thinking effort, as the model's publisher writes it
    :temperature  the thinking's sampling temperature
    :style     how to think, said to the model with the rules (nil: nothing said)
    :answer    :scored, the likeliest of the actions' names as the answer; or :free, the model
               writes its answer (up to 12 tokens) and the first action named in it is taken
               (none named: the likeliest, and :missed says so)
    :memory    :fresh, each choice starts from the rules; or :conversation, the choices are one
               conversation (what it was told and what it answered), started again from the
               rules when the context is nearly full
    :seed      added to the thinking's seeds (players otherwise alike think differently)
    :recent    how many of its last actions it is told
    :context   its sessions' size (taken when it is made)"
  {:rules "" :actions [] :think 0 :effort "0.2" :temperature 0.6 :style nil :answer :scored :memory :fresh
   :seed 0 :recent 6 :context 8192})


(defn- id [m piece] (ink/token-id m piece))

(defn- frame
  "A message's tokens: `role` (:system, :user) and its text, none of it special."
  [m role text]
  (vec (concat [(id m (if (= role :system) "<|message_system|>" "<|message_user|>"))
                (id m "<|content_text|>")]
               (ink/tokenize m (str text) false)
               [(id m "<|end_message|>")])))

(defn- answer-start
  "The model's message begun, its text at once (no thinking)."
  [m]
  [(id m "<|message_model|>") (id m "<|content_text|>")])

(defn- answer-ids
  "An action's name as the model's whole answer: its tokens and the message's end."
  [m action]
  (vec (concat (ink/tokenize m (name action) false) [(id m "<|end_message|>")])))

(defn- start-key
  "What a player's starting session depends on."
  [config]
  (select-keys config [:rules :actions :think :effort :style]))

(defn- start!
  "The player's starting session made again for its settings: what it is told once."
  [p config]
  (let [{:keys [model base]} p
        {:keys [rules actions think effort style]} config]
    (ink/reset! base)
    (when (pos? think)
      (ink/eval! base (frame model :system (str "Thinking effort level: " effort))))
    (ink/eval! base (frame model :system (str rules "\n\nEach turn you are told the game as it is now. "
                                              (when (pos? think) "Think briefly about what is around, then ")
                                              "Answer with the name of one action only, one of: "
                                              (str/join ", " (map name actions)) "."
                                              (when (and (pos? think) style) (str "\n\n" style)))))
    (reset! (:started p) (start-key config))))

(defn player
  "A player of a game on model `m`, with `settings` over `defaults`."
  [m settings]
  (let [config (merge defaults settings)]
    {:model m
     :config (atom config)
     :started (atom nil)
     :base (ink/session m (:context config))
     :work (ink/session m (:context config))
     :scratch (ink/session m (:context config))
     ;; Whether :work holds a conversation to go on with.
     :talking (atom false)
     :history (atom [])}))

(defn free!
  "A player's sessions let go (it can't choose after)."
  [p]
  (doseq [k [:base :work :scratch]]
    (ink/free! (get p k))))

(defn tune!
  "A player's settings changed (merged): they apply from its next choice."
  [p settings]
  (swap! (:config p) merge settings))

(defn- answer-logprob
  "The log-probability of `ids` as the next tokens of `s` (evaluated in it, but the last)."
  [s ids]
  (loop [ids ids lp 0.0]
    (if (empty? ids)
      lp
      (let [l (ink/logprob s (first ids))]
        (when (next ids)
          (ink/eval! s [(first ids)]))
        (recur (rest ids) (+ lp l))))))

(defn- thinking-start!
  "The model's message begun with its thinking, in `s`."
  [m s]
  (ink/eval! s [(id m "<|message_model|>") (id m "<|content_thinking|>")]))

(defn- thinking-end!
  "The thinking `ids` (generated in `s`) closed and the answer begun after it: {:text :tokens
  :cut} (cut: it reached its budget before it ended)."
  [m s ids]
  (let [end (id m "<|end_message|>")
        said (vec (remove #{end} ids))]
    ;; generate! leaves its end token unevaluated (and a cut thinking has none).
    (ink/eval! s (vec (concat [end] (answer-start m))))
    {:text (ink/detokenize m said) :tokens (count said) :cut (= (count said) (count ids))}))

(defn- named
  "The first of `actions` named in `text` (at the same place, the longest name): or nil."
  [actions text]
  (let [t (str/lower-case (str text))
        found (keep (fn [a] (when-let [i (str/index-of t (name a))] [i (- (count (name a))) a])) actions)]
    (when (seq found)
      (nth (first (sort found)) 2))))

(defn- free-answer!
  "The model's own answer in `s` (its message begun), up to 12 tokens: {:text :ids}, the ids
  with the message's end (evaluated in `s`)."
  [m s seed]
  (let [end (id m "<|end_message|>")
        ids (ink/generate! s 12 {:eos-token end :temperature 0.0 :seed seed})
        said (vec (remove #{end} ids))]
    (ink/eval! s [end])
    {:text (ink/detokenize m said) :ids said}))

(defn- normalized
  "Probabilities from log-probabilities: {k lp} to {k p}, over the keys."
  [scores]
  (let [best (apply max (vals scores))
        weights (into {} (map (fn [[k l]] [k (cpp/play_decide.exp_of (- l best))]) scores))
        total (reduce + (vals weights))]
    (into {} (map (fn [[k w]] [k (/ w total)]) weights))))

(defn- begin!
  "A player's turn begun: the game as `told` (with its last actions said) in its work
  session, and its thinking begun when it thinks. What the rest of the turn needs."
  [p told]
  (let [{:keys [model work history talking]} p
        config @(:config p)
        {:keys [think recent memory context]} config
        _ (when (not= @(:started p) (start-key config))
            (start! p config)
            (reset! talking false))
        began (cpp/play_decide.seconds)
        user (fn [last-actions]
               (frame model :user (str told
                                       (when (seq last-actions)
                                         (str "\nYour last actions, oldest first: "
                                              (str/join ", " (map name last-actions)) "."))
                                       "\nYour action?")))
        conversation (= memory :conversation)
        plain (when (and conversation @talking) (user nil))
        ;; Going on with the conversation when this turn fits in it (with room for the
        ;; thinking and the answer); else from the rules, told its last actions.
        go-on (and plain (< (+ (ink/position work) (count plain) think 64) (- context 256)))
        frame-ids (if go-on plain (user (take-last recent @history)))]
    (when-not go-on
      (ink/copy! work (:base p)))
    (if (pos? think)
      (do (ink/eval! work frame-ids)
          (thinking-start! model work))
      (ink/eval! work (vec (concat frame-ids (answer-start model)))))
    {:config config :began began :seed (+ (inc (count @history)) (* 1000 (:seed config)))
     :conversation conversation :go-on go-on}))

(defn- finish!
  "A player's turn ended after its thinking (`thought`, or nil): the actions scored, its
  answer, the decision."
  [p turn thought]
  (let [{:keys [model work scratch history talking]} p
        {:keys [config began seed conversation go-on]} turn
        {:keys [actions answer]} config
        probs (normalized (into {} (map (fn [a]
                                          (ink/copy! scratch work)
                                          [a (answer-logprob scratch (answer-ids model a))])
                                        actions)))
        likeliest (key (apply max-key val probs))
        said (when (= answer :free) (free-answer! model work seed))
        picked (when said (named actions (:text said)))
        action (or picked likeliest)]
    (when (and conversation (not said))
      ;; The conversation keeps the answer taken.
      (ink/eval! work (answer-ids model action)))
    (reset! talking conversation)
    (swap! history conj action)
    (cond-> {:action action :probs probs :seconds (- (cpp/play_decide.seconds) began)}
      thought (assoc :thinking (:text thought) :thought-tokens (:tokens thought) :cut (:cut thought))
      said (assoc :said (:text said) :missed (nil? picked))
      conversation (assoc :restarted (not go-on) :context-used (ink/position work)))))

(defn choose!
  "The action for the game as `told`, with its last actions said: {:action :probs {action p}
  :seconds}, and :thinking, :thought-tokens and :cut (the thinking reached its budget) when it
  thinks first. Each action's probability is its answer's (after the thinking), over the
  allowed answers."
  [p told]
  (let [{:keys [model work]} p
        turn (begin! p told)
        {:keys [think temperature]} (:config turn)
        thought (when (pos? think)
                  (thinking-end! model work
                                 (ink/generate! work think {:eos-token (id model "<|end_message|>")
                                                            :temperature temperature :seed (:seed turn)})))]
    (finish! p turn thought)))

(defn committee!
  "Several players' choices for the game as `told`, combined: :combine :mean (the mean of
  their probabilities, the default) or :vote (the most chosen; ties to the likeliest on
  average). {:action :probs :members [decision ...] :votes :seconds}. The members that think
  think together, a token each in one forward (with the first thinker's temperature). Each
  member remembers the committee's action as its last, not its own choice."
  ([players told] (committee! players told {}))
  ([players told {:keys [combine] :or {combine :mean}}]
   (let [began (cpp/play_decide.seconds)
         turns (mapv (fn [p] (begin! p told)) players)
         ;; The members that think, thinking together: one forward a token for all of them.
         thinkers (filterv (fn [i] (pos? (:think (:config (nth turns i))))) (range (count players)))
         m (:model (first players))
         thoughts (when (seq thinkers)
                    (let [ids (ink/generate-batch! (mapv (fn [i] (:work (nth players i))) thinkers)
                                                   (mapv (fn [i] (:think (:config (nth turns i)))) thinkers)
                                                   {:eos-token (id m "<|end_message|>")
                                                    :temperature (:temperature (:config (nth turns (first thinkers))))
                                                    :seeds (mapv (fn [i] (:seed (nth turns i))) thinkers)})]
                      (into {} (map (fn [i got] [i (thinking-end! m (:work (nth players i)) got)]) thinkers ids))))
         members (mapv (fn [i] (finish! (nth players i) (nth turns i) (get thoughts i))) (range (count players)))
         n (count members)
         mean (reduce (fn [acc d] (merge-with + acc (into {} (map (fn [[a q]] [a (/ q n)]) (:probs d)))))
                      {} members)
         votes (frequencies (map :action members))
         action (if (= combine :vote)
                  (key (apply max-key (fn [[a c]] (+ c (get mean a 0.0))) votes))
                  (key (apply max-key val mean)))]
     (doseq [p players]
       (swap! (:history p) (fn [h] (conj (pop h) action))))
     {:action action :probs mean :members members :votes votes
      :seconds (- (cpp/play_decide.seconds) began)})))

(defn conversation
  "A conversation the choices are shown in, as the harness shows an agent's
  (harness.cards/watch! takes it; harness.core/save! and harness.cards/replay! too): each
  choice a turn, what the model was told, its thinking, and its answer with each action's
  probability."
  []
  (atom {:entries [] :state :idle :live nil :generated 0 :seconds 0.0 :tools []
         :born (cpp/play_decide.seconds)}))

(defn- probs-text
  "The actions' probabilities, the likeliest first, those of 1% or more."
  [probs]
  (str/join ", " (map (fn [[a q]] (str (name a) " " (/ (long (* 100 q)) 100.0)))
                      (sort-by (fn [[_ q]] (- q)) (filter (fn [[_ q]] (>= q 0.01)) probs)))))

(defn- shown!
  "Decision `d` (on the game as `told`) added to conversation `conv` as a turn: the index of
  its answer's entry (where a replay's game goes past its action)."
  [conv d told]
  (let [v @conv
        now (- (cpp/play_decide.seconds) (:born v))
        began (- now (or (:seconds d) 0.0))
        step (inc (count (filter (fn [e] (= :user (:role e))) (:entries v))))
        answer (str (name (:action d))
                    "\n" (probs-text (:probs d))
                    (when-let [vs (:votes d)]
                      (str "\nvotes: " (str/join ", " (map (fn [[a c]] (str (name a) " " c)) vs))))
                    (when-let [said (:said d)] (str "\nanswered: " (str/trim said))))
        entries (cond-> [{:role :user :text (str told) :began began :ended began :step step}]
                  (:thinking d) (conj {:role :thinking :text (:thinking d) :began began :ended now :step step
                                       :cut (boolean (:cut d))})
                  true (conj {:role :model :text answer :began now :ended now :step step}))
        at (+ (count (:entries v)) (dec (count entries)))]
    (swap! conv (fn [v] (-> v
                            (update :entries into entries)
                            (assoc :state :done :step-count step)
                            (update :generated + (or (:thought-tokens d) 0))
                            (update :seconds + (or (:seconds d) 0.0)))))
    at))

(defn chooser
  "A game's chooser for its `play!`: from a state, the decision. `told` is the function that
  tells a state (pass its var, #'told, so that redefining it applies at once); `deciders` a
  player or a vector of players (a committee, `opts` as committee!'s); each decision is kept
  in `log` (an atom of a vector) with what the model was told, and, with :conversation in
  `opts` (a `conversation`), shown there as a turn (its :entry, the answer's place)."
  ([deciders told log] (chooser deciders told log {}))
  ([deciders told log opts]
   (fn [state]
     (let [t (told state)
           conv (:conversation opts)
           _ (when conv (swap! conv assoc :state :thinking))
           d (assoc (if (vector? deciders) (committee! deciders t opts) (choose! deciders t)) :told t)
           d (if conv (assoc d :entry (shown! conv d t)) d)]
       (swap! log conj d)
       d))))
