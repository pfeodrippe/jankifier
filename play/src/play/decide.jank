;; SPDX-License-Identifier: MIT
;; A model choosing a game's actions (a decision API). The game is told as text, and the
;; actions it allows are named: the model's answer is scored as each action's name in turn
;; (the log-probability of its tokens and the end of the message), so it gives a
;; probability for every allowed action and can't answer anything else. The likeliest is
;; taken.
;;
;; A player's settings are in an atom read at every choice, so they can be changed while a
;; game goes on (tune!); changed rules or actions rebuild its starting session at the next
;; choice. Several players can choose together (committee!).
;;
;;   (def m (ink/open "../inkling/models/inkling-2-mini.ink"))
;;   (def p (decide/player m {:rules "..." :actions [:right :left :jump]}))
;;   (decide/choose! p "the game now, as text")   ; {:action :right :probs {...} :seconds s}
;;   (decide/tune! p {:think 300})                ; from the next choice on
(ns play.decide
  (:require [clojure.string :as str]
            [inkling.core :as ink]))

(cpp/raw "#include <chrono>
#include <cmath>
namespace play_decide
{
  inline double exp_of(double const x)
  {
    return std::exp(x);
  }

  inline double seconds()
  {
    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
  }
}")

(def defaults
  "A player's settings:
    :rules     what the game is, what the actions do, what to aim for
    :actions   the allowed actions (keywords: each one's name is how the model answers)
    :think     tokens the model may think before each choice (0: it answers at once)
    :effort    its thinking effort, as the model's publisher writes it
    :temperature  the thinking's sampling temperature
    :style     how to think, said to the model with the rules (nil: nothing said)
    :recent    how many of its last actions it is told
    :context   its sessions' size (taken when it is made)"
  {:rules "" :actions [] :think 0 :effort "0.2" :temperature 0.6 :style nil :recent 6 :context 8192})

(def terse
  "A :style asking for short thinking: fragments, no filler, the numbers kept (after the
  caveman skill's rules, github.com/JuliusBrussee/caveman)."
  (str "Think in short fragments, one fact per line: what is near, what each action would do, "
       "the choice. No articles, filler, hedging or restating the question. Keep numbers and "
       "negations exact."))

(defn- id [m piece] (ink/token-id m piece))

(defn- frame
  "A message's tokens: `role` (:system, :user) and its text, none of it special."
  [m role text]
  (vec (concat [(id m (if (= role :system) "<|message_system|>" "<|message_user|>"))
                (id m "<|content_text|>")]
               (ink/tokenize m (str text) false)
               [(id m "<|end_message|>")])))

(defn- answer-start
  "The model's message begun, its text at once (no thinking)."
  [m]
  [(id m "<|message_model|>") (id m "<|content_text|>")])

(defn- answer-ids
  "An action's name as the model's whole answer: its tokens and the message's end."
  [m action]
  (vec (concat (ink/tokenize m (name action) false) [(id m "<|end_message|>")])))

(defn- start-key
  "What a player's starting session depends on."
  [config]
  (select-keys config [:rules :actions :think :effort :style]))

(defn- start!
  "The player's starting session made again for its settings: what it is told once."
  [p config]
  (let [{:keys [model base]} p
        {:keys [rules actions think effort style]} config]
    (ink/reset! base)
    (when (pos? think)
      (ink/eval! base (frame model :system (str "Thinking effort level: " effort))))
    (ink/eval! base (frame model :system (str rules "\n\nEach turn you are told the game as it is now. "
                                              (when (pos? think) "Think briefly about what is around, then ")
                                              "Answer with the name of one action only, one of: "
                                              (str/join ", " (map name actions)) "."
                                              (when (and (pos? think) style) (str "\n\n" style)))))
    (reset! (:started p) (start-key config))))

(defn player
  "A player of a game on model `m`, with `settings` over `defaults`."
  [m settings]
  (let [config (merge defaults settings)]
    {:model m
     :config (atom config)
     :started (atom nil)
     :base (ink/session m (:context config))
     :work (ink/session m (:context config))
     :scratch (ink/session m (:context config))
     :history (atom [])}))

(defn tune!
  "A player's settings changed (merged): they apply from its next choice."
  [p settings]
  (swap! (:config p) merge settings))

(defn- answer-logprob
  "The log-probability of `ids` as the next tokens of `s` (evaluated in it, but the last)."
  [s ids]
  (loop [ids ids lp 0.0]
    (if (empty? ids)
      lp
      (let [l (ink/logprob s (first ids))]
        (when (next ids)
          (ink/eval! s [(first ids)]))
        (recur (rest ids) (+ lp l))))))

(defn- think!
  "The model's thinking in `s`, up to `n` tokens, its message closed, and its answer begun
  after it: the thinking's text."
  [m s n temperature seed]
  (let [end (id m "<|end_message|>")
        _ (ink/eval! s [(id m "<|message_model|>") (id m "<|content_thinking|>")])
        ids (ink/generate! s n {:eos-token end :temperature temperature :seed seed})
        said (vec (remove #{end} ids))]
    ;; generate! leaves its end token unevaluated (and a cut thinking has none).
    (ink/eval! s (vec (concat [end] (answer-start m))))
    (ink/detokenize m said)))

(defn- normalized
  "Probabilities from log-probabilities: {k lp} to {k p}, over the keys."
  [scores]
  (let [best (apply max (vals scores))
        weights (into {} (map (fn [[k l]] [k (cpp/play_decide.exp_of (- l best))]) scores))
        total (reduce + (vals weights))]
    (into {} (map (fn [[k w]] [k (/ w total)]) weights))))

(defn choose!
  "The action for the game as `told`, with its last actions said: {:action :probs {action p}
  :seconds}, and :thinking when it thinks first. Each action's probability is its answer's
  (after the thinking), over the allowed answers."
  [p told]
  (let [{:keys [model work scratch history]} p
        config @(:config p)
        {:keys [actions think temperature recent]} config
        _ (when (not= @(:started p) (start-key config))
            (start! p config))
        began (cpp/play_decide.seconds)
        last-actions (take-last recent @history)
        text (str told
                  (when (seq last-actions)
                    (str "\nYour last actions, oldest first: " (str/join ", " (map name last-actions)) "."))
                  "\nYour action?")
        _ (ink/copy! work (:base p))
        thought (if (pos? think)
                  (do (ink/eval! work (frame model :user text))
                      (think! model work think temperature (inc (count @history))))
                  (do (ink/eval! work (vec (concat (frame model :user text) (answer-start model))))
                      nil))
        probs (normalized (into {} (map (fn [a]
                                          (ink/copy! scratch work)
                                          [a (answer-logprob scratch (answer-ids model a))])
                                        actions)))
        action (key (apply max-key val probs))]
    (swap! history conj action)
    (cond-> {:action action :probs probs :seconds (- (cpp/play_decide.seconds) began)}
      thought (assoc :thinking thought))))

(defn committee!
  "Several players' choices for the game as `told`, combined: :combine :mean (the mean of
  their probabilities, the default) or :vote (the most chosen; ties to the likeliest on
  average). {:action :probs :members [decision ...] :votes :seconds}. Each member remembers
  the committee's action as its last, not its own choice."
  ([players told] (committee! players told {}))
  ([players told {:keys [combine] :or {combine :mean}}]
   (let [began (cpp/play_decide.seconds)
         members (mapv (fn [p] (choose! p told)) players)
         n (count members)
         mean (reduce (fn [acc d] (merge-with + acc (into {} (map (fn [[a q]] [a (/ q n)]) (:probs d)))))
                      {} members)
         votes (frequencies (map :action members))
         action (if (= combine :vote)
                  (key (apply max-key (fn [[a c]] (+ c (get mean a 0.0))) votes))
                  (key (apply max-key val mean)))]
     (doseq [p players]
       (swap! (:history p) (fn [h] (conj (pop h) action))))
     {:action action :probs mean :members members :votes votes
      :seconds (- (cpp/play_decide.seconds) began)})))

(defn chooser
  "A game's chooser for its `play!`: from a state, the decision. `told` is the function that
  tells a state (pass its var, #'told, so that redefining it applies at once); `deciders` a
  player or a vector of players (a committee, `opts` as committee!'s); each decision is kept
  in `log` (an atom of a vector) with what the model was told."
  ([deciders told log] (chooser deciders told log {}))
  ([deciders told log opts]
   (fn [state]
     (let [t (told state)
           d (assoc (if (vector? deciders) (committee! deciders t opts) (choose! deciders t)) :told t)]
       (swap! log conj d)
       d))))
