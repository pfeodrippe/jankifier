(ns bomsom.core
  "SuperCollider's server in this process, on the audio device, driven with its own OSC
  commands (https://doc.sccode.org/Reference/Server-Command-Reference.html):

    (start!)
    (load-sine!)                                      ; the SynthDef bomsom-sine, then waits
    (send! \"/s_new\" \"bomsom-sine\" 1000 0 0 \"freq\" 330 \"amp\" 0.1)
    (send! \"/n_set\" 1000 \"freq\" 440)
    (send! \"/n_free\" 1000)
    (stop!)

  Integers go as OSC int32, other numbers as float32, strings and keywords as strings, (blob
  bytes) as a blob. The C++ in include/bomsom/server.hpp is only what the server calls on its
  own threads; the rest is here.")

(cpp/raw "#include <bomsom/server.hpp>")

;; Both kept when this namespace is reloaded: the server (its World, boxed) and the ids of
;; /sync.
(defonce ^:private world-box (atom nil))
(defonce ^:private sync-ids (atom 0))
(defonce ^:private starts (atom 0))

(defn starts-count
  "How many times the server started in this process (to tell a running server from an earlier
  one)."
  []
  @starts)

;; OSC 1.0 (https://opensoundcontrol.stanford.edu/spec-1_0.html), as vectors of byte values.

(defn- i32 [n]
  (mapv #(bit-and (bit-shift-right n %) 0xff) [24 16 8 0]))

(defn- padded [bs]
  (into bs (repeat (rem (- 4 (rem (count bs) 4)) 4) 0)))

(defn- osc-string [s]
  (padded (conj (mapv int s) 0)))

(defn blob
  "A blob argument for send!: a vector of byte values."
  [bytes]
  {::blob bytes})

(defn- osc-arg [a]
  (cond
    (integer? a) [\i (i32 a)]
    (number? a) [\f (i32 (cpp/bomsom.float_bits (double a)))]
    (keyword? a) [\s (osc-string (name a))]
    (::blob a) [\b (padded (into (i32 (count (::blob a))) (::blob a)))]
    :else [\s (osc-string (str a))]))

(defn osc-message
  "An OSC message's bytes."
  [address args]
  (let [encoded (mapv osc-arg args)]
    (-> (osc-string address)
        (into (osc-string (apply str \, (map first encoded))))
        (into (mapcat second encoded)))))

(defn- read-osc-string [bs i]
  (let [end (loop [j i] (if (zero? (nth bs j)) j (recur (inc j))))]
    [(apply str (map char (subvec bs i end)))
     (+ i (* 4 (inc (quot (- end i) 4))))]))

(defn- read-i32 [bs i]
  (let [u (reduce #(bit-or (bit-shift-left %1 8) %2) 0 (subvec bs i (+ i 4)))]
    (if (>= u 0x80000000) (- u 0x100000000) u)))

(defn decode-osc
  "An OSC message's bytes as [address & args]."
  [bs]
  (let [[address i] (read-osc-string bs 0)]
    (if (or (>= i (count bs)) (not= 44 (nth bs i)))
      [address]
      (let [[tags i] (read-osc-string bs i)]
        (loop [out [address]
               i i
               tags (rest tags)]
          (if-let [t (first tags)]
            (case t
              \i (recur (conj out (read-i32 bs i)) (+ i 4) (rest tags))
              \f (recur (conj out (cpp/bomsom.float_from_bits (read-i32 bs i))) (+ i 4) (rest tags))
              \d (recur (conj out (cpp/bomsom.double_from_bits (read-i32 bs i) (read-i32 bs (+ i 4))))
                        (+ i 8) (rest tags))
              \s (let [[s j] (read-osc-string bs i)]
                   (recur (conj out s) j (rest tags)))
              \b (let [n (read-i32 bs i)]
                   (recur (conj out (blob (subvec bs (+ i 4) (+ i 4 n))))
                          (+ i 4 (* 4 (quot (+ n 3) 4)))
                          (rest tags)))
              (conj out (keyword (str "unknown-type-" t))))
            out))))))

;; The server.

(defn running? []
  (some? @world-box))

;; A jank function can't return the World* itself, so each use unboxes it.
(defn- check-running! []
  (when-not (running?)
    (throw (ex-info "the server isn't running: (start!)" {}))))

(declare record! stop-recording!)

(defn start!
  "Starts the server: 2 outputs, no inputs (so macOS doesn't ask for the microphone),
  supercollider-sys's plugins. Options: :device, the output device's name (\"BlackHole 16ch\"),
  else the default one; :udp-port, so that OSC clients such as sclang can talk to it too;
  :record, a WAV file to record everything it plays into (record!). BOMSOM_DEVICE and
  BOMSOM_RECORD in the environment do the same (for a video's take)."
  ([] (start! {}))
  ([{:keys [device udp-port record]}]
   (if (running?)
     :already-running
     (let [device (or device (not-empty (cpp/bomsom.env "BOMSOM_DEVICE")))
           record (or record (not-empty (cpp/bomsom.env "BOMSOM_RECORD")))
           options (cpp/WorldOptions.)
           _ (cpp/= (.-mUGensPluginPath options) cpp/bomsom.plugin_dir)
           _ (cpp/= (.-mLoadGraphDefs options) 0)
           _ (cpp/= (.-mNumInputBusChannels options) 0)
           _ (cpp/= (.-mNumOutputBusChannels options) 2)
           ;; Both names, as scsynth's -H sets them: SC's driver compares each device's name
           ;; with the input device's too (strcmp of a null pointer without it). No inputs
           ;; are opened either way.
           _ (when device
               (let [name (cpp/bomsom.out_device_name device)
                     _ (cpp/= (.-mOutDeviceName options) name)
                     _ (cpp/= (.-mInDeviceName options) name)]
                 nil))
           _ (cpp/bomsom.forget)
           _ (cpp/SetPrintFunc cpp/bomsom.on_print)
           w (cpp/World_New (cpp/& options))]
       (when (cpp/== w cpp/nullptr)
         (throw (ex-info "the server didn't start: (log!) has what it printed" {:device device})))
       (reset! world-box (cpp/box w))
       (swap! starts inc)
       (when (and udp-port (pos? udp-port)
                  (not (cpp/World_OpenUDP w (.c_str (cpp/std.string "127.0.0.1")) udp-port)))
         (throw (ex-info "the UDP port didn't open" {:udp-port udp-port})))
       (when record
         (record! record))
       :started))))

(defn stop! []
  (when (running?)
    (stop-recording!)
    (let [box @world-box]
      ;; What reads the server's memory on another thread (a window's cards, every frame)
      ;; looks at world-box first: it's emptied, a frame or two goes by, then the memory goes.
      (reset! world-box nil)
      (cpp/bomsom.sleep_ms 200)
      ;; The plugins stay loaded: World_New loads them once a process (SC_World.cpp's
      ;; gLibInitted), so a server started after unloading them would have no UGens.
      (cpp/World_Cleanup (cpp/unbox (:* World) box) false)))
  :stopped)

(defn server-box
  "The server's World* in a box (cpp/unbox (:* World) it), nil when it isn't running: for
  reading its memory (buses, buffers, counts), as the cards do."
  []
  @world-box)

(defn- send-packet! [bs quiet?]
  (check-running!)
  (let [w (cpp/unbox (:* World) @world-box)
        v (#cpp (std.vector char))]
    (doseq [b bs]
      (.push_back v (cpp/cast cpp/int b)))
    (or (if quiet?
          (cpp/World_SendPacket w (cpp/cast cpp/int (.size v)) (.data v) cpp/bomsom.on_quiet_reply)
          (cpp/World_SendPacket w (cpp/cast cpp/int (.size v)) (.data v) cpp/bomsom.on_reply))
        (throw (ex-info "the server refused the packet" {})))
    nil))

(defn send-bytes!
  "Sends an OSC packet's bytes to the server."
  [bs]
  (send-packet! bs false))

(defn send!
  "Sends one OSC message to the server: its address, then its arguments."
  [address & args]
  (send-bytes! (osc-message address args)))

(defn send-quiet!
  "Sends a message whose reply isn't the REPL's: only the newest reply of each address is kept,
  for latest-reply, and replies! doesn't see it (a monitor's /status every quarter second)."
  [address & args]
  (send-packet! (osc-message address args) true))

(defn sleep! [ms]
  (cpp/bomsom.sleep_ms ms))

(defn sync!
  "Waits until the server has done everything sent before (SynthDefs loaded, buffers read)."
  ([] (sync! 5000))
  ([timeout-ms]
   (let [id (swap! sync-ids inc)]
     (send! "/sync" id)
     (or (cpp/bomsom.wait_synced id timeout-ms)
         (throw (ex-info "no /synced from the server" {:timeout-ms timeout-ms}))))))

(defn- take-reply []
  (let [v (#cpp (std.vector char))]
    (when (cpp/bomsom.next_reply v)
      (let [p (.data v)]
        (loop [i 0
               out (transient [])]
          (if (< i (.size v))
            (recur (inc i) (conj! out (bit-and (cpp/cast cpp/int (cpp/aget p (cpp/cast cpp/long i))) 0xff)))
            (persistent! out)))))))

(defn replies!
  "The server's replies since the last call, each as [address & args]."
  []
  (loop [out []]
    (if-let [bs (take-reply)]
      (recur (conj out (decode-osc bs)))
      out)))

(defn latest-reply
  "The newest reply with this address to a send-quiet!, as [address & args], or nil."
  [address]
  (let [v (#cpp (std.vector char))]
    (when (cpp/bomsom.latest_reply address v)
      (let [p (.data v)]
        (loop [i 0
               out (transient [])]
          (if (< i (.size v))
            (recur (inc i) (conj! out (bit-and (cpp/cast cpp/int (cpp/aget p (cpp/cast cpp/long i))) 0xff)))
            (decode-osc (persistent! out))))))))

;; The synths playing, from the server's node tree (/g_queryTree with their controls).

(defn- read-node
  "A node of /g_queryTree.reply's arguments at `i` (its id, its children's count, then a synth's
  SynthDef and controls, or a group's children): [the synths in it, where the next node is]."
  [args i]
  (let [id (nth args i)
        children (nth args (inc i))]
    (if (= -1 children)
      (let [synthdef (nth args (+ i 2))
            n (nth args (+ i 3))
            controls (into {}
                           (for [j (range n)
                                 :let [k (nth args (+ i 4 (* 2 j)))]]
                             [(if (string? k) (keyword k) k) (nth args (+ i 5 (* 2 j)))]))]
        [[{:id id :synthdef synthdef :controls controls}] (+ i 4 (* 2 n))])
      (loop [j 0
             at (+ i 2)
             out []]
        (if (< j children)
          (let [[synths next] (read-node args at)]
            (recur (inc j) next (into out synths)))
          [out at])))))

(defn tree-synths
  "The synths in a /g_queryTree.reply asked with its controls (flag 1), in the tree's order:
  [{:id :synthdef :controls {name value}}], a control's name a keyword (its index when it has
  none). A control mapped to a bus has the bus as its value (\"c1\", \"a2\")."
  [reply]
  (first (read-node (vec (drop 2 reply)) 0)))

(defn synths
  "The synths playing now, with their controls: [{:id :synthdef :controls {name value}}]. It asks
  the server quietly (replies! doesn't see it) and waits for the answer."
  []
  (send-quiet! "/g_queryTree" 0 1)
  (sync!)
  (when-let [reply (latest-reply "/g_queryTree.reply")]
    (tree-synths reply)))

(defn controls
  "A synth's controls now, {:name value} ({:freq 220.0 :amp 0.1}), or nil when there's no such
  synth (it ended)."
  [id]
  (some (fn [s] (when (= id (:id s)) (:controls s))) (synths)))

(defn log!
  "What the server printed since the last call (also printed on the process's stdout)."
  []
  (loop [out []]
    (let [s (cpp/bomsom.next_log)]
      (if (= "" s) out (recur (conj out s))))))

;; SynthDefs: SuperCollider's file format, version 2
;; (https://doc.sccode.org/Reference/Synth-Definition-File-Format.html).

(defn- i16 [n] [(bit-and (bit-shift-right n 8) 0xff) (bit-and n 0xff)])
(defn- f32 [x] (i32 (cpp/bomsom.float_bits (double x))))
(defn- pstring [s] (into [(count s)] (map int s)))

(def ^:private rates {:scalar 0 :control 1 :audio 2})

(defn synthdef-bytes
  "A SynthDef's bytes, from {:name :constants :controls :ugens}: :controls is
  [[name initial-value] ...], and each UGen is {:name :rate :inputs :outputs :special}, an
  input [ugen-index output-index] or [:const constant-index], an output its rate."
  [{:keys [name constants controls ugens]}]
  (vec (concat (map int "SCgf") (i32 2) (i16 1) (pstring name)
               (i32 (count constants)) (mapcat f32 constants)
               (i32 (count controls)) (mapcat (comp f32 second) controls)
               (i32 (count controls)) (mapcat (fn [[n _] i] (concat (pstring n) (i32 i))) controls (range))
               (i32 (count ugens))
               (mapcat (fn [{:keys [rate inputs outputs special] :as ugen}]
                         (concat (pstring (:name ugen)) [(rates rate)] (i32 (count inputs))
                                 (i32 (count outputs)) (i16 (or special 0))
                                 (mapcat (fn [[from i]] (concat (i32 (if (= :const from) -1 from)) (i32 i))) inputs)
                                 (map rates outputs)))
                       ugens)
               (i16 0))))

(def sine
  "Out.ar(0, [s, s]) with s = SinOsc.ar(freq) * amp."
  {:name "bomsom-sine"
   :constants [0.0]
   :controls [["freq" 440.0] ["amp" 0.1]]
   :ugens [{:name "Control" :rate :control :inputs [] :outputs [:control :control]}
           {:name "SinOsc" :rate :audio :inputs [[0 0] [:const 0]] :outputs [:audio]}
           ;; BinaryOpUGen's special index says which operator: 2 is *.
           {:name "BinaryOpUGen" :rate :audio :special 2 :inputs [[1 0] [0 1]] :outputs [:audio]}
           {:name "Out" :rate :audio :inputs [[:const 0] [2 0] [2 0]] :outputs []}]})

(defn load-synthdef!
  "Sends a SynthDef (as data) to the server and waits until it's loaded."
  [synthdef]
  (send! "/d_recv" (blob (synthdef-bytes synthdef)))
  (sync!))

(defn load-sine!
  "Loads the SynthDef bomsom-sine (controls freq and amp) and waits for it."
  []
  (load-synthdef! sine))

(comment
  (start!)
  (load-sine!)

  ;; Node 1000, at the head of group 0.
  (send! "/s_new" "bomsom-sine" 1000 0 0 "freq" 330 "amp" 0.1)
  (send! "/n_set" 1000 "freq" 440)
  (send! "/n_set" 1000 "amp" 0.05)
  (send! "/n_free" 1000)

  ;; Sonic Pi's beep (MIDI notes); -1 lets the server choose the node's id.
  (send! "/d_load" "/Users/pfeodrippe/dev/vybe/sonic-pi/etc/synthdefs/compiled/sonic-pi-beep.scsyndef")
  (sync!)
  (send! "/s_new" "sonic-pi-beep" -1 0 0 "note" 60 "release" 1)
  (doseq [n [60 64 67 72]]
    (send! "/s_new" "sonic-pi-beep" -1 0 0 "note" n "release" 0.5)
    (cpp/bomsom.sleep_ms 250))

  (send! "/status")
  (sync!)
  (replies!)
  (log!)

  (stop!))

;; Recording what the server plays: a synth at the end of the root group writes the output
;; buses to a WAV file as they're played (DiskOut, through a buffer).

(def ^:private record-buffer 1022)
(def ^:private recorder-node 1999998)
(defonce ^:private recording (atom nil))

(def recorder
  "DiskOut.ar(buf, In.ar(0, 2))."
  {:name "bomsom-recorder"
   :constants [0.0]
   :controls [["buf" 0.0]]
   :ugens [{:name "Control" :rate :control :inputs [] :outputs [:control]}
           {:name "In" :rate :audio :inputs [[:const 0]] :outputs [:audio :audio]}
           {:name "DiskOut" :rate :audio :inputs [[0 0] [1 0] [1 1]] :outputs [:audio]}]})

(defn record!
  "Records everything the server plays (its 2 outputs) into a WAV file of floats, from now
  until stop-recording! or stop!. The wall-clock time it started (ms since 1970) goes to
  <path>.start and to stderr (`[bomsom] recording <ms>`), to align it with a video."
  [path]
  (stop-recording!)
  (send! "/b_alloc" record-buffer 65536 2)
  (sync!)
  (send! "/b_write" record-buffer (str path) "wav" "float" 0 0 1)
  (load-synthdef! recorder)
  (send! "/s_new" "bomsom-recorder" recorder-node 1 0 "buf" record-buffer)
  (let [ms (cpp/bomsom.now_ms)]
    ;; Its start also in <path>.start: an evaluation's stderr goes to the REPL, not to a log.
    (spit (str path ".start") (str ms))
    (cpp/bomsom.say (str "recording " ms " " path)))
  (reset! recording (str path)))

(defn stop-recording!
  "Ends the recording, closing its file."
  []
  (when-let [path @recording]
    (reset! recording nil)
    (when (running?)
      (send! "/n_free" recorder-node)
      (send! "/b_close" record-buffer)
      (send! "/b_free" record-buffer)
      (sync!))
    path))

(defn -main
  "Starts the server, plays an A for a second and stops: a check that it all works here.
  `lein run` plays it at amp 0.1; `lein run 0` is silent."
  [& [amp]]
  (println (start!))
  (load-sine!)
  (send! "/s_new" "bomsom-sine" 1000 0 0 "freq" 440 "amp" (if amp (parse-double amp) 0.1))
  (send! "/status")
  (sync!)
  ;; /status.reply: unused, UGens, synths, groups, SynthDefs, CPU average and peak, rates.
  (doseq [r (replies!)] (prn r))
  (cpp/bomsom.sleep_ms 1000)
  (send! "/n_free" 1000)
  (sync!)
  (println (stop!)))
