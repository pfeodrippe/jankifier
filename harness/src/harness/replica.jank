;; SPDX-License-Identifier: MIT
;; A team of agents on one model for replicating code in Lean and checking it against a
;; specification written apart (ELLE.md): a coordinator, who compares the two and writes the
;; report, and two workers it asks: the translator writes the translation, the specifier the
;; specification, without reading the translation (a specification that follows the code
;; can't disagree with it). As in harness.team, each worker is an agent of its own, and asked
;; together (ask_both) they work at the same time, their tokens batched by the engine.
;;
;;   (def t (replica/team m {:system (str tools/situation "\n\n" (slurp "ELLE.md"))}))
;;   (h/ask! (:coordinator t) "the task")
;;   (h/answer (:coordinator t))
(ns harness.replica
  (:require [clojure.string :as str]
            [harness.core :as h]
            [harness.tools :as tools]))

(defn- asked
  "What agent `a` answers to `text` (it works until its turn ends)."
  [a text]
  (h/ask! a text)
  (or (h/answer a)
      (str "(It ended its turn without an answer: " (name (:state @a)) ".)")))

(defn- roles
  "The workers' and the coordinator's own parts of the system text."
  [{:keys [translation spec report]}]
  {:translator (str "\n\nYou are the translator of a team of three agents on one task. You write the "
                    "translation in " translation ": the Clojure function by function, as it is "
                    "written, including whatever looks wrong. Build it often. The specifier writes "
                    "the specification in " spec ", and the coordinator tells you what to do. Answer "
                    "with what you did and what the coordinator should know.")
   :specifier (str "\n\nYou are the specifier of a team of three agents on one task. You write the "
                   "specification in " spec ", from the definitions the guide gives, not from the "
                   "code: do not read " translation " (a specification that follows the translation "
                   "can't find where the code goes wrong). Build it often. The coordinator tells you "
                   "what to do. Answer with what you did and what the coordinator should know.")
   :coordinator (str "\n\nYou coordinate a team of two agents on this task: the translator writes "
                     translation " and the specifier writes " spec ". Hand the work out at once: ask "
                     "both (ask_both asks them together, and they work at the same time), each with "
                     "what the guide asks of its file. Then compare the two on many small histories "
                     "(you write the comparison and build it with the shell tool), send each worker "
                     "what you find wrong in its part, and write " report ". Your turn ends only "
                     "once the project builds and " report " exists.")})

(defn- built
  "nil when the Lean project in `dir` builds and `report` exists, else what isn't so."
  [dir report]
  (let [ran (cpp/harness.run (str "cd " dir " && \"$LAKE\" build 2>&1 | tail -30") 200000 900.0)
        out (str (:out ran))]
    (cond
      (or (not (zero? (:exit ran))) (str/includes? out "error:"))
      (str "The project doesn't build yet:\n" out)
      (not (cpp/harness.is_file (str report)))
      (str "There is no " report " yet: write what the comparison found there.")
      :else nil)))

(defn team
  "A team on model `m`: {:coordinator :translator :specifier}, three agents. `opts`: :system
  (the text all three are told first), :agent (harness.core/agent's options for all three),
  :files ({:translation :spec :report :dir}, the paths ELLE.md names), :coordinator-effort and
  :worker-max-tokens as harness.team takes them."
  [m {:keys [system agent files coordinator-effort worker-max-tokens]
      :or {coordinator-effort :medium worker-max-tokens 24576}}]
  (let [parts (roles files)
        base (merge agent {:draft nil})
        worker (merge base {:max-tokens worker-max-tokens})
        worker-tools (tools/defaults)
        translator (h/agent m (merge worker {:tools worker-tools :system (str system (:translator parts))}))
        specifier (h/agent m (merge worker {:tools worker-tools :system (str system (:specifier parts))}))
        defaults (tools/defaults)
        ;; The coordinator's own tools work once it has handed the work out: with the shell and
        ;; the files it read Elle's code itself for fourteen steps while both workers waited.
        handed (atom false)
        pick (fn [n] (when-let [t (some (fn [t] (when (= (:name t) n) t)) defaults)]
                       (update t :fn (fn [f]
                                       (fn [args]
                                         (if @handed
                                           (f args)
                                           (str "Hand the work out first, with ask_both: reading Elle's code "
                                                "and writing the translation and the specification are the "
                                                "workers' work. This tool works once they have it.")))))))
        asks [{:name "ask_translator"
               :doc "Asks the translator (it writes the translation) and gives its answer, once it has worked."
               :params {:text {:type "string" :doc "what the translator should do"}}
               :fn (fn [{:keys [text]}] (reset! handed true) (asked translator text))}
              {:name "ask_specifier"
               :doc "Asks the specifier (it writes the specification) and gives its answer, once it has worked."
               :params {:text {:type "string" :doc "what the specifier should do"}}
               :fn (fn [{:keys [text]}] (reset! handed true) (asked specifier text))}
              {:name "ask_both"
               :doc "Asks the translator and the specifier at once (they work at the same time) and gives both answers."
               :params {:translator {:type "string" :doc "what the translator should do"}
                        :specifier {:type "string" :doc "what the specifier should do"}}
               :fn (fn [args]
                     (reset! handed true)
                     (h/ask! translator (:translator args))
                     (h/ask! specifier (:specifier args))
                     (str "The translator answered:\n" (or (h/answer translator) "(nothing)")
                          "\n\nThe specifier answered:\n" (or (h/answer specifier) "(nothing)")))}]
        coordinator (h/agent m (merge base
                                      {:effort coordinator-effort
                                       :tools (vec (concat asks
                                                           (keep pick ["read_file" "list_dir" "write_file"
                                                                       "edit_file" "shell"])))
                                       :system (str system (:coordinator parts))
                                       :obligations (fn [_] (built (:dir files) (:report files)))}))]
    {:coordinator coordinator :translator translator :specifier specifier}))

(defn close!
  "The team's agents' sessions freed."
  [t]
  (doseq [k [:coordinator :translator :specifier]]
    (h/close! (get t k))))
