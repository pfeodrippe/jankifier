;; SPDX-License-Identifier: MIT
;; The default tools: ordinary functions, each wrapped as a tool (harness.core/wrap). A call's
;; arguments reach them as plain values: the text of a file to write is the text itself.
;;
;; `evaluate` is the one that reaches everything: it runs code in this process's own nREPL,
;; as an evaluation from an editor would be, so the code sees the engine, the session it is
;; being asked from (harness.core/me), and this harness.
;;
;; None of these is confined to a directory, and nothing is asked before they act.
(ns harness.tools
  (:refer-clojure :exclude [load-file])
  (:require [clojure.string :as str]
            [harness.core :as h]
            ;; The process's eval operation, on a large stack and safe for evaluations at the
            ;; same time (the window library's, which needs no window for it).
            [cards.repl]
            [jank.nrepl.server.handler :as handler]))

(defn- plain
  "A text without the colours it was printed with (escape sequences)."
  [text]
  (str/replace (str text) (re-pattern (str (char 27) "\\[[0-9;]*m")) ""))

(defn- hinted
  "An eval's or a load's reply, with what to do when it holds one of jank's errors that last
  for the whole process: kv agents lost dozens of steps to them, trying the same name again."
  [said]
  (let [said (str said)
        missing (second (re-find #"Symbols not found: \[ ([^ \]]+)" said))
        ;; jank's "Invalid call to `small_integer` with `0` args": a value called as a function.
        ;; A kv agent met it 40 times without seeing that its (whole-end) called a number.
        [_ called-type called-n] (re-find #"Invalid call to `(\w+)` with `(\d+)` args" said)
        called (or (get {"small_integer" "a number" "integer" "a number" "big_integer" "a number" "real" "a number"
                         "ratio" "a number" "persistent_string" "a string" "nil" "nil" "boolean" "true or false"
                         "character" "a character"}
                        called-type)
                   ;; The same found when compiling: "There is no call operator for `int`".
                   (when (re-find #"There is no call operator for `" said) "a value that is not a function"))]
    (str said
         (cond
           (and (str/includes? said "redefinition of") (str/includes? said "checked with clang"))
           (str "\n(C++ changed under a name this process already has. Give the changed source a new "
                "namespace name (files2, files3) and call that one; the earlier one is still there.)")
           (str/includes? said "redefinition of")
           (str "\n(C++ source changed under a name already evaluated: that namespace is now lost in this "
                "process. Put the changed source under a new namespace name (files2, files3) and call that one.)")
           (and (str/includes? said "Unable to find `") (str/includes? said "within"))
           (str "\n(A C++ namespace whose source failed or was changed before is lost in this process, even "
                "when the source is right now. Use a new namespace name for it.)")
           ;; jank points into its own core.jank when the mistake is in the agent's forms
           ;; inside one of its macros (an `if` with four forms inside `future`).
           (re-find #"│ \S*/clojure/core\.jank" said)
           (str "\n(The place shown is inside jank's own clojure/core.jank, in a macro your code used "
                "(future, when, let, fn, ...): the mistake is in your forms inside that macro, not there.)")
           called
           (str "\n(" called " was called as a function"
                (when called-n (str ", with " called-n " arguments"))
                ": something like (n) where n is not a function. Look for an extra pair of brackets around "
                "a value, or a value where a function was meant.)")
           missing
           (str "\n(The C++ library function " (cpp/harness.demangle missing) " can't be linked in this "
                "process any more: C++ source that failed to compile used it first, and jank's JIT doesn't "
                "link it after that. A new name doesn't help. Write that part without it: file contents "
                "can be read and written in jank (slurp, spit, spit with :append true).)")))))

(defn- deref-calls
  "When `said` is the error of a value called as a function and `code` holds forms like
  (@done), a sentence naming them: a queue agent took (@done) for a read of the atom and
  met the error ten times without seeing it."
  [said code]
  (when (str/includes? (str said) "was called as a function")
    (let [found (distinct (re-seq #"\(@[^\s()\[\]{}]+\)" (str code)))]
      (when (seq found)
        (str "\n(In this code " (str/join ", " (take 3 found)) " calls the value it reads: "
             "write " (str/join ", " (map (fn [f] (subs f 1 (dec (count f)))) (take 3 found)))
             " to read it.)")))))

(defn- cause
  "What an evaluation's error says: its cause without the trace, or its lines without the
  rule above them and the link below."
  [said]
  (let [said (plain said)
        at (str/index-of said ":cause \"")]
    (if at
      (let [from (+ at 8)
            to (str/index-of said "\"\n" from)]
        (if to (subs said from to) (subs said from)))
      (let [lines (remove (fn [line]
                            (or (str/blank? line)
                                (str/starts-with? line "─")
                                (str/starts-with? line "https://book.jank-lang.org")))
                          (str/split-lines said))
            lines (map (fn [line] (if (str/starts-with? line "error: ") (subs line 7) line)) lines)]
        (str/join "\n" lines)))))

;; Directories the file tools refuse (read_file, list_dir, load_file, write_file,
;; edit_file): what a run mustn't look at.
;; (Not a sandbox: eval and the shell can still reach them.)
(defonce hidden-paths (atom []))

(defn- check-path!
  "Throws when `path` is in a hidden directory."
  [path]
  (let [real (str (cpp/harness.real_path (str path)))]
    (when (some (fn [d] (or (= real d) (str/starts-with? real (str d "/")))) @hidden-paths)
      (throw (ex-info (str path " is not available to this run") {})))
    path))

;; The namespace the model's code is evaluated in.
(defonce evaluation-ns (atom "user"))

;; What every evaluation can count on in `user`: clojure.string as str, clojure.set as set.
(defonce ^:private prepared (atom false))

(defn- prepare! []
  (when-not @prepared
    (cards.repl/evaluate "(require '[clojure.string :as str] '[clojure.set :as set])" "user" "harness" 1 1 false)
    (reset! prepared true)))

(defn- forms-of
  "Where the code's top-level forms are: {:spans [[start end] ...]} (byte offsets), or
  {:error what doesn't read}."
  [code]
  (let [lines (str/split-lines (str (cpp/harness.top_forms (str code))))]
    (if (= "ok" (first lines))
      {:spans (mapv (fn [l] (mapv parse-long (str/split l #" "))) (rest lines))}
      {:error (str/join "\n" (rest lines))})))

(defonce ^:private cpp-accepted
  ;; The C++ source (cpp/raw) this process has compiled: a change to it is checked with them.
  (atom []))

(defn- cpp-sources
  "The C++ source of the code's top-level cpp/raw forms, in order."
  [code spans]
  (vec (keep (fn [[a b]]
               (let [text (subs code a b)]
                 (when (str/starts-with? text "(cpp/raw")
                   (let [form (try (read-string text) (catch :default _ nil))]
                     (when (string? (second form)) (second form))))))
             spans)))

(defn- cpp-check
  "nil when the code's new C++ (cpp/raw) compiles, checked with clang the way jank's JIT
  would compile it, after the C++ this process already has; else what clang says. Source
  given to the JIT that fails to compile leaves the C++ library functions it used unlinkable
  for the rest of the process (\"Symbols not found\"), so it doesn't go there."
  [sources]
  (let [new (vec (distinct (remove (set @cpp-accepted) sources)))]
    (when (seq new)
      (let [text (str (apply str (map (fn [src] (str "#line 1 \"cpp/raw evaluated before\"\n" src "\n")) @cpp-accepted))
                      (apply str (map (fn [src] (str "#line 1 \"cpp/raw\"\n" src "\n")) new)))
            command (str (cpp/harness.cpp_check_command text))]
        (when-not (str/blank? command)
          (let [ran (cpp/harness.run command 100000 60.0)
                out (str/trim (str (:out ran)))]
            (when (or (:timed-out ran) (not (zero? (:exit ran))))
              (str "error: the C++ in cpp/raw doesn't compile. It was checked with clang before going to "
                   "jank, and not run: the C++ this process has is as it was.\n"
                   (str/join "\n" (remove (fn [l] (re-find #"^\d+ errors? generated" l)) (str/split-lines out)))))))))))

(defn- cpp-accept!
  "The sources recorded as compiled in this process."
  [sources]
  (swap! cpp-accepted (fn [had] (into had (remove (set had) (distinct sources))))))

(def eval-seconds
  "How long one evaluation (an eval's form, a loaded file) may take."
  120)

(defn- limited
  "What `f` returns, or nil when it takes longer than `eval-seconds`: a queue agent's test
  waited forever on its own deadlock, and its run with it. `f` goes on in the background (a
  thread can't be stopped)."
  [f]
  (let [running (future (f))
        began (cpp/harness.seconds)]
    (loop []
      (cond
        (realized? running) @running
        (> (- (cpp/harness.seconds) began) eval-seconds) nil
        :else (do (cpp/harness.pause 0.05) (recur))))))

(def ^:private timed-out-text
  (str "the evaluation did not end in " eval-seconds " seconds, so it was left running in the "
       "background (a thread can't be stopped). Code that waits (@ of a future or promise, a "
       "lock, a loop) may be waiting forever: give its waits an end, like a loop on realized? "
       "that gives up after a while (JANK.md: deref with a timeout doesn't wait)."))

(defn- eval-one
  "One piece of code evaluated as an editor would send it: {:out :err :failed :value :ns}."
  [code ns]
  (let [answer (or (limited (fn [] (handler/handle-message {"op" "eval" "code" (str code) "ns" ns})))
                   {:ex timed-out-text})
        parts (if (map? answer) [answer] (remove nil? answer))
        failed (some :ex parts)]
    {:out (apply str (keep :out parts))
     :failed failed
     :value (some :value parts)
     ;; What was written to stderr, apart from the error itself (the nREPL sends that
     ;; there too): a C++ compiler's messages are only there.
     :err (apply str (remove (fn [text] (= text failed)) (keep :err parts)))
     :ns (or (some :ns parts) ns)}))

(defn- ended [text]
  (str (plain text) (when-not (str/ends-with? text "\n") "\n")))

(defn- head-of
  "A form's first line, short: how a value is labelled."
  [text]
  (let [line (first (str/split-lines (str/trim text)))]
    (if (> (count line) 60) (str (subs line 0 57) "...") line)))

(defn- evaluate-raw
  "evaluate without the hints."
  [code]
  (prepare!)
  (let [code (str code)
        found (forms-of code)
        spans (:spans found)
        bad (when-not (:error found) (cpp-check (cpp-sources code spans)))]
    (cond
      (:error found)
      (str "error: the code doesn't read: " (:error found))

      bad
      bad

      (<= (count spans) 1)
      (let [r (eval-one code @evaluation-ns)]
        (when-not (:failed r) (cpp-accept! (cpp-sources code spans)))
        (str (when (seq (:out r)) (ended (:out r)))
             (when (seq (str/trim (:err r))) (ended (:err r)))
             (if (:failed r)
               (str "error: " (cause (:failed r)))
               (str "=> " (:value r)))))

      :else
      ;; Form by form, each from its own text (so its metadata, ^:dynamic, stays), in the
      ;; namespace the one before left.
      (loop [spans spans ns @evaluation-ns said ""]
        (if (empty? spans)
          (str/trimr said)
          (let [[a b] (first spans)
                text (subs code a b)
                r (eval-one text ns)
                _ (when-not (:failed r) (cpp-accept! (cpp-sources code [[a b]])))
                said (str said
                          (when (seq (:out r)) (ended (:out r)))
                          (when (seq (str/trim (:err r))) (ended (:err r))))]
            (if (:failed r)
              (str said "error in " (head-of text) ": " (cause (:failed r))
                   (when (seq (rest spans)) (str "\n(the " (count (rest spans)) " forms after it were not evaluated)")))
              (recur (rest spans) (:ns r) (str said (head-of text) " => " (:value r) "\n")))))))))

(defn evaluate
  "Evaluates jank code (a Clojure dialect) in the running process: what it printed and
  each top-level form's value, as a REPL shows them, form by form (an error stops there).
  Definitions stay for later calls. clojure.core is there, clojure.string as str and
  clojure.set as set; inkling.core is the engine this model runs on, and
  (harness.core/me) gives this conversation's {:model :session :agent}."
  [code]
  (let [said (hinted (evaluate-raw code))]
    (str said (deref-calls said code))))

(defn- load-file-raw
  "load-file without the hints."
  [path]
  (prepare!)
  (check-path! path)
  (when-not (cpp/harness.is_file (str path))
    (throw (ex-info (str "there is no file " path) {})))
  (let [text (slurp (str path))
        found (forms-of text)]
    (if (:error found)
      (str "error: " path " doesn't read: " (:error found))
      (if-let [bad (cpp-check (cpp-sources text (:spans found)))]
        (str/replace-first bad "error:" (str "error loading " path ":"))
      (let [r (or (limited (fn [] (cards.repl/evaluate text "user" (str path) 1 1 false)))
                  {:ok false :error timed-out-text})]
        ;; Its C++ compiled unless the error says otherwise (cpp/raw forms come first in a file).
        (when-not (and (not (:ok r)) (str/includes? (str (:error r)) "compile C++"))
          (cpp-accept! (cpp-sources text (:spans found))))
        (str (when (seq (:out r)) (ended (:out r)))
             ;; A C++ compiler's messages are only on stderr (eval shows them the same way).
             (when (seq (str/trim (str (:err r)))) (ended (:err r)))
             (if (:ok r)
               (str "loaded " path ": " (count (:spans found)) " forms, namespace " (:ns r))
               (str "error loading " path ": " (cause (:error r))))))))))

(defn load-file
  "Loads a jank file: its forms evaluated in order, as loading it would (its ns form first).
  Says what it printed and the namespace it is in, or what failed, with its line."
  [path]
  (let [said (hinted (load-file-raw path))]
    (str said (when (cpp/harness.is_file (str path)) (deref-calls said (slurp (str path)))))))

(defn functions
  "Lists what a namespace of the running process defines: a line a name, with the start of
  its documentation. The engine this model runs on is the namespace inkling.core; this
  harness is harness.core."
  [namespace]
  (let [found (find-ns (symbol (str namespace)))]
    (when-not found
      (throw (ex-info (str "there is no namespace " namespace " (loaded ones include inkling.core, "
                           "harness.core, harness.tools, clojure.core, clojure.string)") {})))
    (str/join "\n"
              (map (fn [[sym v]]
                     (let [said (:doc (meta v))]
                       (str sym (when said (str "  -  " (first (str/split-lines said)))))))
                   (sort-by (fn [[sym _]] (str sym)) (ns-publics found))))))

(defn describe
  "Describes one thing a namespace defines, by its full name (like clojure.string/split):
  its parameters and its documentation."
  [name]
  (let [sym (symbol (str name))
        in (fn [n s] (when-let [found (find-ns n)] (get (ns-publics found) s)))
        ;; A short name is looked up in clojure.core, then clojure.string (an agent asked
        ;; for slurp and lost a step to "give the full name").
        [full v] (if (namespace sym)
                   [(str name) (in (symbol (namespace sym)) (symbol (clojure.core/name sym)))]
                   (or (some (fn [n] (when-let [v (in n sym)] [(str n "/" sym) v]))
                             ['clojure.core 'clojure.string])
                       [(str name) nil]))]
    (when-not v
      (throw (ex-info (str "nothing is defined as " name ": give the full name, like clojure.string/split") {})))
    (let [said (meta v)]
      (str full
           (when (:arglists said) (str "\nparameters: " (str/join " or " (map pr-str (:arglists said)))))
           "\n" (or (:doc said) "(no documentation)")))))

(defn read-file
  "Reads a text file and returns its contents. With from and lines, only that many lines
  starting at line `from` (the first line is 1), each with its number."
  [path from lines]
  (check-path! path)
  (when-not (cpp/harness.is_file (str path))
    (throw (ex-info (str "there is no file " path) {})))
  (let [text (slurp (str path))]
    (if (or from lines)
      (let [from (max 1 (or from 1))
            all (str/split-lines text)
            wanted (take (or lines 200) (drop (dec from) all))]
        (str (str/join "\n" (map-indexed (fn [i line] (str (+ from i) "\t" line)) wanted))
             "\n[lines " from " to " (+ from (count wanted) -1) " of " (count all) "]"))
      text)))

(defn write-file
  "Writes text to a file, replacing what it had; the directories its path needs are made.
  For a new file, or one changed throughout: to change part of a file, edit_file is
  quicker (only the part is written again)."
  [path content]
  (check-path! path)
  (cpp/harness.make_parents (str path))
  (cpp/harness.write_file (str path) (str content))
  (str "wrote " (count (str content)) " bytes to " path))

(defn- occurrences [text part]
  (loop [n 0 from 0]
    (let [at (str/index-of text part from)]
      (if at
        (recur (inc n) (+ at (count part)))
        n))))

(defn edit-file
  "Replaces one piece of a text file: `old` must be in the file exactly once, as it is
  written there (its line breaks and spaces included). The way to change part of a file:
  only that part is written again."
  [path old new]
  (check-path! path)
  (when-not (cpp/harness.is_file (str path))
    (throw (ex-info (str "there is no file " path) {})))
  (let [text (slurp (str path))
        found (occurrences text (str old))]
    (when (zero? found)
      (throw (ex-info "old is not in the file as it is written there" {})))
    (when (> found 1)
      (throw (ex-info (str "old is in the file " found " times: give more of what is around it") {})))
    (let [at (str/index-of text (str old))]
      (cpp/harness.write_file (str path) (str (subs text 0 at) new (subs text (+ at (count (str old))))))
      (str "edited " path))))

(defn list-dir
  "Lists a directory: a line an entry, directories ending in /, files with their sizes."
  [path]
  (check-path! path)
  (let [entries (cpp/harness.list_dir (str path))]
    (if (empty? entries)
      "(empty)"
      (str/join "\n" (map (fn [e] (if (:dir e) (str (:name e) "/") (str (:name e) "\t" (:bytes e) " bytes")))
                          entries)))))

(defn shell
  "Runs a command with the shell (sh -c) and returns its output, its error output included,
  and its exit code when that is not 0. The command has `timeout` seconds (120 when not
  given): at that it is killed, with what it started. To leave something running, start it
  in the background with its output sent to a file (python3 server.py > server.log 2>&1 &):
  the command then ends at once and the server stays."
  [command timeout]
  (let [ran (cpp/harness.run (str command) 200000 (double (or timeout 120)))
        said (str (:out ran)
                  ;; A failing command with nothing to say (grep finding nothing exits 1, and an
                  ;; && after it is skipped): "[exit 1]" alone had an agent run it seven times.
                  (when (and (str/blank? (str (:out ran))) (not (:timed-out ran)) (not (zero? (:exit ran))))
                    "(no output)")
                  (when (> (:bytes ran) (count (str (:out ran))))
                    (str "\n[output cut: " (:bytes ran) " bytes in all]"))
                  (when (:timed-out ran)
                    (str "\n[killed: it did not end in " (or timeout 120) " seconds]"))
                  (when (and (not (:timed-out ran)) (not (zero? (:exit ran))))
                    (str "\n[exit " (:exit ran) "]")))
        ;; A command that only ends in `true` or `:`, with nothing printed: a kv agent made ten such
        ;; calls between stretches of thinking, and the run was ended as going round in a loop.
        idle (and (= "" said) (re-find #"(?:^|&&|;|\|\|)\s*(?:true|:)\s*$" (str/trim (str command))))]
    (cond
      idle (str "(no output: this command does nothing. Each call takes one of your steps; think without "
                "calling anything, and call a tool when you need what it gives.)")
      (= "" said) "(no output)"
      :else said)))

(def situation
  "What an agent with the default tools can be told first (its :system): where it is, and
  when to look things up."
  (str "You are running inside a jank process (jank is a Clojure dialect compiled to native "
       "code), on the inkling inference engine, which is loaded in this same process. "
       "Use the tools when a request needs them, and answer directly when it does not: "
       "do not explore before a simple request. "
       "The eval tool evaluates jank code here: definitions stay, and the code can call "
       "anything the process has loaded. (harness.core/me) returns this conversation's "
       "{:model :session :agent}: the model is the one you are running on and the session "
       "holds this conversation's tokens. The engine's functions are in the namespace "
       "inkling.core: the functions tool lists a namespace and the describe tool documents "
       "one function. When a question is about this process, the engine or the model "
       "itself, look it up instead of guessing. "
       "jank is not the Clojure of the JVM: the file JANK.md, in the directory this process "
       "runs in, says what differs and how C++ is called. Read it before writing code that "
       "goes beyond plain Clojure functions."))

(def system-paths
  "What any process here reads, which holds nobody's files: the system, its tools and
  libraries, Homebrew's."
  ["/System" "/usr" "/bin" "/sbin" "/Library" "/opt/homebrew" "/private/etc" "/private/var/db"
   "/dev" "/Applications/Xcode.app"])

(defn confine!
  "This process sandboxed from now on (macOS; once, and only when it wasn't started inside a
  sandbox): for running a model's code once the harness is loaded, so that its tools and
  everything they start can't read what the harness could. Only `system-paths` and `read`
  can be read (and the names of the files at the top, in /); `hide` can't be read even
  there; files can be written only in `write` and /dev; the network reaches only this
  machine. Each is a list of absolute paths. Point TMPDIR at one of `read` and `write`
  before starting the process: the shared temporary directory holds other programs' files.
  Returns the profile applied."
  [{:keys [read write hide]}]
  (let [real (fn [p] (str (cpp/harness.real_path (str p))))
        paths (fn [ps] (str/join " " (map (fn [p] (str "(subpath " (pr-str (real p)) ")")) ps)))
        profile (str "(version 1)\n(allow default)\n"
                     "(deny file-read-data)\n"
                     "(allow file-read-data (literal \"/\") " (paths (concat system-paths read)) ")\n"
                     ;; The data volume seen again under /System (the sandbox resolves it to
                     ;; the paths above, but said anyway).
                     "(deny file-read-data (subpath \"/System/Volumes/Data\"))\n"
                     (when (seq hide) (str "(deny file-read-data " (paths hide) ")\n"))
                     "(deny file-write*)\n"
                     "(allow file-write* " (paths (cons "/dev" write)) ")\n"
                     "(deny network*)\n"
                     "(allow network* (local ip \"localhost:*\") (remote ip \"localhost:*\") "
                     "(local unix-socket) (remote unix-socket))\n")
        failed (str (cpp/harness.sandbox_self profile))]
    (when (seq failed)
      (throw (ex-info (str "the sandbox wasn't applied: " failed) {:profile profile})))
    profile))

(defn notes
  "The notes tool: the agent's own notes, kept apart from its conversation (in its atom, as
  :notes), so that they stay when the conversation is summarized (the summary shows them),
  and saved with it."
  []
  (h/tool {:name "notes"
           :doc (str "Your own notes, kept apart from the conversation: they stay when it is summarized. "
                     "With text, it replaces them (give all you want kept); without, it gives them. Keep "
                     "what you have tried and what came of it, what failed and why, and what to do next.")
           :params {:text {:type "string" :doc "all the notes to keep (left out: read them)"}}
           :required []
           :fn (fn [{:keys [text]}]
                 (let [a (:agent (h/me))]
                   (if (some? text)
                     (do (swap! a assoc :notes (str text))
                         (str "Kept (" (count (str text)) " characters)."))
                     (let [n (:notes @a)]
                       (if (seq n) n "(No notes yet.)")))))}))

(defn defaults
  "The default tools, a vector to give an agent (or to pick from: each is a map with
  :name). eval runs code in this process; the others are the usual ones for files and
  commands."
  []
  [(h/wrap #'evaluate {:name "eval"
                       :params {:code "the code to evaluate"}
                       :limit 12000})
   (h/wrap #'load-file {:name "load_file"
                        :params {:path "the file's path, like work/x.jank"}
                        :limit 12000})
   (h/wrap #'functions {:reads-only true :params {:namespace "the namespace's name, like inkling.core"}
                        :limit 12000})
   (h/wrap #'describe {:reads-only true :params {:name "the full name, like clojure.string/split"}})
   (h/wrap #'read-file {:name "read_file" :reads-only true
                        :params {:path "the file's path"
                                 :from {:type "integer" :doc "the first line wanted (optional)"}
                                 :lines {:type "integer"
                                         :doc "how many lines (optional: 200 when only from is given)"}}
                        :optional [:from :lines]
                        :limit 24000})
   (h/wrap #'write-file {:name "write_file"
                         :params {:path "the file's path" :content "the file's whole text"}})
   (h/wrap #'edit-file {:name "edit_file"
                        :params {:path "the file's path"
                                 :old "the text to replace, exactly as in the file"
                                 :new "the text to put in its place"}})
   (h/wrap #'list-dir {:name "list_dir" :reads-only true :params {:path "the directory's path"}})
   (h/wrap #'shell {:name "shell"
                    :params {:command "the command line"
                             :timeout {:type "number"
                                       :doc "seconds it may take (optional: 120)"}}
                    :optional [:timeout]
                    :limit 12000})
   (notes)])
