;; SPDX-License-Identifier: MIT
;; Agents in the window (cards.core): above the cards, a line for each conversation watched,
;; and the one chosen written out as a terminal is: the person's messages, the model's
;; thinking, each tool's call with what it gave, and what the model said (headings, lists,
;; tables, code and bold drawn), the newest at the bottom. A long part (thinking, a call's
;; arguments, what a tool gave) shows its first lines and how many more there are: a click
;; there shows it whole. Under it, what is
;; going on now, and the timeline.
;;
;; The whole is small and always as tall, whatever it holds. "expand", at the timeline's
;; right, opens it over the window as a modal (close, Esc or a click outside puts it back).
;; While the end is followed, what comes is shown as it comes; the wheel or the bar on the
;; right looks back, and what is looked at stays put until "Jump to latest".
;;
;; The timeline has a mark for each step: a person's message and each of the model's
;; answers. A click on the line goes to that moment, playing on if it was playing; one on a
;; mark goes to the end of that step and shows it from its start. Playing is quicker than
;; the conversation was (what the model wrote at up to 500 characters a second, each piece in
;; a few seconds at most, the waits short), or 2, 4, 8 times that; the clock says the time
;; as it was. A conversation kept in a file (harness.core/save!) is played the same
;; way, without the model: `replay!`.
;;
;;   (def a (hc/watch! (h/agent m {:tools (tools/defaults)}) "a question"))
;;   (h/ask! a "...")
;;
;; What the agent evaluates (the eval tool) is a card below like any evaluation.
(ns harness.cards
  (:require [clojure.string :as str]
            [cards.core :as c]
            [cards.main :as window]
            [harness.core :as h]
            [harness.json :as json]))

;; What is watched and how it is looked at.
(defonce ^:private watched (atom []))       ; [{:name :agent}], in the order they were watched
(defonce ^:private chosen (atom nil))       ; the name of the conversation written out
(defonce ^:private pending (atom {}))       ; name -> entry: shown from its top at the next frame
(defonce ^:private unfolded (atom {}))      ; [name index] -> the parts of that entry shown whole
(defonce ^:private scrolls (atom {}))       ; name -> points looked down from the top; none: the end followed
(defonce ^:private expanded (atom false))   ; whether the conversation is open as a modal
(defonce ^:private rows-from (atom 0.0))    ; the first conversation's line in view, of many
(defonce ^:private held (atom nil))         ; what the mouse drags: {:what :timeline|:scroll :name ...}
(defonce ^:private was-down (atom false))   ; the mouse's button in the last frame
(defonce ^:private built (atom {}))         ; [name index] -> {:entry :width :open :item}
(defonce ^:private frame-panel (atom nil))  ; {:frame :width :panel}: once a frame
(defonce ^:private drawn (atom nil))        ; where the last frame drew the panel's parts
(defonce ^:private plays (atom {}))         ; name -> {:mode :live|:paused|:playing :t :at :speed}
(defonce ^:private scheduled (atom {}))     ; name -> {:entries :schedule}

;; Sizes, in points.
(def ^:private line-prose 20)
;; Everything in the conversation is in the terminal's type.
(def ^:private prose c/mono)
(def ^:private line-mono 19)
(def ^:private line-small 16)
(def ^:private row 28)
(def ^:private small 380)                   ; the whole, not expanded: always this tall
(def ^:private rows-small 4)                ; conversations' lines in view then; the wheel shows the others
(def ^:private rows-large 10)               ; and expanded
(def ^:private margin 24)                   ; around the modal
(def ^:private above 62)                    ; where cards.core draws a header
(def ^:private below 20)
(def ^:private longest 4000)                ; lines of an entry's text, at most
(def ^:private first-lines 3)               ; of a long part, shown until it is opened
(def ^:private bar 38)
(def ^:private status 26)                   ; the line of what is going on, over the timeline
;; A wait (a tool running, a result being read) is shown at most this long in a replay.
(def ^:private wait-shown 1.2)
;; What the model wrote is shown at most this fast, and each piece in at most this long, in a
;; replay: the model writes about 16 tokens a second, a long thought takes a minute.
(def ^:private written-pace 500.0)
(def ^:private written-most {:thinking 2.0 :call 1.0 :model 3.0})

;; Text into lines.

(defn- cut-word
  "A word wider than `width`: its pieces, each as wide as fits."
  [size width word]
  (c/wrap size width word 50))

(defn- flow
  "Runs of text ([{:text :style}], styles :plain :bold :code) as lines of at most `width`
  points: [[{:x :text :style} ...] ...]. Words are kept whole when they fit a line."
  [runs width]
  (let [size-of (fn [style] (if (= style :code) c/mono prose))
        gap (c/text-width prose " ")
        words (mapcat (fn [run]
                        (mapcat (fn [word]
                                  (let [size (size-of (:style run))]
                                    (if (> (c/text-width size word) width)
                                      (map (fn [piece] {:text piece :style (:style run)})
                                           (cut-word size width word))
                                      [{:text word :style (:style run)}])))
                                (remove empty? (str/split (str (:text run)) #" "))))
                      runs)]
    (loop [words words x 0.0 line [] lines []]
      (if (empty? words)
        (if (seq line) (conj lines line) lines)
        (let [word (first words)
              w (c/text-width (size-of (:style word)) (:text word))]
          (if (and (seq line) (> (+ x w) width))
            (recur words 0.0 [] (conj lines line))
            (recur (rest words) (+ x w gap) (conj line (assoc word :x x)) lines)))))))

(defn- draw-flow
  "Lines of `flow` drawn from (x, y), `color` for plain and bold text."
  [lines x y color]
  (doseq [[i line] (map-indexed vector lines)]
    (doseq [word line]
      (let [wx (+ x (:x word))
            wy (+ y (* line-prose i))]
        (case (:style word)
          :code (c/text! wx (+ wy 1) c/purple c/mono (:text word))
          :bold (do (c/text! wx wy color prose (:text word))
                    (c/text! (+ wx 0.6) wy color prose (:text word)))
          (c/text! wx wy color prose (:text word)))))))

;; Markdown, as much as a model's answer has.

(defn- inline
  "A line's runs: `code` between backticks, **bold** between pairs of asterisks."
  [text]
  (vec (mapcat (fn [[i part]]
                 (if (odd? i)
                   [{:text part :style :code}]
                   (map (fn [[j piece]] {:text piece :style (if (odd? j) :bold :plain)})
                        (map-indexed vector (str/split part #"\*\*")))))
               (map-indexed vector (str/split (str text) #"`")))))

(defn- bullet
  "A list item's [marker rest] when the line is one, else nil."
  [line]
  (let [t (str/triml line)]
    (cond
      (or (str/starts-with? t "- ") (str/starts-with? t "* ")) ["•" (subs t 2)]
      :else
      (let [dot (str/index-of t ". ")]
        (when (and dot (pos? dot) (<= dot 3) (some? (parse-long (subs t 0 dot))))
          [(subs t 0 (inc dot)) (subs t (+ dot 2))])))))

(defn- blocks
  "A text's blocks: {:kind :p|:h|:li|:code|:table|:rule ...}."
  [text]
  (loop [lines (str/split-lines (str text)) para [] code nil out []]
    (let [flush (fn [out] (if (seq para) (conj out {:kind :p :text (str/join " " para)}) out))]
      (if (empty? lines)
        (let [out (flush out)]
          (if code (conj out {:kind :code :lines code}) out))
        (let [line (first lines)
              t (str/trim line)]
          (cond
            code
            (if (str/starts-with? t "```")
              (recur (rest lines) [] nil (conj out {:kind :code :lines code}))
              (recur (rest lines) [] (conj code line) out))

            (str/starts-with? t "```")
            (recur (rest lines) [] [] (flush out))

            (empty? t)
            (recur (rest lines) [] nil (flush out))

            (str/starts-with? t "#")
            (recur (rest lines) [] nil
                   (conj (flush out) {:kind :h :text (str/trim (str/replace t "#" ""))}))

            (or (= t "---") (= t "***"))
            (recur (rest lines) [] nil (conj (flush out) {:kind :rule}))

            ;; A table's row: its cells, added to the table before it. The row of dashes
            ;; under the headings is not one.
            (str/starts-with? t "|")
            (let [out (flush out)
                  cells (mapv (fn [cell] (str/trim (str/replace (str/replace cell "**" "") "`" "")))
                              (rest (str/split t #"\|")))
                  dashes (every? (fn [cell] (and (seq cell)
                                                 (empty? (str/replace (str/replace cell "-" "") ":" ""))))
                                 cells)
                  before (peek out)]
              (recur (rest lines) [] nil
                     (cond
                       dashes out
                       (= (:kind before) :table) (conj (pop out) (assoc before :rows (conj (:rows before) cells)))
                       :else (conj out {:kind :table :rows [cells]}))))

            (bullet line)
            (let [[mark said] (bullet line)
                  depth (quot (- (count line) (count (str/triml line))) 2)]
              (recur (rest lines) [] nil (conj (flush out) {:kind :li :mark mark :text said :depth depth})))

            :else
            (recur (rest lines) (conj para t) nil out)))))))

;; Items: a piece of the conversation with its height and how it is drawn.

(defn- prose-item
  "A text as markdown, `color` its ink."
  [text width color]
  (let [parts (mapv (fn [b]
                      (case (:kind b)
                        :p (let [lines (flow (inline (:text b)) width)]
                             {:h (+ (* line-prose (count lines)) 6)
                              :draw (fn [x y] (draw-flow lines x y color))})
                        :h (let [lines (flow [{:text (:text b) :style :bold}] width)]
                             {:h (+ (* line-prose (count lines)) 8)
                              :draw (fn [x y] (draw-flow lines x (+ y 2) color))})
                        :li (let [indent (+ 18 (* 16 (:depth b)))
                                  lines (flow (inline (:text b)) (- width indent))
                                  mark (:mark b)]
                              {:h (+ (* line-prose (max 1 (count lines))) 2)
                               :draw (fn [x y]
                                       (c/text! (+ x indent -16) y c/muted prose mark)
                                       (draw-flow lines (+ x indent) y color))})
                        :code (let [lines (vec (mapcat (fn [line] (c/wrap c/mono (- width 20) line 6)) (:lines b)))
                                    lines (if (empty? lines) [(str "")] lines)]
                                {:h (+ (* line-mono (count lines)) 18)
                                 :draw (fn [x y]
                                         (c/rect! x y (+ x width) (+ y (* line-mono (count lines)) 10) c/rule 0.28 5.0)
                                         (doseq [[i line] (map-indexed vector lines)]
                                           (c/text! (+ x 10) (+ y 5 (* line-mono i)) c/ink c/mono line)))})
                        :rule {:h 12 :draw (fn [x y] (c/line! x (+ y 5) (+ x width) (+ y 5) c/rule 1.0))}
                        ;; Columns as wide as their widest cell, all narrowed alike when
                        ;; they don't fit; the first row is the headings.
                        :table (let [rows (:rows b)
                                     n (apply max 1 (map count rows))
                                     natural (mapv (fn [col]
                                                     (+ 18 (apply max 20 (map (fn [r] (c/text-width prose (str (get r col ""))))
                                                                              rows))))
                                                   (range n))
                                     all (apply + natural)
                                     scale (if (> all width) (/ width all) 1.0)
                                     widths (mapv (fn [w] (* w scale)) natural)
                                     lefts (vec (reductions + 0 widths))
                                     right (last lefts)]
                                 {:h (+ (* 24 (count rows)) 12)
                                  :draw (fn [x y]
                                          (doseq [[r cells] (map-indexed vector rows)]
                                            (let [ry (+ y (* 24 r))]
                                              (when (zero? r)
                                                (c/rect! x ry (+ x right) (+ ry 24) c/rule 0.3 3.0))
                                              (c/line! x (+ ry 24) (+ x right) (+ ry 24) c/rule 1.0)
                                              (doseq [col (range n)]
                                                (let [cell (c/clip prose (- (nth widths col) 14) (str (get cells col "")))
                                                      cx (+ x (nth lefts col) 8)]
                                                  (c/text! cx (+ ry 3) color prose cell)
                                                  (when (zero? r)
                                                    (c/text! (+ cx 0.6) (+ ry 3) color prose cell)))))))})
                        {:h 0 :draw (fn [x y] nil)}))
                    (blocks text))
        tops (vec (reductions + 0 (map :h parts)))]
    {:h (last tops)
     :draw (fn [x y w]
             (doseq [[i part] (map-indexed vector parts)]
               ((:draw part) x (+ y (nth tops i)))))}))

;; Items: a piece of the conversation with its height and how it is drawn.

(defn- mono-lines
  "A text as wrapped lines of small mono, at most `limit` of them."
  [text width limit]
  (let [all (c/wrap c/small width (str text) (inc limit))]
    (if (> (count all) limit)
      (conj (vec (take limit all)) (str "[more]"))
      (vec all))))

(defn- seconds-said [s]
  (if (and s (>= s 0.05)) (str (c/fixed s 1) " s") (str "")))

(defn- draw-lines
  "Lines of small mono from (x, y), one every `line-small` points: only those in the window."
  [lines x y color]
  (let [n (long (count lines))
        from (max 0 (min n (long (/ (- 0.0 y) line-small))))
        to (max from (min n (+ 2 (long (max 0.0 (/ (- (c/window-height) y) line-small))))))]
    (loop [i from]
      (when (< i to)
        (c/text! x (+ y (* line-small i)) color c/small (nth lines i))
        (recur (inc i))))))

(defn- part
  "A long text's lines as shown: its first `first-lines` and a line saying how many more
  (a click there opens it), or all of it and a line that closes it again. Being written, its
  last lines. Returns {:lines :toggle :top :h}: :toggle is the line clicked under the lines,
  [its text, whether it opens]; :top, a line over them (an opened part closes from its top
  too, not only a hundred lines further down)."
  [lines open writing]
  (let [n (long (count lines))
        long-one (> n (inc first-lines))]
    (cond
      (not long-one) {:lines lines :toggle nil :h (* line-small n)}
      writing {:lines (subvec lines (- n first-lines)) :toggle nil :h (* line-small first-lines)}
      open {:lines lines :toggle [(str "show less") false]
            :top [(str "show less (" n " lines)") false] :h (* line-small (+ n 2))}
      :else {:lines (subvec lines 0 first-lines)
             :toggle [(str "... " (- n first-lines) " more lines") true]
             :h (* line-small (inc first-lines))})))

(defn- draw-part
  "A part drawn from (x, y): its toggles' lines over and under its lines. Returns where the
  toggles are, [{:part :x :y :open :label}], y from the item's top `top`."
  [shown x y color name top]
  (let [over (:top shown)
        ly (if over (+ y line-small) y)
        toggle (fn [[label opens] ty]
                 (c/text! x ty c/blue c/small label)
                 {:part name :x x :y (- ty top) :open (not opens) :label label})]
    (draw-lines (:lines shown) x ly color)
    (vec (concat (when over [(toggle over y)])
                 (when (:toggle shown)
                   [(toggle (:toggle shown) (+ ly (* line-small (long (count (:lines shown))))))])))))

(defn- user-item
  "A person's message, on a band, after a prompt: its lines as they were typed."
  [text width]
  (let [lines (vec (c/wrap c/mono (- width 40) (str text) 400))
        h (* line-mono (max 1 (long (count lines))))]
    {:h (+ h 24)
     :draw (fn [x y w]
             (c/rect! x y (+ x w) (+ y h 14) c/rule 0.3 5.0)
             (c/text! (+ x 10) (+ y 7) c/muted c/mono (str ">"))
             (doseq [[i line] (map-indexed vector lines)]
               (c/text! (+ x 28) (+ y 7 (* line-mono i)) c/ink c/mono line))
             [])}))

(defn- thinking-item
  "The model thinking, quiet: its first lines, all of them when opened."
  [text cut width opened writing]
  (let [shown (part (mono-lines text (- width 16) longest) (contains? opened :text) writing)
        label (if cut (str "thinking (cut short by the harness)") (str "thinking"))]
    {:h (+ 20 (:h shown) 10)
     :draw (fn [x y w]
             (c/text! x y c/muted c/small label)
             (draw-part shown (+ x 14) (+ y 18) c/muted :text y))}))

(defn- model-item
  "What the model said, after a dot: all of it."
  [text width]
  (let [inner (prose-item text (- width 18) c/ink)]
    {:h (+ (:h inner) 10)
     :draw (fn [x y w]
             (c/circle! (+ x 5) (+ y 10) 3.5 c/ink 1.0)
             ((:draw inner) (+ x 18) (+ y 2) (- w 18))
             [])}))

(defn- main-key
  "The argument of a call that says most: its code, its command, its path."
  [args]
  (some (fn [k] (when (contains? args k) k)) (concat [:code :command :path :name :namespace] (keys args))))

(defn- call-item
  "A tool's call: its name, its arguments, and under them what it gave (`result`, nil while
  it runs), each its first lines until opened. `writing`: the call is still being written."
  [entry result width opened writing]
  (let [args (:args entry)
        mk (main-key args)
        main (when mk (get args mk))
        main-lines (mono-lines (if (string? main) main (pr-str main)) (- width 40) longest)
        rest-lines (vec (mapcat (fn [[k v]]
                                  (mono-lines (str (subs (str k) 1) ": " (if (string? v) v (pr-str v))) (- width 40) 200))
                                (dissoc args mk)))
        said (part (vec (concat main-lines rest-lines)) (contains? opened :args) writing)
        failed (boolean (and result (or (:error result) (str/starts-with? (str (:text result)) "error:"))))
        out (when result (part (mono-lines (:text result) (- width 40) longest) (contains? opened :out) false))
        out-h (cond writing 0 out (max line-small (:h out)) :else line-small)
        note (if result (str (if failed "error  " "") (seconds-said (:seconds result))) (str ""))
        color (if failed c/red c/orange)]
    {:h (+ 20 (:h said) (if writing 4 (+ 8 out-h)) 10)
     :draw (fn [x y w]
             (c/circle! (+ x 5) (+ y 9) 3.5 color 1.0)
             (c/text! (+ x 18) (+ y 1) color c/mono (:name entry))
             (c/text! (- (+ x w) (c/text-width c/small note) 4) (+ y 3) c/muted c/small note)
             (let [ay (+ y 20)
                   t1 (draw-part said (+ x 18) ay c/blue :args y)
                   t2 (when-not writing
                        (let [oy (+ ay (:h said) 8)]
                          ;; What it gave, under a corner.
                          (c/line! (+ x 22) (- oy 3) (+ x 22) (+ oy 7) c/rule 1.0)
                          (c/line! (+ x 22) (+ oy 7) (+ x 30) (+ oy 7) c/rule 1.0)
                          (if out
                            (draw-part out (+ x 36) oy (if failed c/red c/ink) :out y)
                            (do (c/text! (+ x 36) oy c/muted c/small (str "running..."))
                                []))))]
               (vec (concat t1 t2))))}))

(defn- entry-item
  "An entry's item. `result` is the entry after a call's (what the tool gave), or nil;
  `opened` the parts of it shown whole. Its :draw returns where its toggles are."
  [entry result width opened]
  (case (:role entry)
    :user (user-item (:text entry) width)
    :thinking (thinking-item (:text entry) (:cut entry) width opened false)
    :call (call-item entry result width opened false)
    :model (model-item (:text entry) width)
    :stopped {:h 24
              :draw (fn [x y w]
                      (c/text! x (+ y 3) c/red c/small
                               (str "stopped: " (subs (str (:why entry)) 1)
                                    (when (:text entry) (str ": " (first (str/split-lines (str (:text entry))))))))
                      [])}
    {:h 0 :draw (fn [x y w] [])}))

(defn- live-item
  "What is being written right now, drawn as it will be once written."
  [live width]
  (case (:kind live)
    :thinking (thinking-item (:text live) false width #{} true)
    :text (model-item (:text live) width)
    :call (call-item {:name (:name live) :args {:code (:text live)}} nil width #{} true)
    ;; A tool running (its call is kept with its result once it has run).
    :tool (call-item {:name (:name live) :args {:code (:text live)}} nil width #{} false)
    nil))

(defn- items
  "The conversation's items for an agent's value `v`: [{:h :draw :key}], an entry's item
  built once and kept until the entry or the width changes. A call and what it gave are one
  item."
  [named v width]
  (let [entries (:entries v)
        n (count entries)
        made (loop [i 0 out []]
               (if (>= i n)
                 out
                 (let [entry (nth entries i)
                       result (when (and (= (:role entry) :call) (< (inc i) n)
                                         (= (:role (nth entries (inc i))) :result))
                                (nth entries (inc i)))]
                   (if (= (:role entry) :result)
                     (recur (inc i) out)
                     (let [key [named i]
                           opened (get @unfolded key #{})
                           kept (get @built key)
                           item (if (and kept (identical? (:entry kept) entry) (identical? (:result kept) result)
                                         (= (:width kept) width) (= (:opened kept) opened))
                                  (:item kept)
                                  (let [item (entry-item entry result width opened)]
                                    (swap! built assoc key {:entry entry :result result :width width
                                                            :opened opened :item item})
                                    item))]
                       (recur (inc i) (conj out (assoc item :key key))))))))
        live (when (:live v) (live-item (:live v) width))]
    (if live (conj made live) made)))

;; The panel: the conversations' lines, then the chosen one.

(def ^:private state-said
  {:idle "idle" :reading "reading" :thinking "thinking" :text "answering" :call "calling a tool"
   :call-text "calling a tool" :tool "running a tool" :tool-error "a tool error" :done "done"
   :limit "stopped: the step's tokens ran out" :context "stopped: the session is full"
   :steps "stopped: too many steps" :stopped "stopped" :error "stopped: an error"})

(defn- going? [state]
  (contains? #{:reading :thinking :text :call :call-text :tool :tool-error} state))

;; A conversation in time.

(defn- written? [role]
  (contains? #{:thinking :model :call} role))

(defn- main-of
  "The argument of a call that says most: its code, its command, its path."
  [args]
  (str (or (:code args) (:command args) (:path args) (:name args) (:namespace args)
           (first (vals args)))))

(defn- schedule
  "When each entry is shown in a replay: {:spans [{:from :to :real-from :real-to :cut}]
  :total}, in seconds. What the model wrote takes the time it took to write; a wait before
  an entry and a tool's run take at most `wait-shown`, and are marked :cut when they were
  longer. An entry without times (an old recording) gets a time from its length."
  [entries]
  (loop [i 0 shown 0.0 real nil out []]
    (if (>= i (count entries))
      {:spans out :total shown}
      (let [e (nth entries i)
            role (:role e)
            began (or (:began e) real 0.0)
            ended (or (:ended e)
                      (+ began (if (written? role) (/ (count (str (:text e) (main-of (:args e)))) 120.0) 0.0)))
            real (or real began)
            wait (max 0.0 (- began real))
            from (+ shown (min wait wait-shown))
            took (max 0.0 (- ended began))
            chars (count (str (:text e) (main-of (:args e))))
            lasts (cond
                    (written? role) (min took (get written-most role 2.0) (max 0.3 (/ chars written-pace)))
                    (= role :result) (min took wait-shown)
                    ;; Typed at the prompt, at forty characters a second.
                    (= role :user) (max 0.6 (min 3.0 (/ (count (str (:text e))) 40.0)))
                    :else 0.6)]
        (recur (inc i) (+ from lasts) (max real ended)
               (conj out {:from from :to (+ from lasts)
                          ;; (A step's second call was written before the first one ran: its
                          ;; time is not let go back.)
                          :real-from (max real began) :real-to (max real ended)
                          :cut (or (> wait wait-shown) (and (= role :result) (> took wait-shown)))}))))))

(defn- schedule-of
  "The schedule of a conversation's entries, made again only when they change."
  [named entries]
  (let [kept (get @scheduled named)]
    (if (and kept (identical? (:entries kept) entries))
      (:schedule kept)
      (let [made (schedule entries)]
        (swap! scheduled assoc named {:entries entries :schedule made})
        made))))

(defn- advance!
  "Where the conversation is shown up to, this frame: {:mode :t :speed}. Playing moves with
  the clock; at the end it follows a turn that is still going (:live), or stops."
  [named v sched]
  (let [p (get @plays named {:mode :live :speed 1.0})
        total (:total sched)
        now (c/seconds)]
    (case (:mode p)
      ;; (A frame that took long, the first one compiling, doesn't skip what it didn't show.)
      :playing (let [t (+ (:t p) (* (get p :speed 1.0) (max 0.0 (min 0.25 (- now (:at p))))))
                     p (cond
                         (< t total) (assoc p :t t :at now)
                         (going? (:state v)) {:mode :live :speed (get p :speed 1.0)}
                         :else (assoc p :mode :paused :t total))]
                 (swap! plays assoc named p)
                 (assoc p :t (min total (get p :t total))))
      :paused (assoc p :t (min total (:t p)))
      (assoc p :t total))))

(defn- at-time
  "The agent's value `v` as it was when the conversation had been shown up to `t`: the
  entries shown whole, and the one being written then as far as it had got."
  [v t sched]
  (let [entries (:entries v)
        spans (:spans sched)
        n (count entries)
        k (loop [i 0] (if (and (< i n) (<= (:to (nth spans i)) t)) (recur (inc i)) i))
        current (when (< k n) (nth entries k))
        span (when (< k n) (nth spans k))
        in (boolean (and span (>= t (:from span))))
        f (if (and in (> (:to span) (:from span)))
            (/ (- t (:from span)) (- (:to span) (:from span)))
            0.0)
        part (fn [text] (cpp/harness.prefix (str text) (long (* f (count (str text))))))
        live (when in
               (case (:role current)
                 :thinking {:kind :thinking :name (str "") :text (part (:text current))}
                 :model {:kind :text :name (str "") :text (part (:text current))}
                 :call {:kind :call :name (:name current) :text (part (main-of (:args current)))}
                 :user {:kind :typing :name (str "") :text (part (:text current))}
                 nil))
        ;; A stop is there whole from its start; a tool's result once it has run.
        whole (if (and in (nil? live) (not= (:role current) :result)) (inc k) k)]
    (assoc v
           :entries (subvec entries 0 whole)
           :live live
           :state (cond (= (:kind live) :typing) :reading
                        live (:kind live)
                        (and current in (= (:role current) :result)) :tool
                        (>= whole n) (:state v)
                        :else :thinking))))

(defn- real-at
  "The time since the conversation began, when it had been shown up to `t`."
  [sched t]
  (let [spans (:spans sched)
        s (last (filter (fn [s] (<= (:from s) t)) spans))]
    (if (nil? s)
      0.0
      (let [f (if (> (:to s) (:from s)) (min 1.0 (/ (- t (:from s)) (- (:to s) (:from s)))) 1.0)]
        (- (+ (:real-from s) (* f (- (:real-to s) (:real-from s))))
           (:real-from (first spans)))))))

(defn- minutes
  "Seconds as m:ss."
  [seconds]
  (let [whole (long (max 0.0 seconds))
        secs (mod whole 60)]
    (str (quot whole 60) ":" (when (< secs 10) "0") secs)))

(defn- doing-at
  "What was going on when the conversation had been shown up to `t`."
  [v sched t]
  (let [entries (:entries v)
        spans (:spans sched)
        at (first (filter (fn [i] (let [s (nth spans i)] (and (>= t (:from s)) (< t (:to s)))))
                          (range (count spans))))
        e (when at (nth entries at))]
    (cond
      ;; Between entries: the model reading what it was given, or a tool's result read.
      (nil? e) (if (>= t (:total sched)) (get state-said (:state v) (str (:state v))) (str "thinking"))
      (= (:role e) :user) (str "typing")
      (= (:role e) :thinking) (str "thinking")
      (= (:role e) :model) (str "answering")
      (= (:role e) :call) (str "calling " (:name e))
      (= (:role e) :result) (str "running " (:name e))
      :else (str (subs (str (:role e)) 1)))))

(defn- draw-status
  "Over the timeline: the person's message being typed, after a prompt; else what is going
  on, with a dot that breathes while something goes, and for how long it has gone."
  [seen v sched play x y width]
  (let [live (:live seen)
        state (:state seen)
        going (going? state)
        now (c/seconds)]
    (c/line! x (- y 1) (+ x width) (- y 1) c/rule 1.0)
    (if (= (:kind live) :typing)
      (let [typed (str (last (str/split-lines (str (:text live)))))
            shown (c/clip c/mono (- width 40) typed)]
        (c/text! (+ x 2) (+ y 5) c/muted c/mono (str ">"))
        (c/text! (+ x 18) (+ y 5) c/ink c/mono shown)
        (c/rect! (+ x 19 (c/text-width c/mono shown)) (+ y 6) (+ x 27 (c/text-width c/mono shown)) (+ y 21) c/ink 0.7 0.0))
      (let [live-mode (= (:mode play) :live)
            spans (:spans sched)
            entries (:entries v)
            ;; Since the last entry was done: for how long what goes now has gone.
            since (if live-mode
                    (let [last-e (peek entries)]
                      (if (and (:born v) last-e (:ended last-e))
                        (- (cpp/harness.seconds) (:born v) (:ended last-e))
                        0.0))
                    (let [k (count (:entries seen))
                          span (when (< k (count spans)) (nth spans k))]
                      (if span
                        (max 0.0 (* (- (:real-to span) (:real-from span))
                                    (min 1.0 (/ (max 0.0 (- (:t play) (:from span)))
                                                (max 0.001 (- (:to span) (:from span)))))))
                        0.0)))
            said (if live-mode
                   (get state-said state (str state))
                   (doing-at v sched (:t play)))
            phase (- now (* 1.2 (long (/ now 1.2))))
            pulse (if (< phase 0.6) (/ phase 0.6) (/ (- 1.2 phase) 0.6))]
        (when going
          (c/circle! (+ x 6) (+ y 13) 4.0 c/orange (+ 0.25 (* 0.75 pulse)) ))
        (c/text! (+ x 18) (+ y 6) (if going c/orange c/muted) c/small
                 (str said (when (and going (>= since 1.0)) (str "  (" (long since) " s)"))))))))

(defn- small-height
  "The whole's height when it is not expanded: nothing it holds changes it."
  []
  (if (empty? @watched) 0 (min small (max 200 (- (c/window-height) above below)))))

(defn- modal?
  "Whether the modal is open."
  []
  (boolean (and @expanded (seq @watched) @chosen)))

(defn- panel
  "What is drawn this frame in `width` by `height`: {:rows :first :many :items :tall :shown
  :value :sched :play :height}."
  [width height most-rows]
  (let [kept @frame-panel
        frame (c/frames)]
    (if (and kept (= (:frame kept) frame) (= (:width kept) width) (= (:height kept) height))
      (:panel kept)
      (let [all @watched
            many (long (count all))
            in-view (min many most-rows)
            from (long (max 0.0 (min (- many in-view) @rows-from)))
            named @chosen
            one (some (fn [w] (when (= (:name w) named) w)) all)
            v (when one @(:agent one))
            sched (when one (schedule-of named (:entries v)))
            play (when one (advance! named v sched))
            ;; Following the end, the conversation as it is; else as it was at that time.
            seen (when one (if (= (:mode play) :live) v (at-time v (:t play) sched)))
            its (when one (items named seen (- width 28)))
            tall (if its (apply + 0 (map :h its)) 0)
            rows-h (* row in-view)
            ;; The height is given: the conversation gets what is left of it.
            shown (if one (max 24 (- height rows-h 30 bar status)) 0)
            made {:rows (subvec all from (+ from in-view)) :first from :many many :seen seen
                  :one one :items its :tall tall :shown shown
                  :value v :sched sched :play play :height height}]
        (reset! frame-panel {:frame frame :width width :height height :panel made})
        made))))

(defn- draw-row [w x y width picked]
  (let [v @(:agent w)
        state (:state v)
        dot (cond (going? state) c/orange
                  (contains? #{:done :idle} state) c/green
                  :else c/red)
        speed (if (pos? (:seconds v)) (/ (:generated v) (:seconds v)) 0.0)
        right (str (:generated v) " tokens" (when (pos? speed) (str ", " (c/fixed speed 1) " a second")))]
    (when (or picked (c/inside? x y (+ x width) (+ y row -2)))
      (c/rect! x y (+ x width) (+ y row -2) c/rule (if picked 0.45 0.2) 5.0))
    (c/circle! (+ x 14) (+ y 13) 5.0 dot 1.0)
    (c/text! (+ x 28) (+ y 5) c/ink c/mono (:name w))
    (c/text! (+ x 36 (c/text-width c/mono (:name w))) (+ y 7) c/muted c/small
             (get state-said state (str state)))
    (c/text! (- (+ x width) (c/text-width c/small right) 10) (+ y 7) c/muted c/small right)
    (when (c/clicked? x y (+ x width) (+ y row -2))
      (reset! chosen (:name w)))))

(defn- to-time!
  "The conversation `named` shown up to `t`, playing on from there or not."
  [named t playing]
  (swap! plays (fn [all]
                 (let [p (get all named {:speed 1.0})]
                   (assoc all named {:mode (if playing :playing :paused) :t t :at (c/seconds)
                                     :speed (get p :speed 1.0)})))))

(defn- live!
  "The conversation `named` shown as it is now, following its turn."
  [named]
  (swap! plays (fn [all] (assoc all named {:mode :live :speed (get (get all named) :speed 1.0)}))))

(defn- axis
  "The seconds the timeline's whole line stands for. While a turn goes it grows by doubling,
  so that the marks stay where they are between one doubling and the next."
  [total running]
  (if running
    (loop [span 30.0] (if (>= span total) span (recur (* 2.0 span))))
    (max 0.001 total)))

(defn- draw-bar
  "The timeline of the conversation `named`, its top left at (x, y): play or pause, from
  the start, to the next entry's end, the line with a mark an entry and where it is shown
  up to, the time since it began with what was going on, the pace, and expand. `pressed`:
  the mouse's button went down in this frame; `modal`: drawn in the modal. Returns where its
  parts are, for a script."
  [named v sched play x y width pressed modal]
  (let [total (max 0.001 (:total sched))
        t (min total (:t play))
        mode (:mode play)
        live (= mode :live)
        running (going? (:state v))
        following (and live running)
        speed (get play :speed 1.0)
        cy (+ y 18)
        b1 (+ x 16)
        b2 (+ x 44)
        b3 (+ x 72)
        x1 (+ x 104)
        x2 (- (+ x width) 310)
        scale (axis total running)
        x-of (fn [s] (+ x1 (* (- x2 x1) (min 1.0 (/ s scale)))))
        at (x-of t)
        spans (:spans sched)
        entries (:entries v)
        pace-x (- (+ x width) 102)
        e1 (- (+ x width) 78)
        e2 (- (+ x width) 10)
        talls {:user 9 :model 8 :call 5 :stopped 9}
        ;; A mark a step: a person's message, a tool's call with what it gave, an answer of
        ;; the model's, a stop. It is where the step is done (a call's: its result); a click
        ;; there shows the step from its start.
        marks (loop [i 0 start 0 out []]
                (if (>= i (count spans))
                  out
                  (let [role (:role (nth entries i))
                        ;; A call's step ends with what it gave.
                        end (if (and (= role :call) (< (inc i) (count spans))
                                     (= (:role (nth entries (inc i))) :result))
                              (inc i)
                              i)]
                    (if (contains? talls role)
                      (recur (inc end) (inc end)
                             (conj out {:x (x-of (:to (nth spans end))) :to (:to (nth spans end)) :entry i :start start}))
                      (recur (inc i) start out)))))
        hot (fn [bx] (c/inside? (- bx 12) (- cy 12) (+ bx 12) (+ cy 12)))
        hit (fn [bx] (c/clicked? (- bx 12) (- cy 12) (+ bx 12) (+ cy 12)))
        shade (fn [bx] (when (hot bx) (c/rect! (- bx 12) (- cy 12) (+ bx 12) (+ cy 12) c/rule 0.35 5.0)))]
    (c/line! (+ x 10) y (- (+ x width) 10) y c/rule 1.0)
    ;; Play, or pause while playing.
    (shade b1)
    (if (or (= mode :playing) following)
      (do (c/rect! (- b1 5) (- cy 6) (- b1 1) (+ cy 6) c/ink 1.0 1.0)
          (c/rect! (+ b1 2) (- cy 6) (+ b1 6) (+ cy 6) c/ink 1.0 1.0))
      (c/triangle! (- b1 4) (- cy 7) (- b1 4) (+ cy 7) (+ b1 7) cy c/ink 1.0))
    (when (hit b1)
      (cond
        (or (= mode :playing) following) (to-time! named t false)
        ;; At the end: on with the turn when one goes, else from the start again.
        (>= t (- total 0.01)) (if running (live! named) (to-time! named 0.0 true))
        :else (to-time! named t true)))
    ;; From the start.
    (shade b2)
    (c/rect! (- b2 6) (- cy 6) (- b2 3) (+ cy 6) c/ink 1.0 1.0)
    (c/triangle! (+ b2 6) (- cy 7) (+ b2 6) (+ cy 7) (- b2 3) cy c/ink 1.0)
    (when (hit b2)
      (to-time! named 0.0 true))
    ;; To the end of the next entry, and stop there.
    (shade b3)
    (c/triangle! (- b3 6) (- cy 7) (- b3 6) (+ cy 7) (+ b3 3) cy c/ink 1.0)
    (c/rect! (+ b3 3) (- cy 6) (+ b3 6) (+ cy 6) c/ink 1.0 1.0)
    (when (hit b3)
      (let [after (first (filter (fn [m] (> (:to m) (+ t 0.01))) marks))]
        (when after
          (swap! pending assoc named (:start after)))
        (to-time! named (if after (:to after) total) false)))
    ;; The line: what is shown so far darker, a mark an entry, a gap where a wait was cut.
    (c/line! x1 cy x2 cy c/rule 2.0)
    (c/line! x1 cy at cy c/ink 2.0)
    (doseq [s spans]
      (when (:cut s)
        (let [mx (x-of (:from s))]
          (c/rect! (- mx 4) (- cy 2) (- mx 1) (+ cy 2) c/card 1.0 0.0)
          (c/line! (- mx 5) (+ cy 4) (- mx 2) (- cy 4) c/muted 1.0)
          (c/line! (- mx 3) (+ cy 4) mx (- cy 4) c/muted 1.0))))
    (doseq [m marks]
      (let [role (:role (nth entries (:entry m)))
            tall (get talls role 0)
            color (get {:user c/ink :model c/blue :call c/orange :stopped c/red} role c/muted)]
        (c/line! (:x m) (- cy tall) (:x m) (+ cy tall) color 2.0)))
    (c/circle! at cy 5.0 (if live c/orange c/ink) 1.0)
    ;; Pressed on the line: that time, for as long as the button is held, wherever the mouse
    ;; goes meanwhile. Let go, it plays on if it was playing.
    (when (and pressed (c/inside? (- x1 6) (- cy 12) (+ x2 6) (+ cy 12)))
      (reset! held {:what :timeline :name named :playing (or (= mode :playing) following)}))
    (let [h @held]
      (when (and (= (:what h) :timeline) (= (:name h) named))
        (let [mx (c/mouse-x)
              asked (* scale (max 0.0 (min 1.0 (/ (- mx x1) (- x2 x1)))))
              near (fn [m] (let [d (- mx (:x m))] (if (neg? d) (- d) d)))
              mark (reduce (fn [best m]
                             (if (and (< (near m) 5) (or (nil? best) (< (near m) (near best)))) m best))
                           nil marks)
              to (if mark (:to mark) (min total asked))]
          (if (c/down?)
            (to-time! named to false)
            (do (reset! held nil)
                ;; (The last mark is the end: there the end is followed.)
                (when (and mark (not= mark (peek marks)))
                  (swap! pending assoc named (:start mark)))
                ;; (At the turn's end or past it, while it goes, is now.)
                (if (and running (>= asked (* 0.985 total)))
                  (live! named)
                  (to-time! named to (:playing h))))))))
    ;; The modal opened, or closed.
    (c/rect! e1 (- cy 12) e2 (+ cy 12) c/rule (if (c/inside? e1 (- cy 12) e2 (+ cy 12)) 0.55 0.3) 5.0)
    (let [label (if modal (str "close") (str "expand"))]
      (c/text! (+ e1 (/ (- e2 e1 (c/text-width c/small label)) 2.0)) (- cy 7) c/ink c/small label))
    (when (c/clicked? e1 (- cy 12) e2 (+ cy 12))
      (reset! expanded (not modal)))
    ;; The time since the conversation began, and what was going on.
    (let [since (if (and live (:born v) (going? (:state v)) (seq spans))
                  (- (cpp/harness.seconds) (:born v) (:real-from (first spans)))
                  (real-at sched t))
          now-said (get state-said (:state v) (str (:state v)))
          said (cond following (str "live, " now-said)
                     live now-said
                     :else (doing-at v sched t))]
      (c/text! (+ x2 16) (- cy 8) c/ink c/mono (minutes since))
      (c/text! (+ x2 22 (c/text-width c/mono (minutes since))) (- cy 6) c/muted c/small
               (c/clip c/small (- pace-x x2 44 (c/text-width c/mono (minutes since))) said)))
    ;; The pace of playing: a click doubles it, up to 8, then 1 again.
    (shade pace-x)
    (c/text! (- pace-x 9) (- cy 7) c/muted c/small (str (long speed) "x"))
    (when (hit pace-x)
      (swap! plays (fn [all]
                     (let [p (get all named {:mode :live})
                           faster (if (>= speed 8.0) 1.0 (* 2.0 speed))]
                       (assoc all named (assoc p :speed faster :at (c/seconds)))))))
    {:y cy :play b1 :start b2 :next b3 :x1 x1 :x2 x2 :pace pace-x :total total :t t
     :expand (/ (+ e1 e2) 2.0) :axis scale :marks marks
     :mode (subs (str mode) 1)}))

(defn- draw-panel [x y width height modal]
  (let [p (panel width height (if modal rows-large rows-small))
        rows (:rows p)
        over-rows (and (> (:many p) (count rows))
                       (c/inside? x y (+ x width) (+ y 4 (* row (count rows)))))
        down (c/down?)
        pressed (and down (not @was-down))]
    (reset! was-down down)
    (when (seq rows)
      (c/rect! x y (+ x width) (+ y (:height p)) c/card 1.0 6.0)
      (c/frame! x y (+ x width) (+ y (:height p)) c/rule 1.0)
      (doseq [[i w] (map-indexed vector rows)]
        (draw-row w (+ x 4) (+ y 4 (* row i)) (- width 8) (= (:name w) @chosen)))
      ;; More conversations than lines: which are in view, and the wheel over them.
      (when (> (:many p) (count rows))
        (let [n (:many p)
              in-view (long (count rows))
              track (* row in-view)
              tall (* track (/ (* 1.0 in-view) n))
              at (+ y 4 (* track (/ (* 1.0 (:first p)) n)))]
          (c/rect! (- (+ x width) 5) at (- (+ x width) 2) (+ at tall) c/muted 0.55 3.0)
          (when over-rows
            (swap! rows-from (fn [f] (max 0.0 (min (* 1.0 (- n in-view)) (- (min (* 1.0 (- n in-view)) f) (c/wheel)))))))))
      (when (:one p)
        (let [named (:name (:one p))
              top (+ y 4 (* row (count rows)) 10)
              shown (:shown p)
              tall (:tall p)
              furthest (max 0.0 (- tall shown))
              right (+ x width)
              bottom (+ top shown)
              over (c/inside? x top right bottom)
              kept (get @scrolls named)
              before (if kept (min furthest kept) furthest)
              turned (if (and (not over-rows) (c/inside? x y right (+ y (:height p)))) (c/wheel) 0.0)
              ;; The bar on the right: where the part shown is, of the whole. It drags.
              thumb (if (pos? furthest) (max 28.0 (* shown (/ shown tall))) 0.0)
              free (max 1.0 (- shown thumb))
              thumb-y (fn [offset] (if (pos? furthest) (+ top (* free (/ offset furthest))) top))
              _ (when (and pressed (pos? furthest) (c/inside? (- right 13) top right bottom))
                  (let [ty (thumb-y before)
                        my (c/mouse-y)]
                    (reset! held {:what :scroll :name named
                                  :grab (if (and (>= my ty) (<= my (+ ty thumb))) (- my ty) (/ thumb 2.0))})))
              dragged (let [h @held] (when (and (= (:what h) :scroll) (= (:name h) named)) h))
              step (get @pending named)
              _ (when step (swap! pending dissoc named))
              wanted (cond
                       ;; A step gone to: from its start.
                       step (loop [its (:items p) at 0.0]
                              (if (or (empty? its) (>= (second (:key (first its))) step))
                                at
                                (recur (rest its) (+ at (:h (first its))))))
                       dragged (* furthest (/ (- (c/mouse-y) (:grab dragged) top) free))
                       (and (pos? furthest) (or (pos? turned) (neg? turned))) (- before (* 48.0 turned))
                       :else nil)
              looked (if wanted (max 0.0 (min furthest wanted)) before)
              ;; Shorter than the part shown, it sits at the bottom, as in a terminal.
              start (if (pos? furthest) (- top looked) (+ top (- shown tall)))
              behind (< looked (- furthest 1.0))
              mid (+ x (/ width 2.0))
              lx1 (- mid 68)
              lx2 (+ mid 68)
              ly1 (- bottom 30)
              ly2 (- bottom 6)
              on-latest (and behind (c/inside? lx1 ly1 lx2 ly2))]
          (when wanted
            ;; At the end again, it is followed.
            (if behind
              (swap! scrolls assoc named looked)
              (swap! scrolls dissoc named)))
          (when (and dragged (not down))
            (reset! held nil))
          (c/line! (+ x 10) (- top 6) (- (+ x width) 10) (- top 6) c/rule 1.0)
          (c/clip-begin! x top (+ x width) (+ top shown))
          (let [toggles
                (loop [its (:items p) at start out []]
                  (if (empty? its)
                    out
                    (let [item (first its)
                          h (:h item)
                          seen (and (> (+ at h) top) (< at (+ top shown)))
                          drawn-ts (when seen ((:draw item) (+ x 14) at (- width 28)))
                          here (vec (for [t drawn-ts
                                          :let [ty (+ at (:y t))]
                                          :when (and (:key item) (>= ty top) (<= (+ ty line-small) (+ top shown)))]
                                      (assoc t :entry (second (:key item)) :key (:key item) :ty ty)))]
                      (doseq [t here]
                        ;; Only the words answer, not the whole line: a click that brings the
                        ;; window to the front opens nothing.
                        (let [ty (:ty t)
                              tx (:x t)
                              tx2 (+ tx (c/text-width c/small (:label t)) 4)]
                          (when (and over (not on-latest) (c/inside? (- tx 4) ty tx2 (+ ty line-small)))
                            (c/line! tx (+ ty line-small -2) (- tx2 4) (+ ty line-small -2) c/blue 1.0))
                          (when (and over (not on-latest) (c/clicked? (- tx 4) ty tx2 (+ ty line-small)))
                            ;; What is looked at stays: opened, it grows below the line clicked.
                            (swap! scrolls assoc named looked)
                            (swap! unfolded update (:key t)
                                   (fn [parts] (let [parts (or parts #{})]
                                                 (if (contains? parts (:part t)) (disj parts (:part t)) (conj parts (:part t)))))))))
                      (recur (rest its) (+ at h) (into out here)))))
                _ (c/clip-end!)
                _ (draw-status (:seen p) (:value p) (:sched p) (:play p) (+ x 14) (+ top shown 2) (- width 28))
                timeline (draw-bar named (:value p) (:sched p) (:play p) x (+ top shown status 8) width pressed modal)
                now-drawn {:x x :y y :modal (boolean modal) :width width :top top :shown shown :tall tall :folds [] :toggles (mapv (fn [t] {:entry (:entry t) :part (subs (str (:part t)) 1) :x (+ (:x t) 10) :y (+ (:ty t) (/ line-small 2.0)) :open (:open t)}) toggles)
                           :bar timeline :height (:height p) :looked looked :furthest furthest
                           :latest (when behind {:x (/ (+ lx1 lx2) 2.0) :y (/ (+ ly1 ly2) 2.0)})
                           :anchored (and (not (pos? furthest)) (pos? tall))
                           :rows (vec (map-indexed (fn [i w] {:name (:name w) :y (+ y 4 (* row i) (quot row 2))}) rows))}]
            (when (not= now-drawn @drawn)
              (reset! drawn now-drawn)))
          (when (pos? furthest)
            (let [at (thumb-y looked)
                  near (or dragged (c/inside? (- right 13) top right bottom))
                  left (if near (- right 10) (- right 7))]
              (c/rect! left top (- right 3) bottom c/rule 0.2 3.0)
              (c/rect! left at (- right 3) (+ at thumb) c/muted (if near 0.8 0.55) 3.0)))
          (when behind
            (c/rect! lx1 ly1 lx2 ly2 c/card 1.0 11.0)
            (c/rect! lx1 ly1 lx2 ly2 c/rule 0.35 11.0)
            (c/text! (+ lx1 12) (+ ly1 5) c/ink c/small (str "Jump to latest"))
            (c/triangle! (- lx2 22) (+ ly1 9) (- lx2 12) (+ ly1 9) (- lx2 17) (+ ly1 16) c/ink 1.0)
            (when (c/clicked? lx1 ly1 lx2 ly2)
              (swap! scrolls dissoc named))))))))

(defn- draw-small
  "The panel among the cards: always as tall. Under the modal, only its place."
  [x y width]
  (let [height (small-height)]
    (if (modal?)
      (do (c/rect! x y (+ x width) (+ y height) c/card 1.0 6.0)
          (c/frame! x y (+ x width) (+ y height) c/rule 1.0))
      (draw-panel x y width height false))))

(defn- draw-modal
  "The panel over the dimmed window. Esc, or a click outside it, closes it."
  [window-w window-h]
  (let [x margin
        y margin
        w (- window-w (* 2 margin))
        h (- window-h (* 2 margin))
        outside (not (c/inside? x y (+ x w) (+ y h)))
        down (c/down?)]
    (when (and down (not @was-down) outside)
      (reset! held {:what :outside}))
    (c/rect! 0 0 window-w window-h c/ink 0.4 0.0)
    (draw-panel x y w h true)
    (when (and (not down) (= (:what @held) :outside))
      (reset! held nil)
      (when outside
        (reset! expanded false)))
    (when (c/escape?)
      (reset! expanded false))))

(c/header! {:height (fn [width] (small-height))
            :draw draw-small})

(c/overlay! {:shown? modal? :draw draw-modal})

(defn watch!
  "The agent in the window, as the conversation called `named` (\"agent\" when not given):
  a line above the cards, and the conversation written out when it is the one chosen (it is
  now). Returns the agent."
  ([a] (watch! a "agent"))
  ([a named]
   (let [named (str named)]
     (swap! watched (fn [all] (conj (vec (remove (fn [w] (= (:name w) named)) all)) {:name named :agent a})))
     (reset! chosen named)
     ;; (Its line, the last, in view.)
     (reset! rows-from (* 1.0 (count @watched)))
     a)))

(defn unwatch!
  "A conversation's line removed (all of them with no name)."
  ([] (reset! watched []) (reset! chosen nil) nil)
  ([named]
   (swap! watched (fn [all] (vec (remove (fn [w] (= (:name w) (str named))) all))))
   (when (= @chosen (str named))
     (reset! chosen nil))
   nil))

(defn choose!
  "The conversation written out: its name, or nil for the lines alone."
  [named]
  (reset! chosen (when named (str named)))
  nil)

(defn unfold!
  "Parts of a conversation's entries shown whole (`whole` true) or by their first lines, as
  a click on \"... more lines\" does. `which`: :all, :none, or the entries' numbers (their
  places in (h/entries a))."
  ([named which] (unfold! named which true))
  ([named which whole]
   (let [named (str named)
         a (:agent (some (fn [w] (when (= (:name w) named) w)) @watched))
         n (if a (count (:entries @a)) 0)
         chosen-entries (cond (= which :all) (range n) (= which :none) (range n) :else which)
         whole (and whole (not= which :none))]
     (swap! unfolded (fn [m] (reduce (fn [m i] (if whole (assoc m [named i] #{:text :args :out}) (dissoc m [named i])))
                                     m chosen-entries)))
     nil)))

(defn expand!
  "The conversation opened over the window as a modal (or closed), as the timeline's button
  does."
  ([] (expand! true))
  ([whole] (reset! expanded (boolean whole)) nil))

(defn replay!
  "A conversation that was kept, shown and played from its start: `recording` is what
  harness.core/recording gives, or the path of a file harness.core/save! wrote. The model
  is not needed. It is called `named`, else by its file's name. Returns nil (the atom
  holding it is the conversation's: (hc/conversation named))."
  ([recording] (replay! recording (if (string? recording)
                                    (str/replace (last (str/split recording #"/")) ".edn" "")
                                    (str "a recording"))))
  ([recording named]
   (let [r (if (string? recording) (h/load-recording recording) recording)
         a (atom (assoc r
                        :live nil
                        :state (or (:state r) :done)
                        :generated (or (:generated r) 0)
                        :seconds (or (:seconds r) 0.0)))]
     (watch! a named)
     (swap! scrolls dissoc (str named))
     (to-time! (str named) 0.0 true)
     nil)))

(defn conversation
  "The atom of the conversation watched as `named` (an agent, or a replay's)."
  [named]
  (:agent (some (fn [w] (when (= (:name w) (str named)) w)) @watched)))

(defn play!
  "The conversation `named` played from where it is shown up to (from its start when that
  is its end)."
  [named]
  (let [named (str named)
        p (get @plays named {:mode :live})]
    (to-time! named (if (= (:mode p) :paused) (:t p) 0.0) true)
    nil))

(defn seek!
  "The conversation `named` shown up to a share of its length (0 its start, 1 its end), and
  stopped there."
  [named share]
  (let [named (str named)
        a (:agent (some (fn [w] (when (= (:name w) named) w)) @watched))
        total (if a (:total (schedule-of named (:entries @a))) 0.0)]
    (to-time! named (* total (max 0.0 (min 1.0 share))) false)
    nil))

(defn follow!
  "The conversation `named` shown as it is now, following a turn in progress."
  [named]
  (live! (str named))
  nil)

(defn layout
  "Where the chosen conversation was drawn in the last frame, as JSON text, for a script
  that points at its parts (cards.core/click!, wheel!): {x, width, top, shown, tall, rows:
  [{name, y}], bar: {y, play, start, next, x1, x2, pace, total, t, mode, marks}, looked,
  furthest, latest, anchored}, in the window's points. `bar` is the timeline: its buttons are
  at (play, y), (start, y), (next, y), its line from x1 to x2, a step's mark at (x, y).
  `toggles`: the lines in view that open or close a long part ({entry, part, x, y, open}: a
  click there). (`folds` is always empty.)"
  []
  (json/write (or @drawn {})))

;; A script's look at the layout is not an evaluation to show.
(window/quiet! "harness.cards/layout")
