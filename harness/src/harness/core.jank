;; SPDX-License-Identifier: MIT
;; An agent on the inkling engine: a conversation in a session, tools the model can call, and
;; the loop that runs its turns.
;;
;;   (require '[inkling.core :as ink] '[harness.core :as h] '[harness.tools :as tools])
;;   (def m (ink/open "../inkling/models/inkling-2-mini.ink"))
;;   (def a (h/agent m {:tools (tools/defaults)}))
;;   (h/ask! a "How many layers do you have? Look, don't guess.")
;;   (h/answer a)
;;
;; The conversation is written the way the model was trained on: frames opened and closed by
;; special tokens. A frame's content is always tokenized as ordinary text, and the model's
;; output is split by token id, so nothing a person, a tool or the model writes can be taken
;; for a frame's boundary.
;;
;;   <|message_system|>tool_declare<|content_xml|>[the tools, as JSON]<|end_message|>
;;   <|message_system|><|content_text|>Thinking effort level: 0.9<|end_message|>
;;   <|message_user|><|content_text|>...<|end_message|>
;;   <|message_model|><|content_thinking|>...<|end_message|>
;;   <|message_model|>name<|content_invoke_tool_json|>{"name":"name","args":{...}}<|end_message|>
;;   <|content_model_end_sampling|>
;;   <|message_tool|>name<|content_text|>the result<|end_message|>
;;   <|message_model|><|content_text|>...<|end_message|><|content_model_end_sampling|>
;;
;; A tool is a function with a name, a description and parameters. The model calls it with
;; JSON arguments (the form it was trained on, and escapes correctly); the harness decodes
;; them and calls the function with plain values, so a tool never deals with escaping.
;;
;; Nothing here is sandboxed: a tool runs with this process's rights. Whoever starts the
;; process decides what it may touch.
(ns harness.core
  (:refer-clojure :exclude [agent])
  (:require [clojure.string :as str]
            [inkling.core :as ink]
            [harness.json :as json]
            ;; A large stack for a tool's call (the window library's part that needs no window).
            [cards.repl :as repl]))

;; Tools.

(defn tool
  "A tool, checked: a map of
    :name      what the model calls it by
    :doc       what it does, as the model is told
    :params    {:path {:type \"string\" :doc \"...\"} ...} (types: string, integer, number,
               boolean, array, object; string when not said)
    :required  the parameters a call must give (all of them when not said)
    :fn        (fn [args]): args is the call's arguments, a map with keyword keys. What it
               returns is the result the model reads: a string as it is, anything else as it
               prints. Throwing is an error the model is told of.
    :limit     characters of a result the model is given (8000 when not said)
    :reads-only  true when the tool only reads (no effects): a result the same as an earlier
               call's (the same arguments) is then said to be in the conversation already,
               not given again. A tool with effects always gives its result."
  [t]
  (when-not (and (string? (:name t)) (seq (:name t)))
    (throw (ex-info "a tool needs a :name" {:tool t})))
  (when-not (fn? (:fn t))
    (throw (ex-info (str "the tool " (:name t) " needs a :fn") {:tool (:name t)})))
  (let [params (or (:params t) {})]
    (assoc t
           :doc (str (:doc t))
           :params params
           :required (vec (or (:required t) (keys params)))
           :limit (or (:limit t) 8000))))

(defn- kind-of
  "A parameter's JSON type from its tag (^long n, ^double x, ^boolean b), else string."
  [param]
  (let [tag (str (:tag (meta param)))]
    (or (some (fn [[part kind]] (when (str/includes? tag part) kind))
              [["long" "integer"] ["int" "integer"] ["double" "number"] ["bool" "boolean"]])
        "string")))

(defn wrap
  "A function's var as a tool: (wrap #'read-file). Its name is the tool's, its docstring the
  description, and its parameters the tool's parameters, by name: the function is called
  with the call's arguments in its own order. A parameter is a string unless tagged (^long,
  ^double, ^boolean). `opts` may give :name, :doc, :limit, :params (per parameter, a
  description, or {:type \"integer\" :doc \"...\"} to say its type without a tag) and
  :optional [names] (parameters a call may leave out: the function gets nil for them, so
  they can't be tagged), and :reads-only (see `tool`)."
  ([v] (wrap v {}))
  ([v opts]
   (let [said (meta v)
         names (first (:arglists said))
         f (deref v)
         full (str v)
         optional (set (map keyword (:optional opts)))]
     (when (some (fn [p] (not (symbol? p))) names)
       (throw (ex-info (str "wrap: " full " takes something other than named parameters") {})))
     (tool {:name (or (:name opts) (subs full (inc (str/index-of full "/"))))
            :doc (or (:doc opts) (:doc said))
            :limit (:limit opts)
            :reads-only (boolean (:reads-only opts))
            :params (into {} (map (fn [p]
                                    (let [k (keyword (str p))
                                          about (get (:params opts) k)]
                                      [k (cond
                                           (map? about) (merge {:type (kind-of p)} about)
                                           about {:type (kind-of p) :doc about}
                                           :else {:type (kind-of p)})]))
                                  names))
            :required (vec (remove optional (map (fn [p] (keyword (str p))) names)))
            :fn (fn [args] (apply f (map (fn [p] (get args (keyword (str p)))) names)))}))))

(defn- declared
  "A tool as the model is told of it."
  [t]
  {:type "function"
   :name (:name t)
   :description (:doc t)
   :parameters {:type "object"
                :properties (into {} (map (fn [[k p]]
                                            [k (if (:doc p)
                                                 {:type (get p :type "string") :description (:doc p)}
                                                 {:type (get p :type "string")})])
                                          (:params t)))
                :required (mapv (fn [k] (subs (str k) 1)) (:required t))}})

;; Frames.

(def ^:private pieces
  {:system "<|message_system|>" :user "<|message_user|>" :model "<|message_model|>"
   :tool "<|message_tool|>" :text "<|content_text|>" :thinking "<|content_thinking|>"
   :xml "<|content_xml|>" :call "<|content_invoke_tool_json|>"
   :call-text "<|content_invoke_tool_text|>" :tool-error "<|content_tool_error|>"
   :end "<|end_message|>" :end-turn "<|content_model_end_sampling|>"})

(def efforts
  "Thinking effort by name, as the model's publisher writes it."
  {:none "0" :minimal "0.1" :low "0.2" :medium "0.7" :high "0.9" :max "0.99"})

(defn- plain
  "A text's tokens, none of them special: a special token's spelling in it is text."
  [m text]
  (vec (ink/tokenize m (str text) false)))

(defn- frame
  "A frame's tokens: who speaks, a name after it or nil, the kind of content, the content."
  [a role named kind text]
  (let [{:keys [model ids]} a]
    (vec (concat [(get ids role)]
                 (when (seq named) (plain model named))
                 [(get ids kind)]
                 (plain model text)
                 [(get ids :end)]))))

;; The agent a tool is running for: a tool, or code the eval tool evaluates, finds the
;; conversation it is part of with (h/me).
(def ^:dynamic *agent* nil)

(defn me
  "Inside a tool's call (code given to the eval tool included): the agent the call is made
  for, as {:agent :model :session}. nil anywhere else."
  []
  (when *agent*
    (let [a @*agent*]
      {:agent *agent* :model (:model a) :session (:session a)})))

(declare summarize)

(defn agent
  "An agent on model `m`: an atom holding its session, its tools and its conversation.
    :tools       tools (`tool`, `wrap`): none when not given
    :system      what the model is told before anything else
    :effort      how much it thinks: :none :minimal :low :medium :high :max (:high, the
                 publisher's own default)
    :context     tokens the session has room for (16384)
    :sampling    as ink/sample takes: {:temperature :top-p :top-k :seed} (greedy)
    :max-tokens  tokens a step may generate (4096)
    :max-thinking tokens one stretch of thinking may take (1536): at that, the harness
                 closes the thinking and the model goes on from what it has thought
    :max-steps   steps a turn may take: a step is the model speaking, then its calls (24)
    :on-entry    (fn [entry]) called with each entry as it is added to the conversation
    :obligations (fn [agent]) asked when the model answers without calling anything: nil
                 when the work is done, else what isn't (harness.verify/gate checks a file
                 against its model). Then that is said to the model and the turn goes on.
    :max-checks  times the obligations may send the model back in a turn (6)
    :compact     (fn [agent preparation]) what the conversation's older part becomes when the
                 session nears its end: a summary's text, or nil to leave it as it is. By
                 default `summarize` (the model writes a summary); nil turns compaction off
                 (the turn then ends when the session is full). See `compact!`.
    :compact-reserve tokens kept free before compacting (15% of the context, at least
                 16384, at most a quarter of it)
    :compact-keep    recent tokens kept as they are beside the summary (15000, at most 20%
                 of the context: the summary is ready only after the agent has added more)
    :summary-result-chars, :summary-thinking-chars  how much of each tool result (2000) and
                 of each stretch of thinking (all) the summary is written from: less is faster
                 (a game's results are its state, soon old)
    :draft       drafting (inkling.core/speculate!): from the context, {:least 6 :most 15}
                 by default, nil off; with :model K also with the draft model, up to K
                 tokens a check (inkling.core/draft-model!). The tokens are the same either
                 way; text that repeats the context comes sooner. The draft model pays on
                 code at low temperature; an agent's turn at temperature 1, mostly thinking,
                 measured 5% slower with it (38.1 against 40.2 tokens/s), so it is off.
  The tools and the system text are evaluated now, so the first question starts from them."
  ([m] (agent m {}))
  ([m {:keys [tools system effort context sampling max-tokens max-thinking max-steps on-entry
              obligations max-checks compact-reserve compact-keep draft summary-result-chars
              summary-thinking-chars] :as opts}]
   (let [tools (mapv tool tools)
         ids (into {} (map (fn [[k piece]] [k (ink/token-id m piece)]) pieces))
         size (or context 16384)
         s (ink/session m size)
         a {:model m :session s :ids ids
            :tools tools
            :effort (get efforts (or effort :high) (str effort))
            :sampling (or sampling {})
            :max-tokens (or max-tokens 4096)
            :max-thinking (or max-thinking 1536)
            :max-steps (or max-steps 24)
            :on-entry on-entry
            :obligations obligations
            :max-checks (or max-checks 6)
            :compact (if (contains? opts :compact) (:compact opts) summarize)
            :draft (if (contains? opts :draft) draft {:least 6 :most 15})
            :compact-reserve (or compact-reserve
                                 (long (min (* 0.25 size) (max 16384.0 (* 0.15 size)))))
            :compact-keep (or compact-keep (long (min 15000.0 (* 0.2 size))))
            :summary-result-chars (or summary-result-chars 2000)
            :summary-thinking-chars summary-thinking-chars
            ;; :entries is the whole conversation; :view what the model sees of it (the
            ;; same, until a compaction puts a summary in place of its older part).
            :entries [] :view [] :state :idle :live nil :stop false :turn nil
            ;; The model's steps so far: each entry is marked with the step it is part of.
            :step-count 0
            :generated 0 :seconds 0.0
            ;; When the agent was made: an entry's times are seconds since then.
            :born (cpp/harness.seconds)}
         start (vec (concat (when (seq tools)
                              (frame a :system "tool_declare" :xml (json/write (mapv declared tools))))
                            (when (seq system)
                              (frame a :system nil :text system))))]
     ;; The draft model reads the hidden states of every token evaluated from now on.
     (when-let [depth (:model (:draft a))]
       (ink/draft-model! s depth))
     (when (seq start)
       (ink/eval! s start))
     (atom (assoc a :effort-said false :start start)))))

(defn close!
  "The agent's session freed (and a compaction's being made apart, once it is done). A turn
  in progress is stopped first."
  [a]
  (swap! a assoc :stop true)
  (when-let [turn (:turn @a)]
    (deref turn))
  (when-let [c (:compaction @a)]
    (when-let [s (:session @c)]
      (ink/free! s))
    (swap! a assoc :compaction nil))
  (when (ink/session? (:session @a))
    (ink/free! (:session @a)))
  nil)

(defn- clock
  "Seconds since the agent was made."
  [a]
  (let [born (:born @a)]
    (if born (- (cpp/harness.seconds) born) 0.0)))

(defn- told!
  "The agent's :on-entry told of an entry (what it throws is not the turn's business)."
  [a entry]
  (when-let [told (:on-entry @a)]
    (try
      (told entry)
      (catch jank.runtime.object_ref _ nil)
      (catch cpp/jank.error_ref _ nil)
      (catch cpp/std.exception _ nil)
      (catch :default _ nil)))
  entry)

(defn- entry!
  "An entry added to the conversation."
  [a entry]
  (let [entry (assoc entry :step (:step-count @a))]
    (swap! a (fn [v] (assoc v :entries (conj (:entries v) entry) :view (conj (:view v) entry) :live nil)))
    (told! a entry)))

;; The model speaking.

(defn- wrote!
  "A frame the model finished, in the conversation as soon as it is: its thinking and its
  words. A call's entry is added when it is run, beside its result. Returns the frame."
  [a f]
  (let [times {:began (:began f) :ended (:ended f)}]
    (case (:kind f)
      :thinking (entry! a (merge (if (:cut f)
                                   {:role :thinking :text (:text f) :cut true}
                                   {:role :thinking :text (:text f)})
                                 times))
      :text (when (seq (str/trim (:text f)))
              (entry! a (merge {:role :model :text (:text f)} times)))
      nil))
  f)

(defn repeating?
  "Whether thinking `text` goes round in the same words: a sentence of 30 characters or more
  said three times."
  [text]
  (let [parts (remove (fn [x] (< (count x) 30)) (map str/trim (str/split (str text) #"[.?!\n]")))]
    (boolean (some (fn [[_ n]] (>= n 3)) (frequencies parts)))))

(defn- speak!
  "The model's frames from where the session is, until its turn ends: a token sampled, then
  evaluated, one at a time. Returns [frames why]: frames are {:kind :name :text} (kinds
  :thinking :text :call :call-text :tool-error; :partial when cut short), and why is
  :end-turn, :limit (the step's tokens ran out), :context (the session is full) or
  :stopped."
  [a]
  (let [{:keys [model session ids sampling max-tokens max-thinking draft]} @a
        m model
        s session
        max-thinking (or max-thinking 1536)
        content {(get ids :text) :text (get ids :thinking) :thinking (get ids :call) :call
                 (get ids :call-text) :call-text (get ids :tool-error) :tool-error}
        opens (get ids :model)
        closes (get ids :end)
        ends (get ids :end-turn)
        room (- (:context (ink/info s)) 8)
        seed (get sampling :seed 1)
        began (cpp/harness.seconds)
        ;; When the frame being made was opened (seconds since the agent was made).
        opened-at (atom nil)
        ;; The frame being made as text, for :live: [tokens already in it, the text]. Only
        ;; the tokens added since are turned into text (tokens are pieces of bytes, so the
        ;; pieces appended are the whole's text): the whole frame every few tokens would
        ;; cost the square of its length, which thousands of tokens of thinking make slow.
        shown (atom [0 ""])
        made (fn [kind header body]
               {:kind kind
                :name (str/trim (ink/detokenize m header))
                :text (ink/detokenize m body)
                :began (or @opened-at (clock a))
                :ended (clock a)})
        done (fn [frames why n]
               (swap! a (fn [v] (assoc v :live nil
                                       :generated (+ (:generated v) n)
                                       :seconds (+ (:seconds v) (- (cpp/harness.seconds) began)))))
               [frames why])
        ;; Cut short: the frame being made is kept as far as it got (:partial), and the
        ;; session is left well formed, the frame and the turn closed, so that the
        ;; conversation can go on.
        ;; Tokens drafted, checked and evaluated, not yet taken by the loop: dropped from
        ;; the session (rolled back) before the loop stops or puts a token of its own.
        queue (atom [])
        unqueue! (fn []
                   (when (seq @queue)
                     (ink/truncate! s (- (ink/position s) (count @queue)))
                     (reset! queue [])))
        next-id (fn [n]
                  (if (seq @queue)
                    (let [id (first @queue)]
                      (swap! queue (fn [q] (vec (rest q))))
                      id)
                    (let [ids (if draft
                                (ink/speculate! s (merge sampling draft
                                                         {:seed (+ seed n)
                                                          :limit (max 1 (min 16 (- max-tokens n)))}))
                                (let [id (ink/sample s (assoc sampling :seed (+ seed n)))]
                                  (ink/eval! s [id])
                                  [id]))]
                      (reset! queue (vec (rest ids)))
                      (first ids))))
        cut (fn [frames why n where kind header body]
              (unqueue!)
              (when (< (+ (ink/position s) 2) (:context (ink/info s)))
                (ink/eval! s (if (= where :between) [ends] [closes ends])))
              (done (if (and (= where :body) (seq body))
                      (conj frames (wrote! a (assoc (made kind header body) :partial true)))
                      frames)
                    why n))]
    ;; where: :between frames, :header (after <|message_model|>: a tool's name), :body.
    (loop [n 0 where :between kind nil header [] body [] frames []]
      (cond
        (:stop @a) (cut frames :stopped n where kind header body)
        (>= n max-tokens) (cut frames :limit n where kind header body)
        (>= (- (ink/position s) (count @queue)) room) (cut frames :context n where kind header body)

        ;; Thinking that goes on and on (the model can circle around a detail for a whole
        ;; step and never act), or that says the same sentence again and again: closed
        ;; here, as the model would close it, so that what comes next is from what it has
        ;; thought so far.
        (and (= where :body) (= kind :thinking)
             (or (>= (count body) max-thinking)
                 (and (zero? (mod (count body) 32)) (repeating? (second @shown)))))
        (do (unqueue!)
            (ink/eval! s [closes])
            (recur (inc n) :between nil [] []
                   (conj frames (wrote! a (assoc (made :thinking [] body) :cut true)))))

        :else
        (let [id (next-id n)]
          (cond
            (= id ends)
            (do (unqueue!)
                (done frames :end-turn (inc n)))

            (= id opens)
            (recur (inc n) :header nil [] [] frames)

            (contains? content id)
            (let [kind (get content id)]
              (reset! opened-at (clock a))
              (reset! shown [0 ""])
              (swap! a assoc :state kind :live {:kind kind :name (ink/detokenize m header) :text ""})
              (recur (inc n) :body kind header [] frames))

            (= id closes)
            (if (= where :body)
              (recur (inc n) :between nil [] [] (conj frames (wrote! a (made kind header body))))
              (recur (inc n) :between nil [] [] frames))

            (= where :header)
            (recur (inc n) :header nil (conj header id) [] frames)

            :else
            ;; Content; outside any frame it is taken as text.
            (let [kind (or kind :text)
                  body (conj body id)]
              (when (not= where :body)
                (reset! opened-at (clock a))
                (reset! shown [0 ""]))
              (when (zero? (mod (count body) 4))
                (let [[k text] @shown
                      text (str text (ink/detokenize m (subvec body k)))]
                  (reset! shown [(count body) text])
                  (swap! a assoc :live {:kind kind :name (ink/detokenize m header) :text text})))
              (recur (inc n) :body kind header body frames))))))))

;; A call run.

(defn- result-text
  "What a tool returned, as the model reads it: at most `limit` characters."
  [value limit]
  (let [text (if (string? value) value (pr-str value))
        n (count text)]
    (if (<= n limit)
      text
      (str (subs text 0 limit) "\n[cut here: " (- n limit) " more characters]"))))

(defn- params-said
  "A tool's parameters, as the model is told when a call lacks one."
  [t]
  (str/join ", " (map (fn [[k p]]
                        (str (subs (str k) 1)
                             (cond
                               (and (:doc p) (not (some #{k} (:required t)))) (str " (optional: " (:doc p) ")")
                               (:doc p) (str " (" (:doc p) ")")
                               (not (some #{k} (:required t))) " (optional)"
                               :else "")))
                      (:params t))))

(defn- same-before?
  "Whether agent `a` made this call before (the same tool and arguments) and it gave exactly
  `text`."
  [a named args text]
  (let [es (vec (:entries @a))]
    (boolean (some (fn [i]
                     (let [e (nth es i)]
                       (and (= :call (:role e)) (= (str named) (:name e)) (= args (:args e))
                            (= text (:text (nth es (inc i)))))))
                   (range (max 0 (dec (count es))))))))

(defn call!
  "A call's frame run for agent `a`: its JSON read, its tool found and called. `called` is
  {:name :text}, the frame's name and its JSON text. Returns the entries [call result]; the
  result's :text is what the model is given. (The turn does this by itself; it is public
  for tests.)"
  [a called]
  (let [tools (:tools @a)
        began (cpp/harness.seconds)
        read (try
               {:call (json/read (:text called))}
               (catch jank.runtime.object_ref e {:error (str "the call is not valid JSON: " (ex-message e))})
               (catch cpp/std.exception e {:error (str "the call is not valid JSON: " (cpp/.what e))}))
        call (:call read)
        named (or (when (map? call) (:name call)) (:name called))
        args (or (when (map? call) (:args call)) {})
        found (some (fn [t] (when (= (:name t) named) t)) tools)
        outcome (cond
                  (:error read) {:error (:error read)}
                  (nil? found) {:error (str "there is no tool named " (pr-str named) ". The tools are: "
                                            (str/join ", " (map :name tools)))}
                  (not (map? args)) {:error "the call's args must be an object"}
                  :else
                  (let [missing (remove (fn [k] (contains? args k)) (:required found))
                        unknown (remove (fn [k] (contains? (:params found) k)) (keys args))
                        ;; One argument missing and one given under another name ("code" for
                        ;; "command"): taken as the missing one, and the model told so.
                        renamed (when (and (= 1 (count missing)) (= 1 (count unknown)))
                                  [(first unknown) (first missing)])
                        args (if renamed
                               (-> args (dissoc (first renamed)) (assoc (second renamed) (get args (first renamed))))
                               args)
                        missing (if renamed [] missing)]
                    (if (seq missing)
                      {:error (str "the call lacks " (str/join ", " (map (fn [k] (subs (str k) 1)) missing))
                                   ". " (:name found) " takes " (params-said found))}
                      (try
                        ;; On a large stack: the turn's own thread has the system's small
                        ;; one, which a tool that recurses overflows.
                        {:value (binding [*agent* a]
                                  (repl/on-big-stack (fn [] ((:fn found) args))))
                         :note (when renamed
                                 (str "(the call's \"" (subs (str (first renamed)) 1) "\" was taken as \""
                                      (subs (str (second renamed)) 1) "\")\n"))}
                        (catch jank.runtime.object_ref e {:error (or (ex-message e) (str e))})
                        (catch cpp/jank.error_ref e {:error (str (cpp/.-message (cpp/* e)))})
                        (catch cpp/std.exception e {:error (str (cpp/.what e))})
                        (catch :default _ {:error "the tool threw something jank does not say"})))))
        text (if (:error outcome)
               (str "error: " (:error outcome))
               (str (:note outcome) (result-text (:value outcome) (or (:limit found) 8000))))
        ;; The same call again, with the same result: a tool that only reads says so rather
        ;; than give it again (a model going round in a loop re-reads what it already has). A
        ;; tool with effects gives it, and says it ran again: its effects may be new (loading
        ;; an edited file gives the same text, and loads the edit).
        same (and (not (:error outcome)) (same-before? a named args text))
        text (cond
               (and same (:reads-only found))
               "(This call gave exactly this result before: the result is earlier in this conversation.)"

               same
               (str text "\n(It ran again and gave the same result as the last time it was called so.)")

               :else text)]
    ;; :text and :kind are the call as the model wrote it (the session is made again from it).
    [{:role :call :name (str named) :args args :text (str (:text called)) :kind (:kind called)
      :began (:began called) :ended (:ended called)}
     {:role :result :name (str named) :text text :error (boolean (:error outcome))
      :seconds (- (cpp/harness.seconds) began)
      :began (- (clock a) (- (cpp/harness.seconds) began)) :ended (clock a)}]))

;; A turn.

(declare compact! compaction-due? compaction-soon? background! pending! fill!)

(defn- steps-note
  "What the model is told of its steps, after the last call of a few of them (the turn's
  first, when half and a quarter are left, and near the end): nil after the others."
  [step max-steps]
  (let [used (inc step)
        left (- max-steps used)]
    (when (and (>= max-steps 12)
               (contains? #{(dec max-steps) (quot max-steps 2) (quot max-steps 4) 8 4 2} left))
      ;; Said outright that a call's contents don't count: a game agent took each of its
      ;; actions for a step and rationed them.
      (str "\n\n[the harness] Step " used " of " max-steps " (" left " left). A step is one message of "
           "yours, whatever its calls hold: a call with a list of 20 things is one step, not 20; the turn "
           "ends when the steps run out, finished or not."))))

(defn- turn!
  "The model's turn: it speaks, its calls are run and their results given to it, and it
  speaks again, until it ends a step without calling anything."
  [a]
  (loop [step 0]
    ;; A compaction begun apart and ready: put in place. Near the session's end: one is
    ;; waited for (or made now); within twice the reserve, one is begun apart, the agent
    ;; going on meanwhile.
    (pending! a false)
    (cond
      (compaction-due? a 0) (compact! a :threshold)
      (and (nil? (:compaction @a)) (compaction-soon? a)) (background! a))
    (swap! a (fn [v] (assoc v :state :thinking :step-count (inc (:step-count v)))))
    (let [[frames why] (speak! a)
          ;; (A call cut short is not run.)
          calls (filter (fn [f] (and (contains? #{:call :call-text} (:kind f)) (not (:partial f))))
                        frames)]
      (cond
        (not= why :end-turn)
        (do (entry! a {:role :stopped :why why :began (clock a) :ended (clock a)})
            (swap! a assoc :state why))

        ;; An answer with nothing called: the turn ends, unless obligations say the work
        ;; isn't done (then what isn't is said to the model, and it goes on).
        (empty? calls)
        (let [v @a
              ob (:obligations v)
              checks (get v :checks 0)
              unmet (when (and ob (< checks (:max-checks v)))
                      (swap! a assoc :state :checking :live {:kind :tool :name "obligations" :text ""})
                      (let [began (clock a)
                            said (try
                                   (repl/on-big-stack (fn [] (ob a)))
                                   (catch jank.runtime.object_ref e (str "The harness's check threw: " (or (ex-message e) e)))
                                   (catch cpp/std.exception e (str "The harness's check threw: " (cpp/.what e))))]
                        {:text said :began began}))]
          (cond
            (and unmet (:text unmet) (< (inc step) (:max-steps @a)))
            (do (entry! a {:role :check :passed false :text (str (:text unmet))
                           :began (:began unmet) :ended (clock a)})
                (swap! a update :checks (fn [n] (inc (or n 0))))
                (ink/eval! (:session @a) (frame @a :user nil :text (str "[the harness] " (:text unmet))))
                (recur (inc step)))

            unmet
            (do (entry! a {:role :check :passed (nil? (:text unmet)) :text (str (or (:text unmet) "every obligation holds"))
                           :began (:began unmet) :ended (clock a)})
                (swap! a assoc :state :done))

            :else
            (swap! a assoc :state :done)))

        (>= (inc step) (:max-steps @a))
        (do (entry! a {:role :stopped :why :steps :began (clock a) :ended (clock a)})
            (swap! a assoc :state :steps))

        :else
        (let [note (steps-note step (:max-steps @a))
              last-call (dec (count calls))
              full (reduce
                    (fn [full [i called]]
                      (if full
                        full
                        (do
                          (swap! a assoc :state :tool :live {:kind :tool :name (:name called) :text (:text called)})
                          (let [[call result] (call! a called)
                                ;; The steps left, said after the step's last call.
                                result (if (and note (= i last-call)) (update result :text str note) result)
                                s (:session @a)
                                given (vec (frame @a :tool (:name result) :text (:text result)))]
                            (entry! a call)
                            (entry! a result)
                            ;; A result the session has no room for: the conversation compacted
                            ;; (the result is in it now, kept as it is), else the turn ends as a
                            ;; full session does, not as an error.
                            (cond
                              (< (+ (ink/position s) (count given)) (- (:context (ink/info s)) 8))
                              (do (ink/eval! s given)
                                  false)

                              (compact! a :overflow) false

                              :else true)))))
                    false
                    (map-indexed vector calls))]
          (if full
            (do (entry! a {:role :stopped :why :context :began (clock a) :ended (clock a)})
                (swap! a assoc :state :context))
            (recur (inc step))))))))

(defn- failed!
  "A turn that threw: said in the conversation, the agent left idle."
  [a what]
  (entry! a {:role :stopped :why :error :text (str what) :began (clock a) :ended (clock a)})
  (swap! a assoc :state :error))

(defn ask!
  "A person's message added to the conversation and the model's turn started, on a thread of
  its own: this returns at once. The agent's atom changes as the turn goes (:state, :live,
  :entries); `answer` waits for its end. Throws when a turn is still going."
  [a text]
  (let [v @a]
    (when (and (:turn v) (not (realized? (:turn v))))
      (throw (ex-info "the agent's turn is still going: (h/answer a) waits for it, (h/stop! a) stops it" {})))
    (swap! a assoc :stop false :state :reading :checks 0)
    (entry! a {:role :user :text (str text) :began (clock a) :ended (clock a)})
    (let [turn (future
                 (try
                   (let [v @a
                         said (vec (concat (when-not (:effort-said v)
                                             (frame v :system nil :text
                                                    (str "Thinking effort level: " (:effort v))))
                                           (frame v :user nil :text text)))]
                     (fill! (:session v) said)
                     (swap! a assoc :effort-said true)
                     (turn! a))
                   (catch jank.runtime.object_ref e (failed! a (or (ex-message e) (str e))))
                   (catch cpp/jank.error_ref e (failed! a (str (cpp/.-message (cpp/* e)))))
                   (catch cpp/std.exception e (failed! a (str (cpp/.what e))))
                   (catch :default _ (failed! a "something jank does not say"))))]
      (swap! a assoc :turn turn)
      nil)))

(defn answer
  "Waits for the turn in progress, then gives what the model last said (nil when it said
  nothing: see (:state @a) and (:entries @a))."
  [a]
  (when-let [turn (:turn @a)]
    (deref turn))
  (:text (last (filter (fn [e] (= (:role e) :model)) (:entries @a)))))

;; Compaction (as pi and opencode do it): when the session nears its end, the older part of
;; the conversation is replaced by a summary, and the recent part kept as it is. The session
;; is made again from the start (the tools, the system text), the summary, and the part kept.
;; :entries keeps everything said; :view what the model now sees, the summary first, as a
;; {:role :compacted :text summary} entry, which is also added to :entries where it happened.

(defn- steps-of
  "`entries` as the steps they were given in: the model's step (its thinking, words, calls and
  their results, by the entries' :step), and alone, a person's message and what the harness
  said. A call and its result are never apart."
  [entries]
  (let [key-of (fn [i e] (if (contains? #{:thinking :model :call :result} (:role e)) [:step (:step e)] [:alone i]))]
    (mapv (fn [group] (mapv second group))
          (partition-by (fn [[i e]] (key-of i e)) (map-indexed vector entries)))))

(defn view-tokens
  "The tokens the model is given for `entries` (of :view), as the turn gave them: a step's
  frames (thinking, words, calls) closed by the end of the model's turn, then the calls'
  results; a person's message; what the harness said (a check that failed, a summary)."
  [v entries]
  (let [ids (:ids v)
        m (:model v)
        model-frame (fn [kind named text]
                      (vec (concat [(get ids :model)] (when (seq named) (plain m named)) [(get ids kind)]
                                   (plain m text) [(get ids :end)])))
        step-tokens (fn [step]
                      (let [said (mapcat (fn [e]
                                           (case (:role e)
                                             :thinking (model-frame :thinking nil (:text e))
                                             :model (model-frame :text nil (:text e))
                                             :call (model-frame (or (:kind e) :call) (:name e)
                                                                (or (:text e)
                                                                    (str "{\"name\":" (json/write (:name e)) ",\"args\":" (json/write (:args e)) "}")))
                                             nil))
                                         step)
                            results (mapcat (fn [e] (when (= :result (:role e)) (frame v :tool (:name e) :text (:text e))))
                                            step)]
                        (concat said [(get ids :end-turn)] results)))]
    (vec (mapcat (fn [step]
                   (let [e (first step)]
                     (case (:role e)
                       :user (frame v :user nil :text (:text e))
                       :check (when-not (:passed e) (frame v :user nil :text (str "[the harness] " (:text e))))
                       :compacted (frame v :user nil :text (str "[the harness] What happened before, in short:\n\n" (:text e)
                                                                (when (seq (:notes v))
                                                                  (str "\n\nYour notes (the notes tool):\n" (:notes v)))))
                       (:thinking :model :call :result) (step-tokens step)
                       nil)))
                 (steps-of entries)))))

(defn- recorded!
  "An entry added to the whole conversation only (not to what the model sees): a compaction,
  where it happened."
  [a entry]
  (let [entry (assoc entry :step (:step-count @a))]
    (swap! a update :entries conj entry)
    (told! a entry)))

(defn- compaction-due?
  "Whether the session, with `more` tokens to come, is within the reserve of its end."
  [a more]
  (let [v @a
        s (:session v)]
    (boolean (and (:compact v)
                  (> (+ (ink/position s) more) (- (:context (ink/info s)) (:compact-reserve v)))))))

(defn- given-for
  "Every token the model is given for `view`, from the session's start: the tools and system
  text, the effort, then the view."
  [v view]
  (vec (concat (:start v)
               (frame v :system nil :text (str "Thinking effort level: " (:effort v)))
               (view-tokens v view))))

(defn given
  "Every token the model is given for the agent's :view, from the session's start: the tools
  and system text, the effort, then the view (what a compaction makes the session again
  from)."
  [a]
  (let [v @a]
    (given-for v (:view v))))

(def ^:private fill-chunk
  ;; Tokens evaluated at a time when filling a session: the model is one, and an evaluation
  ;; holds it; in pieces, another session's tokens (the agent's, while a compaction is made
  ;; beside it) come between.
  512)

(defn fill!
  "`tokens` evaluated into session `s`, in pieces of fill-chunk."
  [s tokens]
  (doseq [piece (partition-all fill-chunk tokens)]
    (ink/eval! s (vec piece))))

(defn- prepared
  "A compaction of the agent's view as it is in `v` (`reason` :threshold, :soon, :overflow or
  :manual), made apart from the agent's own session: the older part summarized by its
  :compact function (given {:entries :previous :tokens-before :reason}), the recent part
  (about :compact-keep tokens, whole steps; half as many when that would keep every step)
  kept, and a new session evaluated with them.
  {:entry :kept :session :upto (the view's length it was made from) :began} or {:failed
  :began}, or nil when there is nothing to summarize."
  [a v reason]
  (let [f (:compact v)
        view (:view v)
        previous (when (= :compacted (:role (first view))) (first view))
        rest-view (if previous (vec (rest view)) view)
        steps (steps-of rest-view)
        sizes (mapv (fn [st] (count (view-tokens v st))) steps)
        ;; The first step kept: walking back from the end until `keep` tokens; when that keeps
        ;; every step, half as many (else nothing is summarized and the session fills up).
        kept-from (loop [keep (:compact-keep v)]
                    (let [from (loop [i (count steps) total 0]
                                 (if (and (pos? i) (< (+ total (nth sizes (dec i))) keep))
                                   (recur (dec i) (+ total (nth sizes (dec i))))
                                   i))]
                      (if (and (zero? from) (> keep 512))
                        (recur (quot keep 2))
                        from)))
        summarized (vec (apply concat (take kept-from steps)))
        kept (vec (apply concat (drop kept-from steps)))]
    (when (and f (seq summarized))
      (let [began (clock a)
            tokens-before (ink/position (:session v))
            said (try
                   (f a {:entries summarized :previous (:text previous) :tokens-before tokens-before :reason reason})
                   (catch jank.runtime.object_ref e {:failed (or (ex-message e) (str e))})
                   (catch cpp/jank.error_ref e {:failed (str (cpp/.-message (cpp/* e)))})
                   (catch cpp/std.exception e {:failed (str (cpp/.what e))})
                   (catch :default _ {:failed "the compaction threw something jank does not say"}))]
        (cond
          ;; Stopped while the summary was being made (a run's time ran out): nothing to put in
          ;; place, and not a failure (it was shown as "couldn't compact").
          (:stop @a) nil

          (not (and (string? said) (seq (str/trim said))))
          {:failed (if (map? said) (:failed said) "the compaction gave no summary") :began began :reason reason}

          :else
          (let [e {:role :compacted :text (str/trim said) :reason reason
                   :summarized (count summarized) :kept (count kept) :tokens-before tokens-before
                   :began began}
                s (ink/session (:model v) (:context (ink/info (:session v))))]
            (when-let [depth (:model (:draft v))]
              (ink/draft-model! s depth))
            (fill! s (given-for v (vec (cons e kept))))
            {:entry e :kept kept :session s :upto (count view) :began began}))))))

(defn- merge!
  "Compaction `c` (prepared's) put in place: what the agent did since it was begun (whole
  steps, after the view it was made from) evaluated into its session, which becomes the
  agent's, the old one freed. Returns whether it compacted."
  [a c]
  (cond
    (nil? c) false

    (:failed c)
    (do (recorded! a {:role :compacted :failed true :reason (:reason c) :text (:failed c)
                      :began (:began c) :ended (clock a)})
        false)

    :else
    (let [v @a
          since (subvec (:view v) (min (:upto c) (count (:view v))))
          s (:session c)]
      (fill! s (view-tokens v since))
      (let [old (:session v)
            e (assoc (:entry c) :tokens-after (ink/position s) :ended (clock a))]
        (swap! a assoc :session s :view (vec (concat [e] (:kept c) since)) :compacted-at (ink/position s))
        (ink/free! old)
        (recorded! a e)
        true))))

(defn- compact-early
  "Tokens before a compaction is due that one is begun apart: the reserve, at least 4096 (a
  game agent added about 5000 while one was made, in 90 seconds)."
  [v]
  (max 4096 (:compact-reserve v)))

(defn- compaction-soon?
  "Whether a compaction should be begun apart from the agent, to be ready before it is due:
  the session within compact-early of the reserve, and half that added since the last one
  (else a small session compacts again and again, each time for little)."
  [a]
  (let [v @a
        s (:session v)
        at (ink/position s)
        early (compact-early v)]
    (boolean (and (:compact v)
                  (> at (- (:context (ink/info s)) (:compact-reserve v) early))
                  (> at (+ (or (:compacted-at v) 0) (quot early 2)))))))

(defn- background!
  "A compaction begun apart from the agent, which goes on meanwhile (one at a time)."
  [a]
  (let [v @a]
    (swap! a assoc :compaction (future (prepared a v :soon)))))

(defn- pending!
  "The compaction begun apart, put in place: waited for when `wait`, else only when it is
  ready. Returns whether it compacted."
  [a wait]
  (when-let [c (:compaction @a)]
    (when (or wait (realized? c))
      (swap! a assoc :compaction nil)
      (merge! a @c))))

(defn compact!
  "The conversation's older part replaced by a summary (`reason` :threshold, :overflow or
  :manual), the recent part (about :compact-keep tokens, whole steps) kept as it is (see
  `prepared`). One begun apart is waited for and put in place instead. The agent shows
  :compacting meanwhile. Returns whether it compacted."
  [a reason]
  (let [state (:state @a)]
    (swap! a assoc :state :compacting :live {:kind :tool :name "compaction" :text ""})
    (try
      (if (:compaction @a)
        (pending! a true)
        (merge! a (prepared a @a reason)))
      (finally
        (swap! a assoc :state state :live nil)))))

;; The default compaction: the model summarizes the older part, as pi and opencode have it
;; do, in a fixed form, from a transcript of it (each tool's output cut to 2000 characters).

(def ^:private summary-form
  "## Goal
- [what the person asked for, in one or two sentences]

## Requirements
- [constraints and requirements stated, or \"(none)\"]

## Decisions
- [decisions made and why, or \"(none)\"]

## Progress
### Done
- [what is finished]
### In progress
- [what is being worked on]
### Blocked
- [what is blocked and why, or \"(none)\"]

## Next steps
1. [the next actions, in order]

## Files
- `[path]`: [why it matters; the files read and changed]

## Critical context
- [facts, errors, values needed to go on, which can't easily be found again; or \"(none)\"]")

(def ^:private summary-rules
  "Rules:
- Short, single-line bullets.
- Keep exact file paths, names, commands, error messages and values.
- Keep the person's request word for word while it isn't done.
- Do not continue the task and do not call tools.
- Answer with the summary only, in the form above.")

(defn- clipped
  "`text` with its middle cut when longer than `n` characters: the first and last halves kept."
  [text n]
  (let [text (str text)
        k (count text)]
    (if (<= k n)
      text
      (str (subs text 0 (quot n 2)) "\n[... " (- k n) " characters cut ...]\n" (subs text (- k (quot n 2)))))))

(defn transcript
  "Entries as text for a summary: a line a kind, so that it reads as a record, not as a
  conversation to go on with. A tool's result is cut to `result-chars` (2000), the model's
  thinking to `thinking-chars` (when given)."
  ([entries] (transcript entries {}))
  ([entries {:keys [result-chars thinking-chars] :or {result-chars 2000}}]
  (str/join "\n\n"
            (keep (fn [e]
                    (case (:role e)
                      :user (str "[Person]: " (:text e))
                      :thinking (str "[Model thinking]: " (if thinking-chars (clipped (:text e) thinking-chars) (:text e)))
                      :model (str "[Model]: " (:text e))
                      :call (str "[Model called]: " (:name e) " " (json/write (:args e)))
                      :result (str "[Tool result]: " (clipped (:text e) result-chars))
                      :check (when-not (:passed e) (str "[Harness]: " (:text e)))
                      :compacted (str "[Earlier summary]:\n" (:text e))
                      nil))
                  entries))))

(defn summarize
  "The default :compact: a summary of `entries` written by the agent's own model, in a
  session of its own (no tools), as pi and opencode do. With an earlier summary, it is
  brought up to date."
  [a {:keys [entries previous]}]
  (let [v @a
        writer (agent (:model v)
                      {:system "You write summaries of an agent's work, for another agent to go on with it."
                       :context (:context (ink/info (:session v)))
                       :sampling (:sampling v)
                       :effort :low
                       :max-steps 1
                       :compact nil})]
    (try
      (ask! writer
            (str (if previous
                   (str "An earlier summary of this work:\n\n" previous "\n\nWhat happened since:\n\n")
                   "The work so far:\n\n")
                 (transcript entries {:result-chars (or (:summary-result-chars v) 2000)
                                      :thinking-chars (:summary-thinking-chars v)})
                 "\n\n"
                 (if previous
                   "Bring the earlier summary up to date with what happened since, into one summary. Newer events take precedence; keep what is still true."
                   "Summarize the work above for another agent who will go on with it.")
                 "\n\nUse this form:\n\n" summary-form "\n\n" summary-rules))
      (answer writer)
      (finally (close! writer)))))

(defn stop!
  "The turn in progress stopped after the token being made. The conversation stays as it
  is, and can be continued with `ask!`."
  [a]
  (swap! a assoc :stop true)
  (when-let [turn (:turn @a)]
    (deref turn))
  (:state @a))

(defn entries
  "The conversation: a vector of entries, each a map with :role, and with :began and :ended,
  seconds since the agent was made (for what the model wrote, the writing; for a result,
  the tool's run).
    {:role :user :text}       a person's message
    {:role :thinking :text}   the model thinking (:cut when the harness closed it)
    {:role :model :text}      the model's words
    {:role :call :name :args} a tool called, its arguments decoded
    {:role :result :name :text :error :seconds}  what the tool gave, as the model read it
    {:role :stopped :why}     a turn cut short: :limit :context :steps :stopped :error
    {:role :check :passed :text}  the obligations asked at the turn's end (:obligations)"
  [a]
  (:entries @a))

(defn recording
  "The agent's conversation as plain data: {:entries :tools :effort :state :generated
  :seconds}. It can be kept in a file (`save!`) and looked at again without the model
  (harness.cards/replay!)."
  [a]
  (let [v @a]
    {:entries (:entries v)
     ;; What the model saw last (after a compaction: the summary, then what was kept).
     :view (:view v)
     ;; The model's own notes (the notes tool).
     :notes (:notes v)
     :tools (mapv :name (:tools v))
     :effort (:effort v)
     :state (:state v)
     :generated (:generated v)
     :seconds (:seconds v)}))

(defn save!
  "The agent's conversation written to a file, as `recording` gives it. Returns the path. A
  string cut inside a character (jank's strings are bytes) is written with U+FFFD for the
  bytes left, so that the file is UTF-8 and readable anywhere."
  [a path]
  (cpp/harness.write_file (str path) (cpp/harness.utf8_clean (pr-str (recording a))))
  (str path))

(defn load-recording
  "A conversation read from a file `save!` wrote."
  [path]
  (read-string (slurp (str path))))

(defn resume!
  "Agent `a` (new, with the same tools and system as the conversation's) given a kept
  conversation (`recording`, or a file's path) to go on with: its entries, and its session
  made again for what the model saw last (the recording's view; in an older recording, from
  its last summary on). The next `ask!` goes on from there."
  [a recording]
  (let [r (if (string? recording) (load-recording recording) recording)
        entries (vec (:entries r))
        from (last (keep-indexed (fn [i e] (when (= :compacted (:role e)) i)) entries))
        view (vec (or (:view r) (if from (subvec entries from) entries)))]
    (swap! a assoc :entries entries :view view :effort-said true :notes (:notes r)
           :generated (or (:generated r) 0) :seconds (or (:seconds r) 0.0)
           :step-count (count (filter (fn [e] (= :user (:role e))) entries)))
    (let [s (:session @a)]
      (ink/reset! s)
      (fill! s (given a)))
    a))

(defn status
  "Where the agent is: {:state :position :context :generated :seconds :tokens-per-second}."
  [a]
  (let [v @a
        s (:session v)
        info (when (ink/session? s) (ink/info s))]
    {:state (:state v)
     :position (:position info)
     :context (:context info)
     :generated (:generated v)
     :seconds (:seconds v)
     :tokens-per-second (if (pos? (:seconds v)) (/ (:generated v) (:seconds v)) 0.0)}))
